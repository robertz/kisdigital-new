/**
 * GoatCounterClient's actual stats methods all make a live HTTP call (see
 * the class's own comment on why — there's no presigned-URL equivalent for
 * a bearer-token API), so only the pure, network-free bit is unit-tested
 * here: isConfigured(), same as R2ClientSpec.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "GoatCounterClient", function(){

			describe( "isConfigured()", function(){
				it( "is true when both the site and API key are set", function(){
					var client = new models.util.GoatCounterClient( "test-site", "test-key" )
					expect( client.isConfigured() ).toBeTrue()
				} )

				it( "is false when the site is missing", function(){
					var client = new models.util.GoatCounterClient( "", "test-key" )
					expect( client.isConfigured() ).toBeFalse()
				} )

				it( "is false when the API key is missing", function(){
					var client = new models.util.GoatCounterClient( "test-site", "" )
					expect( client.isConfigured() ).toBeFalse()
				} )
			} )

		} )
	}

}

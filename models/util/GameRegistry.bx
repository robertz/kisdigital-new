/**
 * The registered /games showcase entries (slug/name/icon/tagline/href).
 * Mirrors ProjectRegistry.bx's shape, but each entry links straight to a
 * static playable page under public/games/ rather than a templated
 * overview route — these aren't code projects with docs, they're games.
 */
class {

	variables.games = [
		{
			slug    : "void-harvest",
			name    : "Void Harvest",
			icon    : "bi-stars",
			tagline : "An idle deep-space mining fleet game — spiritual successor to Raymond Camden's IdleFleet.",
			href    : "/games/void-harvest/"
		},
		{
			slug    : "chat",
			name    : "Chat",
			icon    : "bi-chat-dots",
			tagline : "A small Slack-like chat room across a few channels, built to exercise boxlang-express's raw WebSocket support.",
			href    : "/games/chat/"
		},
		{
			slug    : "stellar-dominion",
			name    : "Stellar Dominion",
			icon    : "bi-globe2",
			tagline : 'A persistent, turn-based multiplayer space empire — build your economy, grow your fleet, and raid your rivals. Inspired by the classic BBS door game "Solar Realms Elite."',
			href    : "/games/empire"
		}
	];

	/**
	 * @return {array} Every registered game, in display order.
	 */
	function getGames(){
		return variables.games;
	}

}

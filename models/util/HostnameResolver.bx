/**
 * Reverse-DNS (PTR) lookups for the IPs shown on /manage/security. Most of
 * those IPs belong to scanners and bots that don't have a PTR record at
 * all, and a plain blocking InetAddress lookup can take several seconds to
 * fail — with dozens of distinct IPs across the page's 7 sections, doing
 * that serially would make the page unusable. Two things keep it bounded:
 *
 *  1. Every lookup runs on a background thread with a hard timeout
 *     (resolveAll() submits them all up front, so N lookups cost roughly
 *     one timeout period, not N timeout periods).
 *  2. Both hits and misses are cached in cache("default") — a miss for a
 *     shorter TTL, since a currently-unresolvable IP isn't necessarily
 *     permanently so, but there's no reason to re-pay the timeout on every
 *     page load either.
 *
 * One real limitation: java.net.InetAddress's blocking native DNS call
 * can't actually be interrupted once it's in flight, so a timed-out lookup
 * leaves its thread running in the background until the OS resolver itself
 * gives up (which can be much longer than our timeout). The cached thread
 * pool absorbs this — for this app's traffic (one admin loading one page),
 * a handful of abandoned lookups piling up briefly is a non-issue, not a
 * leak.
 */
class {

	variables.executor = createObject( "java", "java.util.concurrent.Executors" ).newCachedThreadPool();
	variables.timeUnit  = createObject( "java", "java.util.concurrent.TimeUnit" );

	/**
	 * @param {array} ips - IP addresses to resolve; duplicates are fine and
	 *        only resolved once.
	 * @param {numeric} timeoutMs - Per-lookup timeout. Since lookups run
	 *        concurrently, this is roughly the total added wall time too.
	 * @return {struct} ip -> hostname. A hostname of "" means no PTR record,
	 *         or the lookup didn't finish within the timeout.
	 */
	function resolveAll( required array ips, numeric timeoutMs = 800 ){
		var uniqueIps = {};
		for ( var ip in arguments.ips ) uniqueIps[ ip ] = true;

		var results = {};
		var pending = {};

		for ( var ip in uniqueIps ){
			var cached = cache( "default" ).get( _cacheKey( ip ) );
			if ( cached.isPresent() ){
				results[ ip ] = cached.get();
			} else {
				pending[ ip ] = _submit( ip );
			}
		}

		// All pending lookups were just submitted above and are running
		// concurrently, so waiting on them one at a time here still costs
		// ~timeoutMs total, not timeoutMs * pending.len().
		for ( var ip in pending ){
			var hostname = "";
			try {
				hostname = pending[ ip ].get( arguments.timeoutMs, variables.timeUnit.MILLISECONDS );
			} catch ( any e ) {
				hostname = "";
			}
			results[ ip ] = hostname;
			cache( "default" ).set( _cacheKey( ip ), hostname, len( hostname ) ? 86400 : 300 );
		}

		return results;
	}

	private function _submit( required string ip ){
		var targetIp = arguments.ip;
		var callable = createDynamicProxy(
			new models.util.Callable( () => {
				try {
					var addr = createObject( "java", "java.net.InetAddress" ).getByName( targetIp );
					var hostname = addr.getCanonicalHostName();
					// Falls back to returning the IP itself (as a string) when
					// there's no PTR record, rather than throwing — that's not
					// a real hostname, so treat it the same as a miss.
					return hostname == targetIp ? "" : hostname;
				} catch ( any e ) {
					return "";
				}
			} ),
			[ "java.util.concurrent.Callable" ]
		);
		return variables.executor.submit( callable );
	}

	private function _cacheKey( required string ip ){
		return "hostname:" & arguments.ip;
	}

}

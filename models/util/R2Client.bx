/**
 * Minimal Cloudflare R2 client — computes presigned AWS Signature V4 URLs
 * for PUT (upload) and GET (bucket listing) operations. The server never
 * makes the actual HTTP request to R2 itself; it only signs a URL, which the
 * browser then calls directly. This is deliberate, not just an efficiency
 * choice — see the note on presignPutUrl() for why.
 */
class {

	variables.accountId       = "";
	variables.bucket          = "";
	variables.accessKeyId     = "";
	variables.secretAccessKey = "";
	variables.publicBaseUrl   = "";

	function init(
		required string accountId,
		required string bucket,
		required string accessKeyId,
		required string secretAccessKey,
		required string publicBaseUrl
	){
		variables.accountId       = arguments.accountId;
		variables.bucket          = arguments.bucket;
		variables.accessKeyId     = arguments.accessKeyId;
		variables.secretAccessKey = arguments.secretAccessKey;
		variables.publicBaseUrl   = arguments.publicBaseUrl.right( 1 ) == "/"
			? left( arguments.publicBaseUrl, len( arguments.publicBaseUrl ) - 1 )
			: arguments.publicBaseUrl;
		return this;
	}

	/**
	 * True once every credential needed to actually reach R2 is present.
	 * Callers use this to fail fast with a clear message instead of a raw
	 * signing/network error when the .env vars haven't been set yet.
	 */
	function isConfigured(){
		return len( variables.accountId ) > 0
			&& len( variables.bucket ) > 0
			&& len( variables.accessKeyId ) > 0
			&& len( variables.secretAccessKey ) > 0
			&& len( variables.publicBaseUrl ) > 0;
	}

	/**
	 * Returns a short-lived signed URL the browser can PUT a file straight
	 * to, plus the object's eventual public URL.
	 *
	 * This server never sends the actual upload request to R2 — three
	 * different JDK HTTP transports (java.net.http.HttpClient, the bx:http
	 * tag, java.net.HttpURLConnection) were tried for a server-side
	 * putObject()/listObjects() here, and all three worked flawlessly in
	 * local dev but failed in production (DigitalOcean App Platform,
	 * x86_64) — two different failure modes (a fast empty-bodied HTTP 500,
	 * and a hang through to the platform's own gateway timeout) despite
	 * `curl` succeeding instantly against the same URL from the same
	 * container. That combination pointed at a BoxLang/JVM-level bug in
	 * outbound HTTPS specific to that architecture, not at this code, R2,
	 * or the network path — unreproducible locally (aarch64) despite
	 * identical code and an identical image. Presigning sidesteps it
	 * entirely: this method only does string-building and HMAC signing, no
	 * network I/O, so it isn't exposed to whatever that bug is. The actual
	 * PUT happens in the browser via fetch(), which needs CORS enabled on
	 * the bucket for the app's origin(s) — see db/README or ask before
	 * assuming it's set.
	 *
	 * @param {string} key - Object key/path within the bucket, e.g. "posts/uuid.jpg".
	 * @param {string} contentType - MIME type the browser will upload the file as.
	 * @param {numeric} expiresSeconds - How long the signed URL stays valid. Defaults to 5 minutes.
	 * @return {struct} { uploadUrl, publicUrl }.
	 */
	function presignPutUrl( required string key, required string contentType, numeric expiresSeconds = 300 ){
		var uploadUrl = _presign( "PUT", _objectPath( arguments.key ), {}, arguments.expiresSeconds );
		return { "uploadUrl": uploadUrl, "publicUrl": "#variables.publicBaseUrl#/#arguments.key#" };
	}

	/**
	 * Returns a short-lived signed URL the browser can GET to list objects
	 * under a key prefix (S3 ListObjectsV2) — backs the cover image picker's
	 * "choose an existing upload" grid. See presignPutUrl() for why this is
	 * presigned rather than fetched server-side. The browser is responsible
	 * for parsing the returned XML (ListBucketResult/Contents/Key etc.).
	 *
	 * @param {string} prefix - Key prefix to list under, e.g. "posts/". No leading slash.
	 * @param {numeric} maxKeys - Maximum objects to return. Defaults to 100.
	 * @param {numeric} expiresSeconds - How long the signed URL stays valid. Defaults to 5 minutes.
	 * @param {string} delimiter - S3 "folder" delimiter. Pass "/" to have the
	 *        response group anything past the next "/" into CommonPrefixes
	 *        instead of listing it flat — what the media manager's directory
	 *        browsing needs; left empty (the default) for callers like the
	 *        cover-image picker that just want every key under the prefix.
	 * @return {string} Signed URL.
	 */
	function presignListUrl( required string prefix, numeric maxKeys = 100, numeric expiresSeconds = 300, string delimiter = "", string continuationToken = "" ){
		var queryParams = {
			"list-type": "2",
			"max-keys": arguments.maxKeys,
			"prefix": arguments.prefix
		};
		if ( len( arguments.delimiter ) ){
			queryParams[ "delimiter" ] = arguments.delimiter;
		}
		// A listing holds at most 1000 keys; R2 hands back a token for the rest.
		if ( len( arguments.continuationToken ) ){
			queryParams[ "continuation-token" ] = arguments.continuationToken;
		}
		return _presign( "GET", "/#variables.bucket#", queryParams, arguments.expiresSeconds );
	}

	/**
	 * Presigns a DELETE for one object. Unlike the upload and list URLs this
	 * one is used by deleteObject() below, not handed to the browser.
	 */
	function presignDeleteUrl( required string key, numeric expiresSeconds = 60 ){
		return _presign( "DELETE", _objectPath( arguments.key ), {}, arguments.expiresSeconds );
	}

	/**
	 * Permanently deletes one object. Done from the server rather than the
	 * browser so it doesn't depend on the bucket's CORS rules allowing DELETE,
	 * and there are no file bytes to keep off this app's wire. R2 answers 204
	 * whether or not the key existed.
	 *
	 * @throws {R2Error} if R2 refuses the request or can't be reached.
	 */
	function deleteObject( required string key ){
		var response = _send( "DELETE", arguments.key );
		if ( response.statusCode() < 200 || response.statusCode() >= 300 ){
			throw( type: "R2Error", message: "Delete failed (HTTP " & response.statusCode() & ")" );
		}
	}

	/**
	 * Reads one object into memory, for the Media page's crop tool: a canvas
	 * can only work on an image served from this site's own address.
	 *
	 * @return {struct} { bytes, contentType }
	 * @throws {R2Error} if the object is missing or larger than maxBytes.
	 */
	function getObject( required string key, numeric maxBytes = 26214400 ){
		var response = _send( "GET", arguments.key );
		if ( response.statusCode() != 200 ){
			throw( type: "R2Error", message: "Couldn't read the file (HTTP " & response.statusCode() & ")" );
		}
		if ( arrayLen( response.body() ) > arguments.maxBytes ){
			throw( type: "R2Error", message: "The file is too large to open here." );
		}
		return {
			"bytes"      : response.body(),
			"contentType": response.headers().firstValue( "content-type" ).orElse( "application/octet-stream" )
		};
	}

	/**
	 * True when an object is stored under this key.
	 *
	 * @throws {R2Error} if R2 answers with anything but found or not found.
	 */
	function objectExists( required string key ){
		var response = _send( "HEAD", arguments.key );
		if ( response.statusCode() == 404 ) return false;
		if ( response.statusCode() == 200 ) return true;
		throw( type: "R2Error", message: "Lookup failed (HTTP " & response.statusCode() & ")" );
	}

	/**
	 * Moves an object to a new key (a rename is a move within its folder).
	 * S3-compatible storage has no rename, so this reads the object, writes
	 * it under the new key with the same content type, and deletes the
	 * original only once that write has succeeded.
	 *
	 * The bytes pass through this process, unlike an upload. That's a
	 * deliberate trade against S3's server-side copy: it reuses the request
	 * signing uploads already depend on instead of a second, header-signed
	 * variant. maxBytes keeps an unexpectedly large object from being pulled
	 * into this JVM's (small) heap.
	 *
	 * @throws {R2Error} if the object is missing, too large, or any step fails.
	 */
	function moveObject( required string fromKey, required string toKey, numeric maxBytes = 26214400 ){
		var read = _send( "GET", arguments.fromKey );
		if ( read.statusCode() != 200 ){
			throw( type: "R2Error", message: "Couldn't read the file (HTTP " & read.statusCode() & ")" );
		}
		var bytes = read.body();
		if ( arrayLen( bytes ) > arguments.maxBytes ){
			throw( type: "R2Error", message: "The file is too large to move from here." );
		}

		var contentType = read.headers().firstValue( "content-type" ).orElse( "application/octet-stream" );
		var written     = _send( "PUT", arguments.toKey, bytes, contentType );
		if ( written.statusCode() < 200 || written.statusCode() >= 300 ){
			throw( type: "R2Error", message: "Couldn't write the file (HTTP " & written.statusCode() & ")" );
		}

		deleteObject( arguments.fromKey );
	}

	/**
	 * One request to the bucket's S3 endpoint for a single object, signed for
	 * 60 seconds. The response body comes back as bytes.
	 */
	private function _send( required string method, required string key, body, string contentType = "" ){
		var duration   = createObject( "java", "java.time.Duration" );
		var publishers = createObject( "java", "java.net.http.HttpRequest$BodyPublishers" );
		var builder    = createObject( "java", "java.net.http.HttpRequest" )
			.newBuilder()
			.uri( createObject( "java", "java.net.URI" ).create( _presign( arguments.method, _objectPath( arguments.key ), {}, 60 ) ) )
			.timeout( duration.ofSeconds( 30 ) );

		if ( len( arguments.contentType ) ){
			builder = builder.header( "Content-Type", arguments.contentType );
		}
		builder = builder.method( arguments.method, isNull( arguments.body ) ? publishers.noBody() : publishers.ofByteArray( arguments.body ) );

		try {
			return createObject( "java", "java.net.http.HttpClient" )
				.newBuilder()
				.connectTimeout( duration.ofSeconds( 5 ) )
				.build()
				.send( builder.build(), createObject( "java", "java.net.http.HttpResponse$BodyHandlers" ).ofByteArray() );
		} catch ( any e ) {
			throw( type: "R2Error", message: "Couldn't reach the image host: " & e.message );
		}
	}

	/**
	 * The request path for an object. Each key segment is percent-encoded,
	 * because a key can hold spaces and other characters that aren't valid
	 * in a URL as they stand; the slashes between segments are kept.
	 */
	private function _objectPath( required string key ){
		var encodedKey = listToArray( arguments.key, "/", true ).map( ( segment ) => _uriEncode( segment ) ).toList( "/" );
		return "/#variables.bucket#/#encodedKey#";
	}

	/**
	 * The public URL an object would have once uploaded — used by callers
	 * that already know the key without needing a fresh presign.
	 */
	function publicUrl( required string key ){
		return "#variables.publicBaseUrl#/#arguments.key#";
	}

	function getPublicBaseUrl(){
		return variables.publicBaseUrl;
	}

	private function _presign( required string method, required string canonicalUri, required struct extraQueryParams, required numeric expiresSeconds ){
		var host = "#variables.accountId#.r2.cloudflarestorage.com";

		var instant   = createObject( "java", "java.time.Instant" ).now();
		var formatter = createObject( "java", "java.time.format.DateTimeFormatter" )
			.ofPattern( "yyyyMMdd'T'HHmmss'Z'" )
			.withZone( createObject( "java", "java.time.ZoneOffset" ).UTC );
		var amzDate   = formatter.format( instant );
		var dateStamp = left( amzDate, 8 );
		var credentialScope = "#dateStamp#/auto/s3/aws4_request";

		var queryParams = arguments.extraQueryParams;
		queryParams[ "X-Amz-Algorithm" ]     = "AWS4-HMAC-SHA256";
		queryParams[ "X-Amz-Credential" ]    = "#variables.accessKeyId#/#credentialScope#";
		queryParams[ "X-Amz-Date" ]          = amzDate;
		queryParams[ "X-Amz-Expires" ]       = arguments.expiresSeconds;
		queryParams[ "X-Amz-SignedHeaders" ] = "host";

		var canonicalQueryString = _canonicalQueryString( queryParams );
		var canonicalHeaders = "host:#host#" & char( 10 );

		var canonicalRequest = arguments.method & char( 10 )
			& arguments.canonicalUri & char( 10 )
			& canonicalQueryString & char( 10 )
			& canonicalHeaders & char( 10 )
			& "host" & char( 10 )
			& "UNSIGNED-PAYLOAD";

		var stringToSign = "AWS4-HMAC-SHA256" & char( 10 )
			& amzDate & char( 10 )
			& credentialScope & char( 10 )
			& _sha256Hex( canonicalRequest.getBytes( "UTF-8" ) );

		var kDate     = _hmacSha256( ( "AWS4" & variables.secretAccessKey ).getBytes( "UTF-8" ), dateStamp );
		var kRegion   = _hmacSha256( kDate, "auto" );
		var kService  = _hmacSha256( kRegion, "s3" );
		var kSigning  = _hmacSha256( kService, "aws4_request" );
		var signature = _hex( _hmacSha256( kSigning, stringToSign ) );

		return "https://#host##arguments.canonicalUri#?#canonicalQueryString#&X-Amz-Signature=#signature#";
	}

	private function _canonicalQueryString( required struct params ){
		var sortedKeys = structKeyArray( arguments.params );
		arraySort( sortedKeys, "text" );
		var parts = [];
		for ( var i = 1; i <= sortedKeys.len(); i++ ){
			var k = sortedKeys[ i ];
			parts.append( _uriEncode( k ) & "=" & _uriEncode( toString( arguments.params[ k ] ) ) );
		}
		return parts.toList( "&" );
	}

	private function _uriEncode( required string value ){
		var bytes = arguments.value.getBytes( "UTF-8" );
		var sb = createObject( "java", "java.lang.StringBuilder" ).init();
		for ( var b in bytes ){
			var c = bitAnd( b, 255 );
			if ( ( c >= 65 && c <= 90 ) || ( c >= 97 && c <= 122 ) || ( c >= 48 && c <= 57 ) || c == 45 || c == 46 || c == 95 || c == 126 ){
				sb.append( char( c ) );
			} else {
				sb.append( "%" & uCase( right( "0" & formatBaseN( c, 16 ), 2 ) ) );
			}
		}
		return sb.toString();
	}

	private function _sha256Hex( required binary bytes ){
		var digest = createObject( "java", "java.security.MessageDigest" ).getInstance( "SHA-256" );
		return _hex( digest.digest( arguments.bytes ) );
	}

	private function _hmacSha256( required binary keyBytes, required string data ){
		var mac    = createObject( "java", "javax.crypto.Mac" ).getInstance( "HmacSHA256" );
		var secret = createObject( "java", "javax.crypto.spec.SecretKeySpec" ).init( arguments.keyBytes, "HmacSHA256" );
		mac.init( secret );
		return mac.doFinal( arguments.data.getBytes( "UTF-8" ) );
	}

	private function _hex( required binary bytes ){
		return createObject( "java", "java.util.HexFormat" ).of().formatHex( arguments.bytes );
	}

}

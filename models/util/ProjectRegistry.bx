/**
 * The /projects entries. Each project here has an overview page at
 * /projects/{slug} (views/projects/{slug}/overview.bxm); getFeatured() adds
 * the hosted apps, which live on their own sites.
 *
 * group decides the section on /projects (GROUPS, in display order). status
 * is what a visitor should expect: "In production" runs a live site, "Beta"
 * is usable but pre-1.0, "Experiment" was built to try something out, and
 * "Superseded" has a successor named in its tagline.
 */
class {

	variables.GROUPS = [
		{ id: "boxlang", title: "BoxLang modules",          text: "Installable with install-bx-module or CommandBox." },
		{ id: "coldbox", title: "ColdBox and CFML modules", text: "For Lucee and Adobe ColdFusion." },
		{ id: "archive", title: "Experiments and archive",  text: "Demos, games and earlier versions of things above." }
	];

	variables.projects = [
		{
			slug     : "boxlang-express",
			name     : "boxlang-express",
			icon     : "bi-boxes",
			tagline  : "An Express.js-style API for building lightweight HTTP servers in BoxLang. Runs this site.",
			group    : "boxlang",
			status   : "In production",
			language : "BoxLang"
		},
		{
			slug     : "bx-activitypub",
			name     : "bx-activitypub",
			icon     : "bi-broadcast",
			tagline  : "ActivityPub federation for BoxLang apps: publish posts to Mastodon and the fediverse, and accept public replies back.",
			group    : "boxlang",
			status   : "In production",
			language : "BoxLang"
		},
		{
			slug     : "bx-passkeys",
			name     : "bx-passkeys",
			icon     : "bi-fingerprint",
			tagline  : "WebAuthn passkeys for BoxLang: passwordless registration and sign-in with JDK crypto only, no third-party jars.",
			group    : "boxlang",
			status   : "In production",
			language : "BoxLang"
		},
		{
			slug     : "bx-graphql",
			name     : "bx-graphql",
			icon     : "bi-diagram-2",
			tagline  : "A schema-first GraphQL server for plain BoxLang, with no ColdBox, WireBox or HTTP framework required.",
			group    : "boxlang",
			status   : "In production",
			language : "BoxLang"
		},
		{
			slug     : "boxlang-ssg",
			name     : "boxlang-ssg",
			icon     : "bi-file-earmark-richtext",
			tagline  : "A static site generator in pure BoxLang: Markdown and .bxm, layouts, collections and pagination.",
			group    : "boxlang",
			status   : "Beta",
			language : "BoxLang"
		},
		{
			slug     : "coldbox-graphql",
			name     : "coldbox-graphql",
			icon     : "bi-diagram-3",
			tagline  : "A schema-agnostic ColdBox module that serves a GraphQL API from SDL files you supply.",
			group    : "coldbox",
			status   : "Beta",
			language : "CFML"
		},
		{
			slug     : "cbpasskeys",
			name     : "cbpasskeys",
			icon     : "bi-key",
			tagline  : "The ColdBox sibling to bx-passkeys: the same passkey checks and API on Lucee and Adobe ColdFusion.",
			group    : "coldbox",
			status   : "Beta",
			language : "CFML"
		},
		{
			slug     : "bx-zork",
			name     : "bx-zork",
			icon     : "bi-controller",
			tagline  : "A from-scratch text-adventure parser engine in BoxLang, loaded with the world of Zork I.",
			group    : "archive",
			status   : "Experiment",
			language : "BoxLang"
		},
		{
			slug     : "stripe-development",
			name     : "stripe-development",
			icon     : "bi-credit-card",
			tagline  : "A local dashboard, playground and webhook receiver for the Stripe API in test mode, with no Stripe SDK.",
			group    : "archive",
			status   : "Experiment",
			language : "BoxLang"
		},
		{
			slug     : "boxlang-stomp-chat",
			name     : "boxlang-stomp-chat",
			icon     : "bi-chat-dots",
			tagline  : "A Slack-like multi-channel chat app on BoxLang and SocketBox STOMP, with a no-build Vue 3 front end.",
			group    : "archive",
			status   : "Experiment",
			language : "BoxLang"
		},
		{
			slug     : "dnd-game-v2",
			name     : "dnd-game-v2",
			icon     : "bi-dice-5",
			tagline  : "A browser-based dungeon crawler inspired by D&D 5e, with real-time WebSocket combat.",
			group    : "archive",
			status   : "Experiment",
			language : "JavaScript"
		},
		{
			slug     : "bxthreads",
			name     : "bxThreads",
			icon     : "bi-chat-square-text",
			tagline  : "A Reddit-style forum on boxlang-express. Rebuilt and continued as DismalThreads.",
			group    : "archive",
			status   : "Superseded",
			language : "BoxLang"
		},
		{
			slug     : "commandbox-ssg",
			name     : "commandbox-ssg",
			icon     : "bi-terminal",
			tagline  : "A static site generator as a CommandBox module. Succeeded by boxlang-ssg.",
			group    : "archive",
			status   : "Superseded",
			language : "CFML"
		}
	];

	// The hosted apps lead; boxlang-express is what they and this site run on.
	variables.featured = [
		{
			name   : "Feedhouse",
			url    : "https://feedhouse.app",
			label  : "feedhouse.app",
			image  : "/assets/images/feedhouse-icon.svg",
			pitch  : "A feed reader in the spirit of Google Reader: RSS, YouTube, podcasts, Mastodon and Bluesky, in the order they were published, with nothing ranking your feed.",
			stack  : "BoxLang · BoxExpress"
		},
		{
			name   : "DismalThreads",
			url    : "https://dismalthreads.com",
			label  : "dismalthreads.com",
			image  : "/assets/images/dismalthreads-icon.svg",
			pitch  : "A community of groups, posts and threaded comments, with friends, reactions and replies that update live.",
			stack  : "BoxLang · BoxExpress · React"
		},
		{
			name   : "boxlang-express",
			url    : "/projects/boxlang-express",
			label  : "Docs",
			icon   : "bi-boxes",
			pitch  : "An Express.js-style web framework for BoxLang: routing, middleware, sessions, WebSockets and STOMP. Both apps above, and this site, run on it.",
			stack  : "BoxLang module"
		}
	];

	/**
	 * @return {array} Every project with an overview page, in display order.
	 */
	function getProjects(){
		return variables.projects;
	}

	/**
	 * @return {array} The sections of /projects, each { id, title, text, projects }.
	 */
	function getGroups(){
		var sections = [];
		for ( var group in variables.GROUPS ){
			var section = duplicate( group );
			section.projects = [];
			for ( var project in variables.projects ){
				if ( project.group == group.id ) section.projects.append( project );
			}
			sections.append( section );
		}
		return sections;
	}

	/**
	 * @return {array} The projects to lead with: { name, url, label, pitch, stack } plus image or icon.
	 */
	function getFeatured(){
		return variables.featured;
	}

	/**
	 * @param {string} slug - The project's slug.
	 * @return {struct} The matching project, or null if no project has that slug.
	 */
	function findProject( required string slug ){
		for ( var project in variables.projects ){
			if ( project.slug == arguments.slug ){
				return project;
			}
		}
		return javacast( "null", "" );
	}

}

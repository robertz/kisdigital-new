/**
 * Backs /manage/project-docs (admin editor) and the public
 * /projects/:slug/docs/:page route. Replaces the hardcoded projectDocs
 * struct + raw .bxm template files that used to live in routes/Projects.bx —
 * every edit now takes effect immediately instead of needing a deploy.
 */
class {

	/**
	 * Returns every doc page for a project, ordered for both the public
	 * sidebar nav and the admin list.
	 *
	 * @param {string} projectSlug - The project's slug.
	 * @return {array} Array of structs: id, project_slug, page_slug, title, sort_order, last_updated.
	 */
	function getDocsForProject( required string projectSlug ){
		return queryExecute(
			"SELECT id, project_slug, page_slug, title, sort_order, last_updated
			FROM ProjectDoc
			WHERE project_slug = :project_slug
			ORDER BY sort_order ASC, title ASC",
			{ "project_slug": { value: arguments.projectSlug, cfsqltype: "cf_sql_varchar" } },
			{ returnType: "array" }
		);
	}

	/**
	 * Returns every doc page across every project, grouped for the admin
	 * index — one query, grouped in BoxLang rather than N queries per project.
	 *
	 * @return {struct} project_slug -> array of structs (same shape as getDocsForProject()).
	 */
	function getAllDocsGroupedByProject(){
		var rows = queryExecute(
			"SELECT id, project_slug, page_slug, title, sort_order, last_updated
			FROM ProjectDoc
			ORDER BY project_slug ASC, sort_order ASC, title ASC",
			{},
			{ returnType: "array" }
		);

		var grouped = {};
		for ( var row in rows ){
			if ( !grouped.keyExists( row.project_slug ) ){
				grouped[ row.project_slug ] = [];
			}
			grouped[ row.project_slug ].append( row );
		}
		return grouped;
	}

	/**
	 * @param {string} projectSlug - The project's slug.
	 * @return {boolean} Whether this project has any doc pages at all —
	 *         replaces the old projectDocs.keyExists() whitelist check.
	 */
	function projectHasDocs( required string projectSlug ){
		return queryExecute(
			"SELECT COUNT(*) AS cnt FROM ProjectDoc WHERE project_slug = :project_slug",
			{ "project_slug": { value: arguments.projectSlug, cfsqltype: "cf_sql_varchar" } },
			{ returnType: "array" }
		)[ 1 ].cnt > 0;
	}

	/**
	 * Saves (inserts or updates) a doc page from a ProjectDocBean.
	 *
	 * A new page's slug defaults to a slugified title if left blank, made
	 * unique within its project (not globally — the same page_slug like
	 * "getting-started" legitimately repeats across different projects). A
	 * new page is appended after the project's current last page unless a
	 * sort_order was explicitly set.
	 *
	 * @param {ProjectDocBean} bean
	 * @return {string} The doc page's id.
	 */
	function saveDoc( required bean ){
		var isNew     = !len( trim( arguments.bean.getId() ) );
		var docId     = isNew ? lcase( createGUID() ) : arguments.bean.getId();
		var baseSlug  = len( trim( arguments.bean.getPageSlug() ) ) ? trim( arguments.bean.getPageSlug() ) : slugify( arguments.bean.getTitle() );
		var finalSlug = makeUniqueSlug( arguments.bean.getProjectSlug(), baseSlug, isNew ? "" : docId );
		var sortOrder = isNew && arguments.bean.getSortOrder() == 0 ? _nextSortOrder( arguments.bean.getProjectSlug() ) : arguments.bean.getSortOrder();

		if ( isNew ){
			queryExecute(
				"INSERT INTO ProjectDoc (id, project_slug, page_slug, title, body, sort_order)
				VALUES (:id, :project_slug, :page_slug, :title, :body, :sort_order)",
				{
					"id"          : { value: docId,                              cfsqltype: "cf_sql_varchar" },
					"project_slug": { value: arguments.bean.getProjectSlug(),     cfsqltype: "cf_sql_varchar" },
					"page_slug"   : { value: finalSlug,                          cfsqltype: "cf_sql_varchar" },
					"title"       : { value: arguments.bean.getTitle(),          cfsqltype: "cf_sql_varchar" },
					"body"        : { value: arguments.bean.getBody(),           cfsqltype: "cf_sql_longvarchar" },
					"sort_order"  : { value: sortOrder,                          cfsqltype: "cf_sql_integer" }
				}
			);
		} else {
			queryExecute(
				"UPDATE ProjectDoc
				SET page_slug = :page_slug, title = :title, body = :body, sort_order = :sort_order
				WHERE id = :id",
				{
					"id"        : { value: docId,                     cfsqltype: "cf_sql_varchar" },
					"page_slug" : { value: finalSlug,                 cfsqltype: "cf_sql_varchar" },
					"title"     : { value: arguments.bean.getTitle(), cfsqltype: "cf_sql_varchar" },
					"body"      : { value: arguments.bean.getBody(),  cfsqltype: "cf_sql_longvarchar" },
					"sort_order": { value: sortOrder,                 cfsqltype: "cf_sql_integer" }
				}
			);
		}

		return docId;
	}

	/**
	 * @param {string} docId - The doc page's UUID.
	 */
	function deleteDoc( required string docId ){
		queryExecute(
			"DELETE FROM ProjectDoc WHERE id = :id",
			{ "id": { value: arguments.docId, cfsqltype: "cf_sql_varchar" } }
		);
	}

	/**
	 * Moves one doc page up or down within its project by swapping
	 * sort_order with its immediate neighbour in that direction.
	 *
	 * @param {string} docId     - The doc page to move.
	 * @param {string} direction - "up" or "down".
	 */
	function moveDoc( required string docId, required string direction ){
		var current = queryExecute(
			"SELECT id, project_slug, sort_order FROM ProjectDoc WHERE id = :id",
			{ "id": { value: arguments.docId, cfsqltype: "cf_sql_varchar" } },
			{ returnType: "array" }
		);
		if ( !current.len() ) return;

		var row       = current[ 1 ];
		var comparator = arguments.direction == "up" ? "<" : ">";
		var order      = arguments.direction == "up" ? "DESC" : "ASC";

		var neighbor = queryExecute(
			"SELECT id, sort_order
			FROM ProjectDoc
			WHERE project_slug = :project_slug
				AND sort_order #comparator# :sort_order
			ORDER BY sort_order #order#
			LIMIT 1",
			{
				"project_slug": { value: row.project_slug, cfsqltype: "cf_sql_varchar" },
				"sort_order"  : { value: row.sort_order,   cfsqltype: "cf_sql_integer" }
			},
			{ returnType: "array" }
		);
		if ( !neighbor.len() ) return;

		_setSortOrder( row.id, neighbor[ 1 ].sort_order );
		_setSortOrder( neighbor[ 1 ].id, row.sort_order );
	}

	private function _setSortOrder( required string docId, required numeric sortOrder ){
		queryExecute(
			"UPDATE ProjectDoc SET sort_order = :sort_order WHERE id = :id",
			{
				"sort_order": { value: arguments.sortOrder, cfsqltype: "cf_sql_integer" },
				"id"        : { value: arguments.docId,     cfsqltype: "cf_sql_varchar" }
			}
		);
	}

	private function _nextSortOrder( required string projectSlug ){
		var maxOrder = queryExecute(
			"SELECT COALESCE(MAX(sort_order), 0) AS maxOrder FROM ProjectDoc WHERE project_slug = :project_slug",
			{ "project_slug": { value: arguments.projectSlug, cfsqltype: "cf_sql_varchar" } },
			{ returnType: "array" }
		)[ 1 ].maxOrder;
		return maxOrder + 1;
	}

	/**
	 * Converts a string to a URL-safe slug. Same rules as PostService.slugify().
	 *
	 * @param {string} text - Input string.
	 * @return {string} Slugified string.
	 */
	function slugify( required string text ){
		var result = lCase( arguments.text );
		result = reReplace( result, "[^a-z0-9]+", "-", "ALL" );
		result = reReplace( result, "^-+|-+$", "", "ALL" );
		return result;
	}

	/**
	 * Returns a page_slug that is unique within one project (not globally —
	 * the same slug can exist under a different project_slug).
	 *
	 * @param {string} projectSlug - The project this page belongs to.
	 * @param {string} baseSlug    - The desired slug.
	 * @param {string} excludeId   - Doc id to exclude from the uniqueness check (edit case).
	 * @return {string} A unique slug within this project.
	 */
	function makeUniqueSlug( required string projectSlug, required string baseSlug, string excludeId = "" ){
		var candidate = arguments.baseSlug;
		var counter   = 2;

		while ( true ){
			var sql    = "SELECT COUNT(*) AS cnt FROM ProjectDoc WHERE project_slug = :project_slug AND page_slug = :page_slug";
			var params = {
				"project_slug": { value: arguments.projectSlug, cfsqltype: "cf_sql_varchar" },
				"page_slug"   : { value: candidate,              cfsqltype: "cf_sql_varchar" }
			};

			if ( len( arguments.excludeId ) ){
				sql &= " AND id != :id";
				params[ "id" ] = { value: arguments.excludeId, cfsqltype: "cf_sql_varchar" };
			}

			var cnt = queryExecute( sql, params, { returnType: "array" } )[ 1 ].cnt;

			if ( cnt == 0 ) return candidate;

			candidate = arguments.baseSlug & "-" & counter++;
		}
	}

}

/**
 * Handles user authentication for the CMS.
 */
class {

	// Never matches any real password — exists purely so authenticate() has
	// something to BCryptVerify() against on the "no such email" path. Its
	// own plaintext is never used or stored anywhere.
	variables.dummyHash = "$2a$10$0D7vOvjfbI/reBSHcGwog.Wun8Jv3a5JulKhZ2uKeJNzecdKOQ8xa";

	/**
	 * Attempts to authenticate a user by email and password.
	 *
	 * Returns the user struct (id, display_name, email, role) on success,
	 * or an empty struct on failure.
	 *
	 * SECURITY [H5]: Also checks the is_active flag — inactive/suspended accounts
	 *               are rejected even if the password is correct.
	 *
	 * SECURITY: BCryptVerify() always runs exactly once, against either the
	 *           real stored hash or variables.dummyHash — never skipped.
	 *           bcrypt's cost factor is what makes a real check slow (tens of
	 *           milliseconds), so returning early for "no such email" or "an
	 *           inactive account" without it was a timing side channel: an
	 *           attacker could tell those cases apart from a genuine
	 *           wrong-password rejection by response time alone, and use
	 *           that to enumerate valid emails before ever guessing a
	 *           password.
	 *
	 * @param {string} email    - The user's email address.
	 * @param {string} password - The plaintext password to verify against BCrypt hash.
	 * @return {struct} User struct on success, empty struct on failure.
	 */
	function authenticate( required string email, required string password ){
		var users = queryExecute(
			"SELECT id, display_name, email, password, role, is_active
			FROM User
			WHERE email = :email
			LIMIT 1",
			{
				"email" : { value: arguments.email, cfsqltype: "cf_sql_varchar" }
			},
			{ returnType: "array" }
		);

		var user = users.len() ? users[ 1 ] : { "password": "", "is_active": false };
		var hash = len( user.password ?: "" ) ? user.password : variables.dummyHash;
		var passwordMatches = BCryptVerify( arguments.password, hash );

		if ( !users.len() || !user.is_active || !passwordMatches ){
			return {};
		}

		return user;
	}

	/**
	 * Looks up a User row by a Google-verified email, creating a new
	 * role='commenter' row if none exists. Existing rows (staff accounts
	 * created the normal way, or a commenter who's signed in before) keep
	 * whatever role they already have — this never changes an existing
	 * row's role, so it can't be used to escalate a commenter into admin
	 * just by them re-authenticating.
	 *
	 * The new row's password is a BCryptHash() of a random, never-disclosed
	 * UUID — a valid hash the User.password NOT NULL column accepts, but
	 * one nobody can ever know the plaintext for, so password-based login
	 * (doLogin() in routes/Manage.bx) can never succeed against it. That
	 * route also independently rejects any non-admin/author role even if it
	 * somehow did, so this account only ever gets in via Google.
	 *
	 * SECURITY: only call this with an email whose ownership Google has
	 * already confirmed (GoogleOAuthClient.getUserInfo()'s emailVerified) —
	 * this trusts the given email outright, the same way authenticate()
	 * trusts a matched password.
	 *
	 * @param {string} email       - Google-verified email address.
	 * @param {string} displayName - Google account's display name; falls
	 *        back to the email's local part when Google didn't provide one.
	 * @param {string} pictureUrl  - Google account's profile photo URL, if
	 *        any (GoogleOAuthClient.getUserInfo()'s pictureUrl) — only ever
	 *        stored at creation time, same as displayName; ignored for an
	 *        existing row.
	 * @return {struct} User struct (id, display_name, email, role,
	 *         avatar_url) — same shape as authenticate()'s success case plus
	 *         avatar_url. Empty struct if a matching row exists but is
	 *         deactivated.
	 */
	function findOrCreateGoogleUser( required string email, string displayName = "", string pictureUrl = "" ){
		var normalizedEmail = lCase( trim( arguments.email ) );

		var existing = queryExecute(
			"SELECT id, display_name, email, role, avatar_url, is_active
			FROM User
			WHERE email = :email
			LIMIT 1",
			{ "email": { value: normalizedEmail, cfsqltype: "cf_sql_varchar" } },
			{ returnType: "array" }
		);

		if ( existing.len() ){
			return existing[ 1 ].is_active ? existing[ 1 ] : {};
		}

		var newId      = createGUID();
		var name        = len( trim( arguments.displayName ) ) ? trim( arguments.displayName ) : listFirst( normalizedEmail, "@" );
		var pictureUrl  = trim( arguments.pictureUrl );

		queryExecute(
			"INSERT INTO User (id, display_name, email, password, role, avatar_url)
			VALUES (:id, :display_name, :email, :password, 'commenter', :avatar_url)",
			{
				"id"          : { value: newId,                        cfsqltype: "cf_sql_varchar" },
				"display_name": { value: name,                         cfsqltype: "cf_sql_varchar" },
				"email"       : { value: normalizedEmail,               cfsqltype: "cf_sql_varchar" },
				"password"    : { value: BCryptHash( createUUID() ),    cfsqltype: "cf_sql_varchar" },
				"avatar_url"  : { value: pictureUrl, cfsqltype: "cf_sql_varchar", null: !len( pictureUrl ) }
			}
		);

		return { "id": newId, "display_name": name, "email": normalizedEmail, "role": "commenter", "avatar_url": pictureUrl };
	}

}

/**
 * Reads /manage/security — a set of independent heuristic scans over the
 * RequestLog table, each one aimed at a different attack pattern (volume,
 * burst rate, scanning, payload signatures, scanner UAs, sensitive-path
 * recon, unusual HTTP methods). Unlike InsightsService, nothing here is
 * filtered to "real visitor" traffic — the entire point is catching the
 * traffic InsightsService deliberately excludes (bots, non-GET methods,
 * /manage% probing).
 *
 * Every method returns a plain array of rows; each is a heuristic, not a
 * verdict — false positives are expected (a single busy legitimate crawler
 * can trip volume/enumeration thresholds, and the payload-signature regexes
 * catch *shapes* of common exploit strings, not confirmed exploitation).
 * This is a triage aid for a human reviewing traffic, not an automated
 * block list.
 */
class {

	/**
	 * Top requesting IPs overall, regardless of path or outcome.
	 * Catches: scraping, basic DDoS, credential-stuffing infra.
	 *
	 * @return {array} of { ip_address, total_requests, distinct_paths, first_seen, last_seen }.
	 */
	function getVolumeAnomalies( numeric limit = 20 ){
		return queryExecute(
			"SELECT
				ip_address,
				COUNT(*) AS total_requests,
				COUNT(DISTINCT path) AS distinct_paths,
				MIN(requested_at) AS first_seen,
				MAX(requested_at) AS last_seen
			FROM RequestLog
			GROUP BY ip_address
			ORDER BY total_requests DESC
			LIMIT :lim",
			{ "lim": { value: arguments.limit, cfsqltype: "cf_sql_integer" } },
			{ returnType: "array" }
		);
	}

	/**
	 * Request velocity per IP per minute — a burst a daily/hourly average
	 * would smooth over and hide.
	 * Catches: brute force, rate-limit-bypass attempts, bot bursts.
	 *
	 * @param {numeric} threshold - Requests/minute above which a bucket is
	 *        flagged. Tune to this site's normal traffic.
	 * @return {array} of { ip_address, minute_bucket, requests_in_minute }.
	 */
	function getBurstDetection( numeric threshold = 60, numeric limit = 50 ){
		return queryExecute(
			"SELECT
				ip_address,
				DATE_FORMAT(requested_at, '%Y-%m-%d %H:%i') AS minute_bucket,
				COUNT(*) AS requests_in_minute
			FROM RequestLog
			GROUP BY ip_address, minute_bucket
			HAVING requests_in_minute > :threshold
			ORDER BY requests_in_minute DESC
			LIMIT :lim",
			{
				"threshold": { value: arguments.threshold, cfsqltype: "cf_sql_integer" },
				"lim"      : { value: arguments.limit, cfsqltype: "cf_sql_integer" }
			},
			{ returnType: "array" }
		);
	}

	/**
	 * IPs probing many distinct paths with a high error rate.
	 * Catches: directory brute-forcing, endpoint discovery, auth guessing.
	 *
	 * @return {array} of { ip_address, total_requests, distinct_paths, error_hits, error_ratio }.
	 */
	function getEnumerationScanning( numeric minDistinctPaths = 15, numeric minErrorRatio = 0.5, numeric limit = 30 ){
		return queryExecute(
			"SELECT
				ip_address,
				COUNT(*) AS total_requests,
				COUNT(DISTINCT path) AS distinct_paths,
				SUM(CASE WHEN status_code IN (401, 403, 404) THEN 1 ELSE 0 END) AS error_hits,
				ROUND(SUM(CASE WHEN status_code IN (401, 403, 404) THEN 1 ELSE 0 END) / COUNT(*), 2) AS error_ratio
			FROM RequestLog
			GROUP BY ip_address
			HAVING distinct_paths > :minDistinctPaths
				AND error_ratio > :minErrorRatio
			ORDER BY error_hits DESC
			LIMIT :lim",
			{
				"minDistinctPaths": { value: arguments.minDistinctPaths, cfsqltype: "cf_sql_integer" },
				"minErrorRatio"   : { value: arguments.minErrorRatio, cfsqltype: "cf_sql_float" },
				"lim"             : { value: arguments.limit, cfsqltype: "cf_sql_integer" }
			},
			{ returnType: "array" }
		);
	}

	/**
	 * SQLi / XSS / path-traversal / command-injection shaped strings found in
	 * the path or query string, each tagged with which category matched.
	 * Catches: exploit attempts embedded in the request itself.
	 *
	 * The regex patterns are fixed, non-attacker-controlled SQL text (not
	 * bound params) — same as every other method here.
	 *
	 * @return {array} of RequestLog rows plus a signalType column.
	 */
	function getPayloadSignatures( numeric limit = 100 ){
		// sqli is checked against query_string only, never path — path
		// segments routinely contain "--" as an ordinary word separator in
		// slugs (e.g. /posts/2026/03/cbwire--computed-vs-data-properties),
		// which the sqli pattern's bare "--" alternative would otherwise
		// flag on every such post. The other three categories don't have
		// that problem (a real path never legitimately contains "<script",
		// "../", or a backtick), so they still check both columns.
		var sqliPattern   = "(union.{1,20}select|select.+from|or 1=1|--|;--|/\*)";
		var nonSqliPattern = "(<script|onerror=|onload=|javascript:|\.\./|%2e%2e|/etc/passwd|/proc/self|;|\||\$\(|`)";

		return queryExecute(
			"SELECT
				id,
				requested_at,
				ip_address,
				method,
				path,
				query_string,
				status_code,
				CASE
					WHEN query_string REGEXP '(union.{1,20}select|select.+from|or 1=1|--|;--|/\\*)'
						THEN 'sqli'
					WHEN path REGEXP '(<script|onerror=|onload=|javascript:)'
						OR query_string REGEXP '(<script|onerror=|onload=|javascript:)'
						THEN 'xss'
					WHEN path REGEXP '(\\.\\./|%2e%2e|/etc/passwd|/proc/self)'
						OR query_string REGEXP '(\\.\\./|%2e%2e|/etc/passwd|/proc/self)'
						THEN 'path_traversal'
					WHEN path REGEXP '(;|\\||\\$\\(|`)'
						OR query_string REGEXP '(;|\\||\\$\\(|`)'
						THEN 'command_injection'
					END AS signal_type
			FROM RequestLog
			WHERE query_string REGEXP :sqliPattern
			   OR path REGEXP :nonSqliPattern
			   OR query_string REGEXP :nonSqliPattern
			ORDER BY requested_at DESC
			LIMIT :lim",
			{
				"sqliPattern"   : { value: sqliPattern, cfsqltype: "cf_sql_varchar" },
				"nonSqliPattern": { value: nonSqliPattern, cfsqltype: "cf_sql_varchar" },
				"lim"           : { value: arguments.limit, cfsqltype: "cf_sql_integer" }
			},
			{ returnType: "array" }
		);
	}

	/**
	 * Requests with an empty or known-scanner User-Agent, grouped by IP.
	 * Catches: automated tooling. Low-confidence on its own (UA is trivially
	 * spoofable) — best used to corroborate another signal, not decide alone.
	 *
	 * @return {array} of { ip_address, user_agent, hits, distinct_paths }.
	 */
	function getSuspiciousUserAgents( numeric limit = 30 ){
		return queryExecute(
			"SELECT
				ip_address,
				user_agent,
				COUNT(*) AS hits,
				COUNT(DISTINCT path) AS distinct_paths
			FROM RequestLog
			WHERE user_agent = ''
			   OR user_agent REGEXP '(sqlmap|nikto|nmap|masscan|gobuster|dirbuster|wpscan|acunetix|nessus|w3af|havij|python-requests|go-http-client|libwww-perl)'
			GROUP BY ip_address, user_agent
			ORDER BY hits DESC
			LIMIT :lim",
			{ "lim": { value: arguments.limit, cfsqltype: "cf_sql_integer" } },
			{ returnType: "array" }
		);
	}

	/**
	 * Requests for paths that only make sense as reconnaissance (exposed
	 * config, secrets, admin panels) — deliberately not filtered to failed
	 * status codes, since a 200 on one of these is far more urgent than a
	 * 404.
	 *
	 * @return {array} of { id, requested_at, ip_address, method, path, status_code, user_agent }.
	 */
	function getSensitivePathProbing( numeric limit = 50 ){
		return queryExecute(
			"SELECT
				id,
				requested_at,
				ip_address,
				method,
				path,
				status_code,
				user_agent
			FROM RequestLog
			WHERE path REGEXP '(wp-admin|wp-login|\\.env|\\.git/|phpmyadmin|/admin|\\.aws/|id_rsa|\\.ssh/|config\\.php|\\.htaccess|actuator|debug/vars)'
			ORDER BY requested_at DESC
			LIMIT :lim",
			{ "lim": { value: arguments.limit, cfsqltype: "cf_sql_integer" } },
			{ returnType: "array" }
		);
	}

	/**
	 * Requests using an HTTP method outside the ordinary set.
	 * Catches: protocol-level probing (TRACE for XST, CONNECT for
	 * tunneling, etc).
	 *
	 * @return {array} of { method, ip_address, hits, first_seen, last_seen }.
	 */
	function getUnusualMethods( numeric limit = 30 ){
		return queryExecute(
			"SELECT
				method,
				ip_address,
				COUNT(*) AS hits,
				MIN(requested_at) AS first_seen,
				MAX(requested_at) AS last_seen
			FROM RequestLog
			WHERE method NOT IN ('GET', 'POST', 'PUT', 'PATCH', 'DELETE', 'HEAD', 'OPTIONS')
			GROUP BY method, ip_address
			ORDER BY hits DESC
			LIMIT :lim",
			{ "lim": { value: arguments.limit, cfsqltype: "cf_sql_integer" } },
			{ returnType: "array" }
		);
	}

}

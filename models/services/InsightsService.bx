/**
 * Reads /manage/insights and the dashboard's insights summary card from the
 * RequestLog table (see db/migrations/0004_add_request_log.sql) — replaces
 * GoatCounterClient, whose synchronous, rate-limited API calls could lock up
 * request handling. Everything here is a plain read against a table our own
 * RequestLogger.bx middleware already fills in asynchronously, so there's no
 * external dependency left to be slow, rate-limited, or down.
 *
 * Every query shares the same traffic filter (_where()): GET requests only,
 * excluding /manage/* (CMS admin, not visitor traffic), /assets/* (static
 * files, not pages), /health (infra probe), and known bots/crawlers (see
 * BotDetector.bx) — the same shape of filtering GoatCounter's client-side
 * pageview beacon gave for free by construction (it only ever fired from a
 * real browser rendering a real public page).
 *
 * "Total visitors" counts distinct IP addresses, not deduplicated visitor
 * fingerprints the way GoatCounter's own number worked — the closest
 * equivalent available from a plain access log, not a precise match.
 */
class {

	variables.siteHost    = "";
	variables.botDetector = "";

	function init( required string siteHost ){
		variables.siteHost    = arguments.siteHost;
		variables.botDetector = new models.util.BotDetector();
		return this;
	}

	/**
	 * @return {struct} { total } — distinct visitor IPs in the window.
	 */
	function getTotal( numeric daysBack = 30 ){
		var days = arguments.daysBack;
		var row  = queryExecute(
			"SELECT COUNT(DISTINCT ip_address) AS total
			FROM RequestLog
			WHERE " & _where(),
			_params( days ),
			{ returnType: "array" }
		)[ 1 ];
		return { "total": row.total };
	}

	/**
	 * Grouped by top-level content area (Articles, Projects, Games, ...)
	 * rather than exact path — a per-post/per-project breakdown is too
	 * granular to read as "what's popular" at a glance, and on a site this
	 * size it's mostly individual posts each getting a handful of hits, not
	 * a meaningful ranking. Excludes 404s — a broken/removed link showing up
	 * here is noise, not a page anyone actually visited.
	 *
	 * @return {array} of { name, path, count }, highest first. `path` is the
	 *         area's canonical link target, empty when there isn't one
	 *         (e.g. "Tags" spans many different /tag/:tag pages).
	 */
	function getTopContentAreas( numeric daysBack = 30, numeric limit = 10 ){
		var days = arguments.daysBack;
		var params = _params( days );
		params[ "lim" ] = { value: arguments.limit, cfsqltype: "cf_sql_integer" };

		var rows = queryExecute(
			"SELECT
				CASE
					WHEN path = '/' THEN 'Home'
					WHEN path LIKE '/posts%' THEN 'Articles'
					WHEN path LIKE '/projects%' THEN 'Projects'
					WHEN path LIKE '/games%' THEN 'Games'
					WHEN path = '/about' THEN 'About'
					WHEN path LIKE '/tag/%' THEN 'Tags'
					WHEN path LIKE '/search%' THEN 'Search'
					ELSE 'Other'
				END AS name,
				COUNT(*) AS count
			FROM RequestLog
			WHERE " & _where() & "
				AND " & _excluding404() & "
			GROUP BY name
			ORDER BY count DESC
			LIMIT :lim",
			params,
			{ returnType: "array" }
		);

		var areaPaths = {
			"Home"    : "/",
			"Articles": "/posts",
			"Projects": "/projects",
			"Games"   : "/games",
			"About"   : "/about"
		};
		for ( var row in rows ){
			row[ "path" ] = areaPaths.keyExists( row.name ) ? areaPaths[ row.name ] : "";
		}
		return rows;
	}

	/**
	 * Referrers are grouped by host, not the full URL — a raw Referer header
	 * carries the referring page's whole path and query string, which would
	 * otherwise fragment one real source (e.g. Google search) into dozens of
	 * near-duplicate rows. Referrals from this site's own domain are dropped
	 * (internal navigation isn't a "referrer" in any useful sense); an empty
	 * Referer header is labeled "(direct)".
	 *
	 * @return {array} of { name, count }, highest first.
	 */
	function getTopReferrers( numeric daysBack = 30, numeric limit = 10 ){
		var days = arguments.daysBack;
		var params = _params( days );
		params[ "lim" ]     = { value: arguments.limit, cfsqltype: "cf_sql_integer" };
		params[ "selfHost" ] = { value: "%" & variables.siteHost & "%", cfsqltype: "cf_sql_varchar" };

		return queryExecute(
			"SELECT
				CASE
					WHEN referrer = '' THEN '(direct)'
					ELSE SUBSTRING_INDEX(SUBSTRING_INDEX(SUBSTRING_INDEX(referrer, '://', -1), '/', 1), '?', 1)
				END AS name,
				COUNT(*) AS count
			FROM RequestLog
			WHERE " & _where() & "
				AND referrer NOT LIKE :selfHost
			GROUP BY name
			ORDER BY count DESC
			LIMIT :lim",
			params,
			{ returnType: "array" }
		);
	}

	/**
	 * Something GoatCounter never offered: real server-side response times.
	 * Requires at least 3 hits for a path in the window, so one slow one-off
	 * (a cold cache, a background job sharing the box) can't make a
	 * barely-visited path look like the slowest thing on the site. Excludes
	 * 404s for the same reason getTopContentAreas() does — a missing page's
	 * response time isn't a "slow page", it's not a page at all.
	 *
	 * @return {array} of { path, avgDurationMs, count }, slowest first.
	 */
	function getSlowestPaths( numeric daysBack = 30, numeric limit = 10 ){
		var days = arguments.daysBack;
		var params = _params( days );
		params[ "lim" ] = { value: arguments.limit, cfsqltype: "cf_sql_integer" };

		return queryExecute(
			"SELECT path, ROUND(AVG(duration_ms)) AS avgDurationMs, COUNT(*) AS count
			FROM RequestLog
			WHERE " & _where() & "
				AND " & _excluding404() & "
			GROUP BY path
			HAVING COUNT(*) >= 3
			ORDER BY avgDurationMs DESC
			LIMIT :lim",
			params,
			{ returnType: "array" }
		);
	}

	/**
	 * Site-wide daily request totals (same visitor-traffic filter as every
	 * other method here) for the admin dashboard's traffic chart — the
	 * full-site equivalent of PostService.getDailyViewTotals(), which only
	 * ever counted individual post-page views.
	 *
	 * Cached per calendar day in cache("default") rather than as one 30-day
	 * blob: every day except today is over and immutable, so once a day's
	 * total is computed it's cached for a week (long enough to survive a
	 * quiet cache, short enough that a stale value can't linger forever)
	 * and never recomputed. Only missing (uncached) past days trigger a
	 * GROUP BY query, and only for the specific date range that's actually
	 * missing — normally none, since once the window's days are all cached
	 * they stay cached. Today is still accumulating, so it's always read
	 * live with a small, index-bound single-day query instead of being
	 * cached at all. A quiet day still gets a zero row instead of silently
	 * vanishing from the chart.
	 *
	 * @return {array} Array of structs with keys: view_date, total_views. Ordered oldest to newest.
	 */
	function getDailyTotals( numeric daysBack = 30 ){
		var days          = arguments.daysBack;
		var todayMidnight = createDate( year( now() ), month( now() ), day( now() ) );
		var totalsByDate  = {};
		var missingDates  = [];

		for ( var i = days; i >= 1; i-- ){
			var dayMidnight = dateAdd( "d", -i, todayMidnight );
			var dayKey      = dateFormat( dayMidnight, "yyyy-mm-dd" );
			var cached      = cache( "default" ).get( "insights:dailyTotal:" & dayKey );
			if ( cached.isPresent() ){
				totalsByDate[ dayKey ] = cached.get();
			} else {
				arrayAppend( missingDates, dayMidnight );
			}
		}

		if ( arrayLen( missingDates ) ){
			var rows = queryExecute(
				"SELECT DATE(requested_at) AS d, COUNT(*) AS total
				FROM RequestLog
				WHERE " & _whereBetween() & "
					AND " & _excluding404() & "
				GROUP BY DATE(requested_at)",
				_paramsBetween( missingDates[ 1 ], todayMidnight ),
				{ returnType: "array" }
			);

			var countsByDate = {};
			for ( var row in rows ){
				countsByDate[ dateFormat( row.d, "yyyy-mm-dd" ) ] = row.total;
			}
			for ( var dayMidnight in missingDates ){
				var dayKey = dateFormat( dayMidnight, "yyyy-mm-dd" );
				var total  = countsByDate.keyExists( dayKey ) ? countsByDate[ dayKey ] : 0;
				totalsByDate[ dayKey ] = total;
				cache( "default" ).set( "insights:dailyTotal:" & dayKey, total, 604800 );
			}
		}

		var todayKey = dateFormat( todayMidnight, "yyyy-mm-dd" );
		var todayRow = queryExecute(
			"SELECT COUNT(*) AS total
			FROM RequestLog
			WHERE " & _whereBetween() & "
				AND " & _excluding404(),
			_paramsBetween( todayMidnight, dateAdd( "d", 1, todayMidnight ) ),
			{ returnType: "array" }
		)[ 1 ];
		totalsByDate[ todayKey ] = todayRow.total;

		var result = [];
		for ( var i = days; i >= 0; i-- ){
			var dayKey = dateFormat( dateAdd( "d", -i, todayMidnight ), "yyyy-mm-dd" );
			arrayAppend( result, { "view_date": dayKey, "total_views": totalsByDate[ dayKey ] } );
		}
		return result;
	}

	/**
	 * Paginated, mostly-unfiltered raw log rows for the /manage/logs browser
	 * — every request this server handled, newest first, none of the
	 * bot/asset/admin filtering the aggregate methods above apply. That
	 * filtering exists to keep visitor-traffic stats honest; a raw log
	 * browser's entire purpose is to show what actually happened,
	 * unfiltered, so it deliberately skips _where()/_params() and queries
	 * RequestLog directly.
	 *
	 * The exceptions are /health and /manage/server/data: DigitalOcean's
	 * platform probe hits /health every few seconds forever, and
	 * /manage/server/data is the server-monitor page's own 5s polling
	 * loop — neither is ever a real request a reader or an admin debugging
	 * something would care about; left in, either would drown out
	 * everything else in the list. Unlike the bot/asset filtering in
	 * _where(), these are unconditional (no path-search override), since
	 * there's no scenario where seeing this noise here is useful.
	 *
	 * @param {string} pathFilter - Optional substring match against path,
	 *        case-insensitive per this table's collation. Empty = no filter.
	 * @return {struct} { rows, total, page, pageSize, totalPages }
	 */
	function getRecentRequests( numeric page = 1, numeric pageSize = 50, string pathFilter = "" ){
		var safePageSize = arguments.pageSize;
		var offset        = ( arguments.page - 1 ) * safePageSize;
		var hasFilter      = len( trim( arguments.pathFilter ) ) > 0;
		var likeParam      = { value: "%" & trim( arguments.pathFilter ) & "%", cfsqltype: "cf_sql_varchar" };
		var whereClause    = "WHERE path NOT IN ('/health', '/manage/server/data')" & ( hasFilter ? " AND path LIKE :path" : "" );

		var total = queryExecute(
			"SELECT COUNT(*) AS cnt FROM RequestLog " & whereClause,
			hasFilter ? { "path": likeParam } : {},
			{ returnType: "array" }
		)[ 1 ].cnt;

		var params = {
			"lim"   : { value: safePageSize, cfsqltype: "cf_sql_integer" },
			"offset": { value: offset,       cfsqltype: "cf_sql_integer" }
		};
		if ( hasFilter ) {
			params[ "path" ] = likeParam;
		}

		var rows = queryExecute(
			"SELECT id, requested_at, method, path, query_string, status_code, duration_ms, ip_address, referrer, user_agent
			FROM RequestLog " & whereClause & "
			ORDER BY requested_at DESC, id DESC
			LIMIT :lim OFFSET :offset",
			params,
			{ returnType: "array" }
		);

		return {
			"rows"      : rows,
			"total"     : total,
			"page"      : arguments.page,
			"pageSize"  : safePageSize,
			"totalPages": ceiling( max( total, 1 ) / safePageSize ),
			"pathFilter": arguments.pathFilter
		};
	}

	private function _where(){
		return "
			requested_at >= DATE_SUB(NOW(), INTERVAL :days DAY)
			AND method = 'GET'
			AND path NOT LIKE '/manage%'
			AND path NOT LIKE '/assets/%'
			AND path <> '/health'
			AND user_agent <> ''
			AND user_agent NOT REGEXP :botPattern
		";
	}

	// NULL-safe on purpose: status_code is NULL for any row logged before
	// boxlang-express's getStatusCode() existed (see RequestLogger.bx), and
	// "status_code <> 404" alone would silently exclude every one of those
	// too — SQL's three-valued logic treats NULL <> 404 as unknown, not
	// true, so a plain inequality drops NULL rows from the WHERE clause
	// along with the real 404s.
	private function _excluding404(){
		return "( status_code IS NULL OR status_code <> 404 )";
	}

	private function _params( required numeric days ){
		return {
			"days"      : { value: arguments.days, cfsqltype: "cf_sql_integer" },
			"botPattern": { value: variables.botDetector.sqlPattern(), cfsqltype: "cf_sql_varchar" }
		};
	}

	// Same traffic filter as _where(), but bound to an explicit [rangeStart,
	// rangeEnd) window instead of "the last :days days from now" — used by
	// getDailyTotals() to query a specific missing date range rather than
	// always rescanning the full daysBack window.
	private function _whereBetween(){
		return "
			requested_at >= :rangeStart
			AND requested_at < :rangeEnd
			AND method = 'GET'
			AND path NOT LIKE '/manage%'
			AND path NOT LIKE '/assets/%'
			AND path <> '/health'
			AND user_agent <> ''
			AND user_agent NOT REGEXP :botPattern
		";
	}

	private function _paramsBetween( required date rangeStart, required date rangeEnd ){
		return {
			"rangeStart": { value: arguments.rangeStart, cfsqltype: "cf_sql_timestamp" },
			"rangeEnd"  : { value: arguments.rangeEnd, cfsqltype: "cf_sql_timestamp" },
			"botPattern": { value: variables.botDetector.sqlPattern(), cfsqltype: "cf_sql_varchar" }
		};
	}

}

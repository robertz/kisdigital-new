/**
 * Reads /manage/insights from the
 * RequestLog table (see db/migrations/0004_add_request_log.sql) — replaces
 * GoatCounterClient, whose synchronous, rate-limited API calls could lock up
 * request handling. Everything here is a plain read against a table our own
 * RequestLogger.bx middleware already fills in asynchronously, so there's no
 * external dependency left to be slow, rate-limited, or down.
 *
 * Every Insights figure shares the same traffic filter (_visitorFilter()):
 * GET requests only, excluding /manage/* (CMS admin, not visitor traffic),
 * /assets/* (static files, not pages), /health (infra probe), and known
 * bots/crawlers (see BotDetector.bx) — the same shape of filtering
 * GoatCounter's client-side pageview beacon gave for free by construction
 * (it only ever fired from a real browser rendering a real public page).
 *
 * The page view count is narrower still (_pageViewFilter()): only pages a
 * reader can open, answered with a 200. Feeds, the sitemap, fediverse
 * endpoints, redirects and files are requests, not views.
 *
 * Completed days are read from RequestLogDaily, a per-day summary built in
 * the background (see db/migrations/0023_request_log_daily_summaries.sql);
 * only today is counted from raw RequestLog rows. That keeps each card's
 * cost to ~30 summary days plus one day of requests, however busy the site.
 */
class {

	variables.siteHost        = "";
	variables.botDetector     = "";
	variables.persistentCache = new models.util.PersistentCache();
	// Completed days the background job keeps summarized — Insights shows 30.
	variables.summaryDays     = 31;

	function init( required string siteHost ){
		variables.siteHost    = arguments.siteHost;
		variables.botDetector = new models.util.BotDetector();
		return this;
	}

	/**
	 * Broken/removed links and bad referrers, the exact opposite of the page
	 * views count (which only counts pages that loaded) — a 404
	 * isn't noise on its own, it's the whole signal: the one thing every
	 * other "top pages"-style card can't show.
	 *
	 * Scanner probes are left out (see _notAProbe()): they'd otherwise fill
	 * the whole list and bury the links worth fixing.
	 *
	 * @return {array} of { path, count }, highest first.
	 */
	function getTop404s( numeric daysBack = 30, numeric limit = 10 ){
		var days  = arguments.daysBack;
		var limit = arguments.limit;
		return _cached( "insights:top404s:v2:" & days & ":" & limit, 300, () => {
			_ensureDailySummaries( days );
			var params = _windowParams( days );
			params[ "lim" ] = { value: limit, cfsqltype: "cf_sql_integer" };

			return queryExecute(
				"SELECT t.name AS path, SUM(t.hits) AS count
				FROM (
					SELECT name, hits
					FROM RequestLogDaily
					WHERE kind = '404' AND log_date >= :fromDate AND log_date < :todayDate
					UNION ALL
					SELECT LEFT(path, 500) AS name, 1 AS hits
					FROM RequestLog
					WHERE " & _visitorFilter() & "
						AND status_code = 404
				) t
				WHERE " & _notAProbe( "t.name" ) & "
				GROUP BY t.name
				ORDER BY count DESC
				LIMIT :lim",
				params,
				{ returnType: "array" }
			);
		} );
	}

	/**
	 * Referrers are grouped by host, not the full URL — a raw Referer header
	 * carries the referring page's whole path and query string, which would
	 * otherwise fragment one real source (e.g. Google search) into dozens of
	 * near-duplicate rows. Referrals from this site's own domain are dropped
	 * (internal navigation isn't a "referrer" in any useful sense); an empty
	 * Referer header is labeled "(direct)".
	 *
	 * @return {array} of { name, count }, highest first.
	 */
	function getTopReferrers( numeric daysBack = 30, numeric limit = 10 ){
		var days  = arguments.daysBack;
		var limit = arguments.limit;
		return _cached( "insights:topReferrers:" & days & ":" & limit, 300, () => {
			_ensureDailySummaries( days );
			var params = _windowParams( days );
			params[ "lim" ]      = { value: limit, cfsqltype: "cf_sql_integer" };
			params[ "selfHost" ] = { value: "%" & variables.siteHost & "%", cfsqltype: "cf_sql_varchar" };

			return queryExecute(
				"SELECT CASE WHEN t.name = '' THEN '(direct)' ELSE t.name END AS name, SUM(t.hits) AS count
				FROM (
					SELECT name, hits
					FROM RequestLogDaily
					WHERE kind = 'referrer' AND log_date >= :fromDate AND log_date < :todayDate
					UNION ALL
					SELECT " & _referrerHostExpr() & " AS name, 1 AS hits
					FROM RequestLog
					WHERE " & _visitorFilter() & "
				) t
				WHERE t.name NOT LIKE :selfHost
				GROUP BY t.name
				ORDER BY count DESC
				LIMIT :lim",
				params,
				{ returnType: "array" }
			);
		} );
	}

	/**
	 * Site-wide daily page views (see _pageViewFilter()) for the
	 * Insights chart — the full-site equivalent of
	 * PostService.getDailyViewTotals(), which only counts post-page views.
	 * Completed days come from RequestLogDaily; today is still accumulating,
	 * so it's counted live from its own (small) slice of RequestLog. A quiet
	 * day still gets a zero row instead of vanishing from the chart.
	 *
	 * @return {array} Array of structs with keys: view_date, total_views. Ordered oldest to newest.
	 */
	function getDailyTotals( numeric daysBack = 30 ){
		var days = arguments.daysBack;
		_ensureDailySummaries( days );
		var params = _windowParams( days );

		var totalsByDate = {};
		var rows = queryExecute(
			"SELECT log_date, hits
			FROM RequestLogDaily
			WHERE kind = 'pageviews' AND log_date >= :fromDate AND log_date < :todayDate",
			params,
			{ returnType: "array" }
		);
		for ( var row in rows ){
			totalsByDate[ dateFormat( row.log_date, "yyyy-mm-dd" ) ] = row.hits;
		}

		var todayKey = dateFormat( params.todayDate.value, "yyyy-mm-dd" );
		totalsByDate[ todayKey ] = queryExecute(
			"SELECT COUNT(*) AS total
			FROM RequestLog
			WHERE " & _visitorFilter() & "
				AND " & _pageViewFilter(),
			params,
			{ returnType: "array" }
		)[ 1 ].total;

		var result = [];
		for ( var i = days; i >= 0; i-- ){
			var dayKey = dateFormat( dateAdd( "d", -i, params.todayDate.value ), "yyyy-mm-dd" );
			arrayAppend( result, { "view_date": dayKey, "total_views": totalsByDate[ dayKey ] ?: 0 } );
		}
		return result;
	}

	/**
	 * Starts the background job that summarizes each completed day into
	 * RequestLogDaily: a minute after startup, then every 30 minutes. Called
	 * once from app.bxs (not init(), so scripts that construct this service
	 * don't start a thread). Insights still builds any missing day on demand,
	 * so this only keeps that from ever happening while someone waits.
	 */
	function startDailySummaries(){
		var scheduler = createObject( "java", "java.util.concurrent.Executors" ).newSingleThreadScheduledExecutor();
		var runnable  = createDynamicProxy( new models.util.Runnable( () => {
			try {
				_ensureDailySummaries( variables.summaryDays );
			} catch ( any e ){
				println( "[InsightsService] daily summary build failed: " & e.message );
			}
		} ), [ "java.lang.Runnable" ] );
		var minutes   = createObject( "java", "java.util.concurrent.TimeUnit" ).MINUTES;
		scheduler.scheduleWithFixedDelay( runnable, 1, 30, minutes );
	}

	/**
	 * Summarizes every completed day in the last `daysBack` days that
	 * RequestLogDaily doesn't have yet. Safe to run from several places at
	 * once: each row is an upsert, and a day only counts as done once its
	 * 'pageviews' row (written last) exists.
	 *
	 * @param {numeric} daysBack - How many completed days back to check.
	 * @return {numeric} The number of days built.
	 */
	function buildMissingDailySummaries( numeric daysBack = 31 ){
		var todayMidnight = _todayMidnight();
		var fromDate      = dateAdd( "d", -arguments.daysBack, todayMidnight );

		var built = queryExecute(
			"SELECT log_date FROM RequestLogDaily
			WHERE kind = 'pageviews' AND log_date >= :fromDate AND log_date < :todayDate",
			{
				"fromDate" : { value: fromDate,      cfsqltype: "cf_sql_date" },
				"todayDate": { value: todayMidnight, cfsqltype: "cf_sql_date" }
			},
			{ returnType: "array" }
		).map( ( row ) => dateFormat( row.log_date, "yyyy-mm-dd" ) );

		var count = 0;
		for ( var i = arguments.daysBack; i >= 1; i-- ){
			var dayMidnight = dateAdd( "d", -i, todayMidnight );
			if ( !built.contains( dateFormat( dayMidnight, "yyyy-mm-dd" ) ) ){
				_buildDailySummary( dayMidnight );
				count++;
			}
		}
		return count;
	}

	/**
	 * Paginated, mostly-unfiltered raw log rows for the /manage/logs browser
	 * — every request this server handled, newest first, none of the
	 * bot/asset/admin filtering the aggregate methods above apply. That
	 * filtering exists to keep visitor-traffic stats honest; a raw log
	 * browser's entire purpose is to show what actually happened,
	 * unfiltered, so it deliberately skips _visitorFilter() and queries
	 * RequestLog directly.
	 *
	 * The exceptions are /health and the System pages' own polling:
	 * DigitalOcean's platform probe hits /health every few seconds forever,
	 * and the dashboard and System page poll for server metrics while open
	 * — none of it is ever a real request a reader or an admin debugging
	 * something would care about; left in, either would drown out
	 * everything else in the list. Unlike the bot/asset filtering in
	 * _visitorFilter(), these are unconditional (no path-search override), since
	 * there's no scenario where seeing this noise here is useful.
	 *
	 * Pages by id (keyset) rather than OFFSET, and never counts the table:
	 * with 90 days of rows, a COUNT(*) per page view and deep OFFSETs both
	 * meant reading most of RequestLog just to render 50 rows.
	 *
	 * @param {struct} filters - Optional keys:
	 *        path   — prefix match against path (can use its index, unlike
	 *                 a substring match);
	 *        method — exact HTTP method;
	 *        status — "2xx".."5xx", or "unknown" for rows logged before
	 *                 status codes were captured.
	 * @param {numeric} beforeId - Rows older than this id (the "Older" link).
	 * @param {numeric} afterId  - Rows newer than this id (the "Newer" link).
	 * @return {struct} { rows, hasNewer, hasOlder, newerCursor, olderCursor }
	 */
	function getRecentRequests( struct filters = {}, numeric beforeId = 0, numeric afterId = 0, numeric pageSize = 50 ){
		var clauses = [ "path NOT IN ('/health', '/manage/api/system', '/manage/api/dashboard/system', '/manage/server/data')" ];
		var params  = { "lim": { value: arguments.pageSize + 1, cfsqltype: "cf_sql_integer" } };

		var pathPrefix = trim( arguments.filters.path ?: "" );
		if ( len( pathPrefix ) ){
			clauses.append( "path LIKE :path" );
			params[ "path" ] = { value: _escapeLike( pathPrefix ) & "%", cfsqltype: "cf_sql_varchar" };
		}

		var method = arguments.filters.method ?: "";
		if ( len( method ) ){
			clauses.append( "method = :method" );
			params[ "method" ] = { value: method, cfsqltype: "cf_sql_varchar" };
		}

		var statusFilter = arguments.filters.status ?: "";
		if ( statusFilter == "unknown" ){
			clauses.append( "status_code IS NULL" );
		} else if ( reFind( "^[2-5]xx$", statusFilter ) ){
			var statusFloor = val( left( statusFilter, 1 ) ) * 100;
			clauses.append( "status_code >= :statusMin AND status_code < :statusMax" );
			params[ "statusMin" ] = { value: statusFloor,       cfsqltype: "cf_sql_integer" };
			params[ "statusMax" ] = { value: statusFloor + 100, cfsqltype: "cf_sql_integer" };
		}

		var goingNewer = arguments.afterId > 0;
		if ( goingNewer || arguments.beforeId > 0 ){
			clauses.append( goingNewer ? "id > :cursor" : "id < :cursor" );
			params[ "cursor" ] = { value: goingNewer ? arguments.afterId : arguments.beforeId, cfsqltype: "cf_sql_bigint" };
		}

		var rows = queryExecute(
			"SELECT id, requested_at, method, path, query_string, status_code, duration_ms, ip_address, referrer, user_agent
			FROM RequestLog
			WHERE " & clauses.toList( " AND " ) & "
			ORDER BY id " & ( goingNewer ? "ASC" : "DESC" ) & "
			LIMIT :lim",
			params,
			{ returnType: "array" }
		);

		// One extra row was fetched only to learn whether another page exists
		// in the direction of travel.
		var hasMore = rows.len() > arguments.pageSize;
		if ( hasMore ) rows.deleteAt( rows.len() );
		if ( goingNewer ) rows = rows.reverse();

		return {
			"rows"       : rows,
			"hasNewer"   : goingNewer ? hasMore : arguments.beforeId > 0,
			"hasOlder"   : goingNewer ? true : hasMore,
			"newerCursor": rows.len() ? rows[ 1 ].id : 0,
			"olderCursor": rows.len() ? rows[ rows.len() ].id : 0
		};
	}

	// Treats a user's search text literally inside LIKE: MySQL's default
	// escape character is the backslash.
	private function _escapeLike( required string text ){
		return arguments.text.replace( "\", "\\", "all" ).replace( "%", "\%", "all" ).replace( "_", "\_", "all" );
	}

	// Short read-through cache for the Insights cards. With completed days
	// coming from RequestLogDaily these queries are cheap; the cache just
	// spares a reload or two from recounting today's rows.
	private function _cached( required string key, required numeric ttlSeconds, required fn ){
		return variables.persistentCache.getOrSet( arguments.key, arguments.ttlSeconds, arguments.fn );
	}

	// Builds any completed day in the window that the background job hasn't
	// summarized yet (normally none). The lock keeps concurrent card requests
	// in this server from building the same days twice.
	private function _ensureDailySummaries( required numeric daysBack ){
		lock name="insights:dailySummaries" type="exclusive" timeout="300" {
			buildMissingDailySummaries( max( arguments.daysBack, variables.summaryDays ) );
		}
	}

	// Summarizes one completed day. The 'pageviews' row goes last: it's what marks
	// the day as done, so a build interrupted halfway is simply redone.
	private function _buildDailySummary( required date dayMidnight ){
		var params = {
			"logDate"   : { value: arguments.dayMidnight, cfsqltype: "cf_sql_date" },
			"rangeStart": { value: arguments.dayMidnight, cfsqltype: "cf_sql_timestamp" },
			"rangeEnd"  : { value: dateAdd( "d", 1, arguments.dayMidnight ), cfsqltype: "cf_sql_timestamp" },
			"botPattern": { value: variables.botDetector.sqlPattern(), cfsqltype: "cf_sql_varchar" },
			"selfHost"  : { value: "%" & variables.siteHost & "%", cfsqltype: "cf_sql_varchar" }
		};

		queryExecute(
			"INSERT INTO RequestLogDaily ( log_date, kind, name, hits )
			SELECT :logDate, 'referrer', t.name, COUNT(*)
			FROM (
				SELECT LEFT(" & _referrerHostExpr() & ", 500) AS name
				FROM RequestLog
				WHERE " & _visitorFilter() & "
			) t
			WHERE t.name NOT LIKE :selfHost
			GROUP BY t.name
			ON DUPLICATE KEY UPDATE hits = VALUES(hits)",
			params
		);

		queryExecute(
			"INSERT INTO RequestLogDaily ( log_date, kind, name, hits )
			SELECT :logDate, '404', t.name, COUNT(*)
			FROM (
				SELECT LEFT(path, 500) AS name
				FROM RequestLog
				WHERE " & _visitorFilter() & "
					AND status_code = 404
			) t
			GROUP BY t.name
			ON DUPLICATE KEY UPDATE hits = VALUES(hits)",
			params
		);

		queryExecute(
			"INSERT INTO RequestLogDaily ( log_date, kind, name, hits )
			SELECT :logDate, 'pageviews', '', COUNT(*)
			FROM RequestLog
			WHERE " & _visitorFilter() & "
				AND " & _pageViewFilter() & "
			ON DUPLICATE KEY UPDATE hits = VALUES(hits)",
			params
		);
	}

	// Visitor traffic within [:rangeStart, :rangeEnd): GET requests only,
	// excluding /manage/* (CMS admin), /assets/* (static files), /health
	// (infra probe) and bots. is_bot is set by RequestLogger as rows are
	// written; rows logged before that column existed fall back to the old
	// check (an empty user agent, or one matching :botPattern). That fallback
	// only ever runs while summarizing a day, or over today's rows.
	private function _visitorFilter(){
		return "
			requested_at >= :rangeStart
			AND requested_at < :rangeEnd
			AND method = 'GET'
			AND path NOT LIKE '/manage%'
			AND path NOT LIKE '/assets/%'
			AND path <> '/health'
			AND COALESCE( is_bot, user_agent = '' OR user_agent REGEXP :botPattern ) = 0
		";
	}

	// The referring host ('' for a direct visit): RequestLogger's
	// referrer_host, or the same thing parsed out of the raw Referer header
	// for rows logged before that column existed.
	private function _referrerHostExpr(){
		return "COALESCE( referrer_host, CASE WHEN referrer = '' THEN ''
			ELSE LOWER( SUBSTRING_INDEX( SUBSTRING_INDEX( SUBSTRING_INDEX( SUBSTRING_INDEX( referrer, '://', -1 ), '/', 1 ), '?', 1 ), ':', 1 ) ) END )";
	}

	// False for the paths vulnerability scanners try on every site: dotfiles
	// such as /.env and /.git/config (but not /.well-known/), WordPress and
	// phpMyAdmin locations, and script, config and archive files this site
	// has never served. They arrive with browser-like user agents, so the bot
	// filter doesn't catch them.
	private function _notAProbe( required string column ){
		var name = arguments.column;
		return "NOT (
			( " & name & " REGEXP '/[.]' AND " & name & " NOT LIKE '/.well-known/%' )
			OR " & name & " REGEXP '(^|/)(wp|wordpress|wp-[a-z]+|phpmyadmin|pma|cgi-bin|vendor|administrator)(/|$)'
			OR " & name & " REGEXP '[.](php[0-9]?|aspx?|jsp|cgi|sql|bak|old|zip|tar|gz|tgz|rar|7z|ya?ml|ini|conf|config|log|pem|key|env)$'
		)";
	}

	// A page view: a page a reader can open, answered with a 200. Listed by
	// route rather than by what to leave out, because the log also holds
	// feeds, the sitemap, fediverse endpoints and hashed asset files (whose
	// /assets/dist prefix is gone by the time they're logged). The extension
	// check drops the files the static games under /games/ load. A NULL
	// status is a row logged before status codes were captured.
	private function _pageViewFilter(){
		return "
			( status_code IS NULL OR status_code = 200 )
			AND (
				path IN ( '/', '/about', '/posts', '/projects', '/search', '/games', '/games/', '/privacy', '/terms' )
				OR path LIKE '/posts/%'
				OR path LIKE '/tag/%'
				OR path LIKE '/projects/%'
				OR path LIKE '/games/%'
			)
			AND path NOT REGEXP '[.](js|mjs|css|map|json|xml|txt|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|wasm|mp3|ogg|wav)$'
		";
	}

	// Params for a read over the last `daysBack` completed days (from
	// RequestLogDaily) plus today (raw RequestLog rows).
	private function _windowParams( required numeric daysBack ){
		var todayMidnight = _todayMidnight();
		return {
			"fromDate"  : { value: dateAdd( "d", -arguments.daysBack, todayMidnight ), cfsqltype: "cf_sql_date" },
			"todayDate" : { value: todayMidnight, cfsqltype: "cf_sql_date" },
			"rangeStart": { value: todayMidnight, cfsqltype: "cf_sql_timestamp" },
			"rangeEnd"  : { value: dateAdd( "d", 1, todayMidnight ), cfsqltype: "cf_sql_timestamp" },
			"botPattern": { value: variables.botDetector.sqlPattern(), cfsqltype: "cf_sql_varchar" }
		};
	}

	private function _todayMidnight(){
		return createDate( year( now() ), month( now() ), day( now() ) );
	}

}

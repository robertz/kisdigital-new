/**
 * Home page and About page.
 */
class {

	variables.postService     = "";
	variables.authorService   = "";
	variables.siteDefaults    = "";
	variables.projectRegistry = "";

	function init( required postService, required authorService, required siteDefaults ){
		variables.postService     = arguments.postService;
		variables.authorService   = arguments.authorService;
		variables.siteDefaults    = arguments.siteDefaults;
		variables.projectRegistry = new models.util.ProjectRegistry();

		this.router = boxExpressRouter();

		this.router.get( "/", ( req, res ) => index( req, res ) );
		this.router.get( "/about", ( req, res ) => about( req, res ) );
		this.router.get( "/privacy", ( req, res ) => privacy( req, res ) );
		this.router.get( "/terms", ( req, res ) => terms( req, res ) );

		return this;
	}

	// route: /
	// Each post appears on the home page at most once: the lead and the
	// latest grid are settled first, then every later row is asked to skip
	// what's already shown.
	function index( req, res ){
		var featuredPost   = variables.postService.getFeaturedPost();
		var leadIsFeatured = featuredPost.exists();
		var gridPosts      = variables.postService.getLatestPosts( 5 );
		var leadPost       = leadIsFeatured ? featuredPost : ( gridPosts.len() ? gridPosts.shift() : "" );
		if ( gridPosts.len() > 4 ) gridPosts = gridPosts.slice( 1, 4 );

		var shownIds = gridPosts.map( ( post ) => post.getId() );
		if ( isObject( leadPost ) ) shownIds.prepend( leadPost.getId() );

		var mostReadPosts = variables.postService.getMostReadPosts( 4, shownIds );
		shownIds.append( mostReadPosts.map( ( post ) => post.getId() ), true );

		res.render( "main/index", {
			pageTitle      : "",
			canonicalUrl   : variables.siteDefaults.canonicalUrl( req.path ),
			meta           : variables.siteDefaults.defaultMeta( req.path ),
			leadPost       : leadPost,
			leadIsFeatured : leadIsFeatured,
			gridPosts      : gridPosts,
			mostReadPosts  : mostReadPosts,
			projects       : variables.projectRegistry.getProjects().slice( 1, 4 ),
			archivePosts   : variables.postService.getArchivePosts( 4, shownIds ),
			allTags        : variables.postService.getAllTags()
		} );
	}

	// route: /about
	function about( req, res ){
		res.render( "main/about", {
			pageTitle    : "About",
			canonicalUrl : variables.siteDefaults.canonicalUrl( req.path ),
			meta         : variables.siteDefaults.defaultMeta( req.path ),
			author       : variables.authorService.getFirstAuthor(),
			latestPosts  : variables.postService.getLatestPosts()
		} );
	}

	// route: /privacy
	function privacy( req, res ){
		res.render( "main/privacy", {
			pageTitle    : "Privacy Policy",
			canonicalUrl : variables.siteDefaults.canonicalUrl( req.path ),
			meta         : variables.siteDefaults.defaultMeta( req.path )
		} );
	}

	// route: /terms
	function terms( req, res ){
		res.render( "main/terms", {
			pageTitle    : "Terms of Service",
			canonicalUrl : variables.siteDefaults.canonicalUrl( req.path ),
			meta         : variables.siteDefaults.defaultMeta( req.path )
		} );
	}

}

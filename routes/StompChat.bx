/**
 * /games/stomp-chat — a multi-channel chat over boxlang-express's STOMP
 * pub/sub layer (boxExpressStomp()), gated behind the site's own login —
 * deliberately separate from routes/Chat.bx's anonymous raw-app.ws() demo,
 * both to keep that one's "no auth at all" story intact and to show the
 * other end of the spectrum: every CONNECT/SUBSCRIBE/SEND on this socket
 * re-checks a real site session, not just the page load.
 *
 * Needs both an HTTP route (the gated page, plus an admin-only channel-
 * creation POST) and a direct app.ws() registration (STOMP's handler()),
 * so — like routes/Chat.bx — this class takes `app` rather than exposing
 * only a `.router`; app.bxs still mounts `.router` via app.use() for the
 * HTTP side.
 *
 * Session lookup: app.ws() connections bypass the whole use() middleware
 * chain (see boxlang-express's WebSockets doc), so there's no req.session
 * on a WS connection — session identity is resolved by hand instead, by
 * reading the same "connect.sid" cookie boxExpressSession() sets
 * (app.bxs) off connection.cookies (boxlang-express's WebSocketConnection
 * exposes the handshake's headers/cookies precisely for this) and looking
 * it up in the same sessionCache the app's own session middleware reads
 * from — same store, same cookie, two different code paths into it.
 *
 * Trust boundary: authenticate()/authorize() gate whether a connection can
 * CONNECT/SUBSCRIBE/SEND at all — a logged-out visitor's socket never gets
 * that far. What they don't do is stamp a SEND's body server-side:
 * boxExpressStomp() forwards a SEND frame's body to subscribers verbatim,
 * with no hook to rewrite it, so the "from" name in a message is supplied
 * by the client (from its own real display name, known because the
 * gated page above only ever renders for a session that has one) rather
 * than stamped by the broker per message. A logged-out visitor cannot
 * open this socket at all; a logged-in one could still type a different
 * display string into their own outgoing message, the same trust
 * boundary as any authenticated form's freeform text field, not a
 * broker-enforced identity claim.
 *
 * Channels: variables.channels is a plain in-memory array — not
 * persisted, cleared on the next deploy, same trade-off as every other
 * demo under /games. Only an admin (req.session.manage_user.role ==
 * "admin") can create one, via POST /games/stomp-chat/channels — CSRF-
 * protected automatically (routes/Manage.bx mounts boxExpressCsrf() with
 * no path prefix, so it already covers this route; req.csrfToken() just
 * works here the same as it does on any /manage form).
 *
 * A connection only ever occupies one channel at a time, but can switch
 * without closing the socket: a real STOMP UNSUBSCRIBE for the channel
 * subscription, followed by a SUBSCRIBE to the new one, both over the
 * same connection. boxExpressStomp() gives authorize() a hook for
 * SUBSCRIBE and SEND but none for UNSUBSCRIBE — however, reading
 * Stomp.bx directly shows its own _handleUnsubscribe already tears down
 * its internal subscribersByDestination entry on UNSUBSCRIBE with no app
 * hook needed at all; the missing hook only ever meant "the app can't
 * find out a leave happened," not "the framework doesn't support it."
 * interceptFrame() below (the same raw-frame interception stampSend()
 * already needed for identity/history) watches for an UNSUBSCRIBE on the
 * channel subscription id and runs onLeave() itself before forwarding
 * the frame to Stomp unchanged — the old channel's presence cleanup runs
 * from that, the new channel's presence add runs through the normal
 * SUBSCRIBE/authorize() path exactly as it already did, and the raw
 * UNSUBSCRIBE still reaches Stomp's own handler so its registry stays
 * correct too.
 *
 * Presence: boxExpressStomp() has no concept of this itself (see the
 * WebSockets doc's "What this isn't") — it's tracked entirely in this
 * class, per channel, in variables.presence (connId -> {channel,
 * displayName}), added to on a successful SUBSCRIBE (inside authorize(),
 * the one point that already knows both "this connection is joining a
 * channel" and who they are) and removed on disconnect. The disconnect
 * half needs a small trick: WebSocketConnection.onClose() only holds a
 * single callback slot (plain assignment, not a list), and Stomp.bx's
 * own handler() already claims it for subscription cleanup — calling
 * onClose() again ourselves would silently overwrite that and leak
 * Stomp's internal subscriber registry. onConnect() below hands Stomp a
 * thin wrapper connection instead of the real one, whose onClose()
 * appends to a local array instead of overwriting — both Stomp's cleanup
 * and this class's presence removal actually run.
 *
 * Message history: same trade-off as presence — a channel's history
 * lives only in variables.history (channel -> last MAX_HISTORY {from,
 * text} entries) and starts empty on every deploy. boxExpressStomp()
 * relays a SEND's body to subscribers but gives authorize() no view of
 * that body at all (only destination/access/connection), so recording
 * history can't happen from authorize() the way joining presence does —
 * it has to come from actually looking at each raw frame. onConnect()'s
 * wrapper intercepts every incoming frame before handing it to Stomp,
 * parses it with boxlang-express's own StompFrameCodec (reused directly
 * rather than hand-rolling frame parsing a second time), and records
 * only SEND frames addressed to a real channel — then forwards the
 * original, unmodified frame to Stomp's handler exactly as it arrived.
 * A newly-subscribed connection gets the channel's history unicast
 * directly (StompFrameCodec.serialize() + connection.send(), a properly
 * framed MESSAGE the client's parser recognizes) — a plain broadcast
 * would hit the same "not registered yet" race presence's join broadcast
 * has, but unicast doesn't go through Stomp's subscriber registry at
 * all, so there's nothing to race here.
 *
 * Direct messages: every connection subscribes to exactly one personal
 * inbox for its whole lifetime — DM_PREFIX & <own userId> — alongside
 * its one channel subscription, the moment CONNECT succeeds (no
 * UNSUBSCRIBE problem here at all, since a connection never needs to
 * leave its own inbox). Sending a DM is a SEND straight to the
 * *recipient's* inbox destination; authorize() is the real security
 * boundary here (not cosmetic like the channel-name check) — a
 * connection may only SUBSCRIBE to its own inbox (dmTargetId == myId),
 * but may SEND to anyone's, since the recipient's own subscribe-gating
 * is what actually keeps a DM private. The sender never receives their
 * own SEND back (they're not subscribed to the recipient's inbox, only
 * their own), so the client echoes its own outgoing DM locally rather
 * than waiting on a round trip — same reasoning as any optimistic-send
 * UI. No server-side DM history at all (a real scope cut, not an
 * oversight): unlike channel history, a DM thread only lives in the
 * browser tab that was open for it, gone on reload — extending
 * variables.history's per-channel design to per-conversation is the
 * obvious next step if that's ever worth it.
 *
 * Identity stamping: the module comment above used to say boxExpressStomp()
 * "forwards a SEND frame's body to subscribers verbatim, with no hook to
 * rewrite it" — true of the framework itself, but this class already
 * intercepts every raw frame for history recording (see onConnect()), and
 * that's exactly the hook needed. stampSend() parses each SEND, discards
 * whatever "from"/"fromId" the client included entirely, replaces them
 * with the session-resolved identity, and re-serializes before forwarding
 * to Stomp's own handler — so a client can no longer put an arbitrary name
 * on its own outgoing message, in a channel or a DM. This also folds in
 * what recordIfSend() used to do standalone, since both need the same
 * parsed frame.
 *
 * System messages ("X joined #general") reuse the same channel-broadcast
 * path presence already uses, from onJoin()/onLeave() — no separate
 * mechanism.
 *
 * Channel activity: every connection also subscribes to one shared
 * ACTIVITY_DEST for its whole lifetime (same "no UNSUBSCRIBE needed"
 * reasoning as the DM inbox). A client can never SEND to it — authorize()
 * refuses publish access outright — only stampSend() publishes to it
 * server-side, once per recorded channel message, naming which channel
 * just got activity (never the message content). The client uses this to
 * badge channels in the sidebar it isn't currently subscribed to; a
 * connection only ever holds one channel subscription at a time, so this
 * is the only way it can find out another channel had traffic at all.
 */
class {

	variables.app             = "";
	variables.siteDefaults    = "";
	variables.sessionStore    = "";
	variables.stomp           = "";
	variables.frameCodec      = "";
	variables.channels        = [ "general" ];
	variables.channelsLock    = "stomp-chat-channels";
	variables.presence        = {};
	variables.presenceLock    = "stomp-chat-presence";
	variables.history         = {};
	variables.historyLock     = "stomp-chat-history";
	variables.MAX_HISTORY     = 50;
	variables.DEST_PREFIX     = "/topic/stomp-chat/";
	variables.DM_PREFIX       = "/queue/stomp-chat/dm/";
	variables.ACTIVITY_DEST   = "/topic/stomp-chat-activity";
	variables.MAX_CHANNEL_LEN = 30;
	variables.CHANNEL_SUB_ID  = "sub-0"; // must match the client's hardcoded subscribe id — see interceptFrame()

	function init( required app, required siteDefaults ){
		variables.app          = arguments.app;
		variables.siteDefaults = arguments.siteDefaults;
		variables.sessionStore = boxExpressCacheStore( "sessionCache" );
		variables.frameCodec   = new bxModules.boxexpress.models.StompFrameCodec();

		this.router = boxExpressRouter();
		this.router.get( "/games/stomp-chat", ( req, res, next ) => page( req, res, next ) );
		this.router.post( "/games/stomp-chat/channels", ( req, res, next ) => createChannel( req, res, next ) );

		variables.stomp = boxExpressStomp( {
			authenticate: ( login, passcode, host, connection ) => authenticate( connection ),
			authorize   : ( login, destination, access, connection ) => authorize( destination, access, connection )
		} );

		variables.app.ws( "/games/stomp-chat/socket", ( connection ) => onConnect( connection ) );

		return this;
	}

	// Wraps the real connection so this class can add its own onClose
	// callback (presence removal) alongside Stomp's own (subscription
	// cleanup) instead of one overwriting the other — see class docblock.
	// Every other member just delegates straight through to the real
	// connection; only onClose's behavior actually differs.
	function onConnect( connection ){
		var connId         = createUUID();
		var closeCallbacks = [];
		var messageCallback = javacast( "null", "" );

		var wrapped = {
			connId    : connId,
			cookies   : connection.cookies,
			headers   : connection.headers,
			get       : ( name ) => connection.get( name ),
			onMessage : ( cb ) => messageCallback = cb,
			onClose   : ( cb ) => closeCallbacks.append( cb ),
			send      : ( data ) => connection.send( data ),
			close     : () => connection.close(),
			isClosed  : () => connection.isClosed()
		};

		// Stamps identity onto (and records history from) every raw SEND,
		// and runs channel-leave cleanup on the channel UNSUBSCRIBE — see
		// interceptFrame() — before forwarding to whatever Stomp's own
		// handler() registers via wrapped.onMessage() above.
		connection.onMessage( ( raw ) => {
			var toForward = interceptFrame( raw, connection, connId );
			if ( !isNull( messageCallback ) ){
				messageCallback( toForward );
			}
		} );

		connection.onClose( ( code, reason ) => {
			for ( var cb in closeCallbacks ){
				cb( code, reason );
			}
		} );

		wrapped.onClose( ( code, reason ) => onLeave( connId ) );

		variables.stomp.handler()( wrapped );
	}

	// Parses one raw WS frame once, before Stomp ever sees it, and branches
	// on command:
	//   UNSUBSCRIBE, id == CHANNEL_SUB_ID — this connection is leaving its
	//     current channel (either a same-socket channel switch or a client
	//     tearing down before close). Runs onLeave() for presence cleanup
	//     immediately, then forwards the frame unchanged — Stomp.bx's own
	//     _handleUnsubscribe still needs to see it to clear its internal
	//     subscribersByDestination entry (confirmed by reading
	//     models/middleware/Stomp.bx directly: it already handles this with
	//     no app hook required).
	//   SEND — handed to stampSend() for identity stamping/history (see its
	//     docblock).
	//   anything else — passed through completely unchanged.
	function interceptFrame( raw, connection, connId ){
		var frame = "";
		try {
			frame = variables.frameCodec.parse( raw );
		} catch ( any e ){
			return raw;
		}

		if ( frame.getCommand() == "UNSUBSCRIBE" && frame.getHeader( "id", "" ) == variables.CHANNEL_SUB_ID ){
			onLeave( connId );
			return raw;
		}

		if ( frame.getCommand() != "SEND" ){
			return raw;
		}

		return stampSend( raw, frame, connection );
	}

	// Discards whatever "from"/"fromId" the client sent on a SEND (if
	// anything — a typing ping sends neither) and replaces both with the
	// session-resolved identity, then re-serializes and returns the
	// stamped frame text. Not a JSON body, or no resolvable identity, and
	// the original raw frame passes through unchanged — this only ever
	// narrows what a client can claim about itself, never rewrites
	// anything else about the frame. Also where a channel SEND gets
	// recorded into history and a channel activity ping goes out (see
	// recordIfMessage()) — both need the same parsed frame interceptFrame()
	// already has, so it happens here instead of a second separate parse.
	function stampSend( raw, frame, connection ){
		var sessionData = sessionFor( connection );
		var displayName = displayNameFor( sessionData );
		if ( !len( displayName ) ){
			return raw; // let authorize() reject it normally; nothing to stamp
		}

		var parsed = "";
		try {
			parsed = JSONDeserialize( frame.getBody() );
		} catch ( any e ){
			return raw; // not one of our JSON message shapes — pass through
		}
		if ( !isStruct( parsed ) ){
			return raw;
		}

		parsed.from   = displayName;
		parsed.fromId = userIdFor( sessionData );

		recordIfMessage( frame.getHeader( "destination", "" ), parsed );

		var stamped = new bxModules.boxexpress.models.StompFrame( "SEND", frame.getHeaders(), JSONSerialize( parsed ) );
		return variables.frameCodec.serialize( stamped );
	}

	// If destination is a real channel and parsed looks like a chat
	// message (has non-empty text — a typing ping doesn't), appends
	// {from, text} to that channel's history (capped at MAX_HISTORY) and
	// broadcasts a channel-activity ping naming the channel (never the
	// message itself) to ACTIVITY_DEST. Anything else is a silent no-op.
	function recordIfMessage( destination, parsed ){
		var channel = _channelFromDestination( destination );
		if ( !len( channel ) || !len( trim( parsed.text ?: "" ) ) ){
			return;
		}
		var entry = { from: parsed.from ?: "", text: parsed.text };
		lock name="#variables.historyLock#" type="exclusive" timeout="5" {
			if ( !structKeyExists( variables.history, channel ) ){
				variables.history[ channel ] = [];
			}
			variables.history[ channel ].append( entry );
			if ( variables.history[ channel ].len() > variables.MAX_HISTORY ){
				variables.history[ channel ].deleteAt( 1 );
			}
		}
		variables.stomp.send( variables.ACTIVITY_DEST, { type: "activity", channel: channel } );
	}

	// Unicasts the channel's history straight to one connection as a
	// properly-framed STOMP MESSAGE (StompFrameCodec.serialize() +
	// connection.send(), not variables.stomp.send() — a broadcast would
	// hit the same "not registered yet" ordering issue documented on
	// onJoin() below; a direct connection.send() doesn't touch Stomp's
	// subscriber registry at all, so there's nothing to race here).
	function sendHistory( connection, channel ){
		var messages = [];
		lock name="#variables.historyLock#" type="readonly" timeout="5" {
			if ( structKeyExists( variables.history, channel ) ){
				messages = duplicate( variables.history[ channel ] );
			}
		}
		var body  = JSONSerialize( { type: "history", messages: messages } );
		var frame = new bxModules.boxexpress.models.StompFrame( "MESSAGE", {
			destination    : variables.DEST_PREFIX & channel,
			"message-id"   : createUUID(),
			subscription   : variables.CHANNEL_SUB_ID,
			"content-type" : "application/json"
		}, body );
		connection.send( variables.frameCodec.serialize( frame ) );
	}

	// GET /games/stomp-chat?channel=... — same "sign in with Google, then
	// come back here" pattern routes/Manage.bx uses for /manage, but via
	// the general-purpose /auth/google (routes/Auth.bx) rather than the
	// CMS-only login, since any signed-in visitor should see this, not
	// just staff.
	//
	// "Signed in" means either req.session.commenter (a regular visitor)
	// OR req.session.manage_user (staff — an admin/author's Google account
	// gets THAT session, never commenter, per routes/Auth.bx). Checking
	// commenter alone locked staff out of their own page: an admin signing
	// in got manage_user set, still failed this check, and got bounced
	// straight back to /auth/google — which Google silently re-approves
	// for an already-consented account (prompt=none), producing a true
	// redirect loop rather than a second login prompt. Confirmed live
	// (Safari's "too many redirects" against exactly that URL) before
	// this fix.
	function page( req, res, next ){
		var displayName = displayNameFor( req.session );
		if ( !len( displayName ) ){
			res.redirect( "/auth/google?redirect=/games/stomp-chat" );
			return;
		}

		var channelList    = channelsSnapshot();
		var requested       = trim( req.query.channel ?: "" );
		var currentChannel  = channelList.contains( requested ) ? requested : channelList[ 1 ];

		res.render( "games/stomp-chat", {
			pageTitle      : "STOMP Chat",
			canonicalUrl   : variables.siteDefaults.canonicalUrl( req.path ),
			meta           : variables.siteDefaults.defaultMeta( req.path ),
			displayName    : displayName,
			userId         : userIdFor( req.session ),
			channels       : channelList,
			currentChannel : currentChannel,
			isAdmin        : isAdminSession( req.session ),
			csrfToken      : req.csrfToken()
		} );
	}

	// POST /games/stomp-chat/channels — admin-only. CSRF is already
	// enforced site-wide (see class docblock), so no separate check here.
	function createChannel( req, res, next ){
		if ( !isAdminSession( req.session ) ){
			res.status( 403 ).json( { success: false, error: "Admins only." } );
			return;
		}

		var name = _normalizeChannelName( req.body.name ?: "" );
		if ( !len( name ) ){
			res.status( 400 ).json( { success: false, error: "Invalid channel name." } );
			return;
		}

		lock name="#variables.channelsLock#" type="exclusive" timeout="5" {
			if ( variables.channels.contains( name ) ){
				res.status( 409 ).json( { success: false, error: "That channel already exists." } );
				return;
			}
			variables.channels.append( name );
		}

		res.json( { success: true, channel: name, channels: channelsSnapshot() } );
	}

	// Lowercase, dash-joined, alphanumeric-only, length-capped — "" if
	// nothing usable survives. Deliberately restrictive rather than
	// merely-safe: this name becomes part of a STOMP destination string
	// (variables.DEST_PREFIX & name), so it stays out of any character
	// class STOMP's own header escaping would otherwise have to think
	// about at all.
	private function _normalizeChannelName( raw ){
		var name = lCase( trim( raw ) );
		name = reReplace( name, "[^a-z0-9]+", "-", "all" );
		name = reReplace( name, "^-+|-+$", "", "all" );
		if ( !len( name ) ){
			return "";
		}
		return left( name, variables.MAX_CHANNEL_LEN );
	}

	function channelsSnapshot(){
		lock name="#variables.channelsLock#" type="readonly" timeout="5" {
			return duplicate( variables.channels );
		}
	}

	function isAdminSession( sessionData ){
		return !isNull( sessionData ) && isStruct( sessionData.manage_user ?: "" ) && ( sessionData.manage_user.role ?: "" ) == "admin";
	}

	// The display name off whichever of the two independent session
	// populations is present — "" if neither is. Shared by page() (a real
	// req.session) and authenticate()/authorize() below (a session struct
	// read back from sessionCache, same shape).
	function displayNameFor( sessionData ){
		if ( isNull( sessionData ) ){
			return "";
		}
		if ( isStruct( sessionData.commenter ?: "" ) && len( sessionData.commenter.id ?: "" ) ){
			return sessionData.commenter.display_name;
		}
		if ( isStruct( sessionData.manage_user ?: "" ) && len( sessionData.manage_user.id ?: "" ) ){
			return sessionData.manage_user.display_name;
		}
		return "";
	}

	// A stable id for DM destinations and presence, prefixed by which
	// session population it came from — commenter.id and manage_user.id
	// are separate tables (see routes/Auth.bx), so this is cheap insurance
	// against a theoretical id collision between the two rather than a
	// real observed problem (both are UUID primary keys in practice).
	function userIdFor( sessionData ){
		if ( isNull( sessionData ) ){
			return "";
		}
		if ( isStruct( sessionData.commenter ?: "" ) && len( sessionData.commenter.id ?: "" ) ){
			return "c-" & sessionData.commenter.id;
		}
		if ( isStruct( sessionData.manage_user ?: "" ) && len( sessionData.manage_user.id ?: "" ) ){
			return "m-" & sessionData.manage_user.id;
		}
		return "";
	}

	// Resolves the site session (or null) for a WebSocket connection from
	// its handshake cookies — the same "connect.sid" -> sessionCache
	// lookup boxExpressSession()'s own middleware does internally, just
	// invoked by hand since app.ws() never runs that middleware.
	function sessionFor( connection ){
		var sessionId = connection.cookies[ "connect.sid" ] ?: "";
		if ( !len( sessionId ) ){
			return javacast( "null", "" );
		}
		return variables.sessionStore.get( sessionId );
	}

	// STOMP CONNECT — login/passcode/host are ignored entirely; a browser
	// connecting to this same-origin socket already carries the real
	// session cookie automatically, so that's the only credential that
	// matters here.
	function authenticate( connection ){
		return len( displayNameFor( sessionFor( connection ) ) ) > 0;
	}

	// STOMP SUBSCRIBE/SEND — re-checked per action (not just once at
	// CONNECT), so a session that gets destroyed mid-connection (an
	// explicit sign-out in another tab) stops working on this one's very
	// next action rather than staying live until reconnect.
	//
	// Three destination shapes are accepted:
	//   variables.ACTIVITY_DEST              — shared channel-activity
	//     feed. Any authenticated connection may SUBSCRIBE (everyone gets
	//     it automatically on CONNECT); publish is refused outright — only
	//     stampSend() ever sends to it, server-side, so a client SEND here
	//     is always someone bypassing the client and is never legitimate.
	//   variables.DM_PREFIX & <userId>       — a personal DM inbox. Only
	//     that user may SUBSCRIBE to it (the real privacy boundary for
	//     DMs — see class docblock); any authenticated user may SEND to
	//     it, which is exactly how a DM gets delivered to someone else.
	//   variables.DEST_PREFIX & <channel>    — must be a channel
	//     currently in variables.channels; anything else is refused
	//     outright. A successful SUBSCRIBE also joins presence here — the
	//     one point that already has both "this connection is entering
	//     channel X" and a resolved identity for it. SEND doesn't touch
	//     presence at all; a connection can only join once, on its one
	//     channel SUBSCRIBE, not once per message.
	function authorize( destination, access, connection ){
		var sessionData = sessionFor( connection );
		var displayName = displayNameFor( sessionData );
		if ( !len( displayName ) ){
			return false;
		}

		if ( destination == variables.ACTIVITY_DEST ){
			return access == "subscribe";
		}

		var dmTargetId = _dmUserIdFromDestination( destination );
		if ( len( dmTargetId ) ){
			if ( access == "subscribe" ){
				return dmTargetId == userIdFor( sessionData );
			}
			return true; // publish: sending a DM to anyone is allowed
		}

		var channel = _channelFromDestination( destination );
		if ( !len( channel ) ){
			return false;
		}

		if ( access == "subscribe" ){
			sendHistory( connection, channel );
			onJoin( connection.connId, channel, userIdFor( sessionData ), displayName );
		}

		return true;
	}

	function _dmUserIdFromDestination( destination ){
		var prefixLen = len( variables.DM_PREFIX );
		if ( len( destination ) <= prefixLen ){
			return "";
		}
		if ( left( destination, prefixLen ) != variables.DM_PREFIX ){
			return "";
		}
		return mid( destination, prefixLen + 1, len( destination ) - prefixLen );
	}

	// mid()'s count computed exactly (not just "the rest of the string"),
	// and a length check before any left()/mid() call at all — both
	// following the same left()/right()/mid() zero-count landmine already
	// documented in boxlang-express's own StompFrameCodec.bx.
	function _channelFromDestination( destination ){
		var prefixLen = len( variables.DEST_PREFIX );
		if ( len( destination ) <= prefixLen ){
			return "";
		}
		if ( left( destination, prefixLen ) != variables.DEST_PREFIX ){
			return "";
		}
		var channel = mid( destination, prefixLen + 1, len( destination ) - prefixLen );
		return channelsSnapshot().contains( channel ) ? channel : "";
	}

	// Adds this connection to presence, then broadcasts the updated
	// roster for that channel — deferred via runAsync() rather than sent
	// inline here. authorize() runs *before* Stomp.bx registers the
	// subscription (see _handleSubscribe: it calls authorizeFn(), then
	// only on a true return adds the subscriber to its own registry), so
	// a synchronous stomp.send() from inside authorize() would race that
	// registration and never reach the very connection that just joined —
	// its first roster snapshot would always be missing itself. Confirmed
	// directly: a synchronous version of this send worked for everyone
	// already in the channel but the joiner's own client never saw it.
	// runAsync() pushes the actual send onto another thread, which loses
	// that race every time against Stomp's own registration step
	// (in-memory, no I/O, completes as soon as authorize() returns)
	// immediately following.
	function onJoin( connId, channel, userId, displayName ){
		lock name="#variables.presenceLock#" type="exclusive" timeout="5" {
			variables.presence[ connId ] = { channel: channel, userId: userId, displayName: displayName };
		}
		runAsync( () => {
			variables.stomp.send( variables.DEST_PREFIX & channel, { type: "presence", members: membersInChannel( channel ) } );
			variables.stomp.send( variables.DEST_PREFIX & channel, { type: "system", text: displayName & " joined ##" & channel } );
		} );
	}

	function onLeave( connId ){
		var channel     = "";
		var displayName = "";
		lock name="#variables.presenceLock#" type="exclusive" timeout="5" {
			if ( structKeyExists( variables.presence, connId ) ){
				channel     = variables.presence[ connId ].channel;
				displayName = variables.presence[ connId ].displayName;
				structDelete( variables.presence, connId );
			}
		}
		if ( len( channel ) ){
			variables.stomp.send( variables.DEST_PREFIX & channel, { type: "presence", members: membersInChannel( channel ) } );
			variables.stomp.send( variables.DEST_PREFIX & channel, { type: "system", text: displayName & " left ##" & channel } );
		}
	}

	// {userId, displayName} per member rather than a bare name — the
	// client needs userId to address a DM at someone from the presence
	// list.
	function membersInChannel( channel ){
		var members = [];
		lock name="#variables.presenceLock#" type="readonly" timeout="5" {
			for ( var connId in variables.presence ){
				if ( variables.presence[ connId ].channel == channel ){
					members.append( { userId: variables.presence[ connId ].userId, displayName: variables.presence[ connId ].displayName } );
				}
			}
		}
		return members;
	}

}

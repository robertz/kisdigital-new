/**
 * /manage/api/system — the running server for the System page: a live
 * snapshot (raw bytes, milliseconds and 0-1 ratios; the page formats them)
 * and ServerHistory's hourly records for the trend charts.
 */
class {

	variables.serverMonitor = "";
	variables.serverHistory = "";

	function init( required serverMonitor, required serverHistory ){
		variables.serverMonitor = arguments.serverMonitor;
		variables.serverHistory = arguments.serverHistory;
		return this;
	}

	function register( required router, required auth, required admin ){
		arguments.router.get( "/manage/api/system", arguments.admin, ( req, res ) => systemSnapshot( req, res ) );
	}

	// GET /manage/api/system?hours=48 — polled by the page every 30 seconds.
	function systemSnapshot( req, res ){
		try {
			var hours    = isNumeric( req.query.hours ?: "" ) ? int( req.query.hours ) : 48;
			var snapshot = variables.serverMonitor.getSnapshot( true );
			var gcTimeMs = 0;
			for ( var collector in snapshot.gc ){
				gcTimeMs += collector.collectionTime;
			}
			snapshot[ "gcHealth" ] = _gcHealth( gcTimeMs, snapshot.jvm.uptimeMs );
			res.json( { "server": snapshot, "history": variables.serverHistory.recent( hours ) } );
		} catch ( any e ) {
			println( "[error] Server metrics fetch failed: " & e.message );
			res.status( 502 ).json( { "error": "Couldn't read server metrics." } );
		}
	}

	// Total GC pause time as a share of process uptime is a much steadier
	// health signal than any single collection count/time — a JVM that's
	// spent 15% of its life paused in GC is in trouble even if the heap bar
	// itself looks fine at the moment of the snapshot. Thresholds mirror the
	// standard GC-overhead rules of thumb: <1% healthy, 1-5% worth watching,
	// 5-10% worth investigating, >10% an active problem.
	private function _gcHealth( required numeric totalGcTimeMs, required numeric uptimeMs ){
		var ratio      = arguments.uptimeMs > 0 ? ( arguments.totalGcTimeMs / arguments.uptimeMs * 100 ) : 0;
		var status     = "healthy";
		var label      = "Healthy";

		if ( ratio > 10 ){
			status = "problem";
			label = "Problem";
		} else if ( ratio > 5 ){
			status = "investigate";
			label = "Investigate";
		} else if ( ratio > 1 ){
			status = "watch";
			label = "Watch";
		}

		return {
			"ratio"       : ratio / 100,
			"status"      : status,
			"label"       : label
		};
	}

}

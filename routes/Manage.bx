/**
 * /manage — CMS admin area: auth, dashboard, posts/authors CRUD, settings.
 *
 * cbwire's live in-page components (post list star-toggle, post/author/settings
 * editors) are rebuilt here as plain POST-and-redirect forms, per the decision
 * to drop live no-reload interactivity in the boxlang-express port. Every
 * state-changing route is protected by boxExpressCsrf() (mounted once on the
 * whole router below) — the old app relied on cbwire's own session-bound wire
 * snapshots for this, which plain forms don't get for free.
 *
 * SESSION FIXATION [H2] NOTE: the old ColdBox app called sessionInvalidate()
 * on successful login to rotate the session ID. boxlang-express's Session
 * middleware has no equivalent hook — req.destroySession() expires the
 * *current* cookie (via a second Set-Cookie header) without the app being able
 * to seed a new ID's server-side data, so calling it here would log the user
 * right back out. Left as a known gap rather than worked around unreliably;
 * the session cookie is httpOnly with a 256-bit random ID, which limits the
 * practical exposure in the meantime.
 */
class {

	variables.authService     = "";
	variables.postService     = "";
	variables.authorService   = "";
	variables.settingsService = "";
	variables.postRenderer    = "";
	variables.r2Client        = "";
	variables.r2UploadPrefix  = "posts";
	variables.insightsService = "";
	variables.serverMonitor = "";
	variables.googleOAuthClient  = "";
	variables.commentService     = "";

	function init( required authService, required postService, required authorService, required settingsService, required postRenderer, required r2Client, r2UploadPrefix = "posts", required insightsService, required serverMonitor, required googleOAuthClient, required commentService ){
		variables.authService     = arguments.authService;
		variables.postService     = arguments.postService;
		variables.authorService   = arguments.authorService;
		variables.settingsService = arguments.settingsService;
		variables.postRenderer    = arguments.postRenderer;
		variables.r2UploadPrefix  = len( trim( arguments.r2UploadPrefix ) ) ? trim( arguments.r2UploadPrefix ).reReplace( "^/+|/+$", "", "all" ) : "posts";
		variables.r2Client        = arguments.r2Client;
		variables.insightsService = arguments.insightsService;
		variables.serverMonitor = arguments.serverMonitor;
		variables.googleOAuthClient  = arguments.googleOAuthClient;
		variables.commentService     = arguments.commentService;

		// Bare method references passed as route handlers lose their binding to
		// this instance (BoxLang's Router ends up calling them unbound), so every
		// handler and middleware below is wrapped in a closure that calls the
		// method through this lexically-captured scope instead.
		var auth  = ( req, res, next ) => requireAuth( req, res, next );
		var admin = ( req, res, next ) => requireAdmin( req, res, next );

		this.router = boxExpressRouter();
		this.router.use( boxExpressCsrf() );

		this.router.get( "/manage/login", ( req, res ) => showLogin( req, res ) );
		this.router.post( "/manage/login", boxExpressRateLimit( { windowMs: 15 * 60000, max: 5 } ), ( req, res ) => doLogin( req, res ) );
		this.router.get( "/manage/logout", ( req, res ) => logout( req, res ) );

		this.router.get( "/manage", auth, ( req, res ) => dashboard( req, res ) );
		this.router.get( "/manage/dashboard/traffic-data", auth, ( req, res ) => trafficData( req, res ) );

		this.router.get( "/manage/posts", auth, ( req, res ) => postsList( req, res ) );
		this.router.post( "/manage/posts/:id/toggle-featured", admin, ( req, res ) => toggleFeatured( req, res ) );
		this.router.get( "/manage/posts/new", auth, ( req, res ) => newPost( req, res ) );
		this.router.get( "/manage/posts/:id/edit", auth, ( req, res ) => editPost( req, res ) );
		this.router.post( "/manage/posts/save", auth, ( req, res ) => savePost( req, res ) );
		this.router.post( "/manage/posts/preview", auth, ( req, res ) => previewPost( req, res ) );
		// Both of these hand back a presigned R2 URL rather than doing the
		// upload/list themselves — see R2Client.presignPutUrl() for why. The
		// picker browses the whole bucket, same as /manage/media below (not
		// just r2UploadPrefix) — r2UploadPrefix is only where it starts.
		this.router.post( "/manage/posts/upload-url", auth, ( req, res ) => coverImageUploadUrl( req, res ) );
		this.router.get( "/manage/posts/images", auth, ( req, res ) => listCoverImagesUrl( req, res ) );
		this.router.post( "/manage/posts/create-folder", auth, ( req, res ) => postsCreateFolder( req, res ) );

		this.router.get( "/manage/authors", admin, ( req, res ) => authorsList( req, res ) );
		this.router.get( "/manage/authors/new", admin, ( req, res ) => newAuthor( req, res ) );
		this.router.get( "/manage/authors/:id/edit", auth, ( req, res ) => editAuthor( req, res ) );
		this.router.post( "/manage/authors/save", auth, ( req, res ) => saveAuthor( req, res ) );

		this.router.get( "/manage/settings", admin, ( req, res ) => settingsIndex( req, res ) );
		this.router.post( "/manage/settings/update", admin, ( req, res ) => updateSetting( req, res ) );

		// The standalone media manager page itself (browse/upload without a
		// post attached) stays admin-only, like Authors/Settings — the
		// underlying bucket access it exercises is the same as the post
		// editor's picker above, just reached through a dedicated page.
		this.router.get( "/manage/media", admin, ( req, res ) => mediaIndex( req, res ) );
		this.router.get( "/manage/media/list-url", admin, ( req, res ) => mediaListUrl( req, res ) );
		this.router.post( "/manage/media/upload-url", admin, ( req, res ) => mediaUploadUrl( req, res ) );
		this.router.post( "/manage/media/create-folder", admin, ( req, res ) => mediaCreateFolder( req, res ) );

		this.router.get( "/manage/comments", admin, ( req, res ) => commentsIndex( req, res ) );
		this.router.post( "/manage/comments/:id/delete", admin, ( req, res ) => deleteManageComment( req, res ) );

		this.router.get( "/manage/insights", admin, ( req, res ) => insightsIndex( req, res ) );
		this.router.get( "/manage/logs", admin, ( req, res ) => logsIndex( req, res ) );
		this.router.get( "/manage/server", admin, ( req, res ) => serverIndex( req, res ) );
		this.router.get( "/manage/server/data", admin, ( req, res ) => serverData( req, res ) );

		return this;
	}

	// ── Auth guards ──────────────────────────────────────────────────────────
	// Not private: passed by reference to the Router and invoked from there,
	// outside this instance's own method-call scope.

	function requireAuth( req, res, next ){
		if ( !len( req.session.manage_user ?: "" ) ){
			res.redirect( "/manage/login" );
			return;
		}
		next();
	}

	function requireAdmin( req, res, next ){
		if ( !len( req.session.manage_user ?: "" ) ){
			res.redirect( "/manage/login" );
			return;
		}
		if ( req.session.manage_user.role != "admin" ){
			res.redirect( "/manage" );
			return;
		}
		next();
	}

	// ── Flash messages (session-backed, survive one redirect) ─────────────────

	private function flashSet( req, required struct data ){
		req.session._flash = arguments.data;
	}

	private function flashConsume( req ){
		var f = req.session._flash ?: {};
		structDelete( req.session, "_flash" );
		return f;
	}

	// True for fetch()-driven submits (see the JS in the relevant view templates)
	// — those still use the same routes as the plain-form fallback, just ask for
	// JSON back instead of a redirect/full-page render.
	private function isAjax( req ){
		return ( req.headers[ "X-Requested-With" ] ?: "" ) == "XMLHttpRequest";
	}

	// ── Login / logout ──────────────────────────────────────────────────────

	// GET /manage/login
	function showLogin( req, res ){
		if ( len( req.session.manage_user ?: "" ) ){
			res.redirect( "/manage" );
			return;
		}

		var flash = flashConsume( req );

		res.render( "manage/login", {
			pageTitle          : "Sign In",
			error              : flash.loginError ?: "",
			csrfToken          : req.csrfToken(),
			googleSignInEnabled: variables.googleOAuthClient.isConfigured()
		} );
	}

	// POST /manage/login
	//
	// Two independent brute-force defenses stack here: the router
	// registration below wraps this in boxExpressRateLimit( { windowMs: 15min,
	// max: 5 } ), which throttles by req.ip — cheap, catches a scripted flood
	// fast, but only protects per source IP, so a botnet rotating IPs sails
	// straight through it against one target account. _isLoginRateLimited()
	// below closes that gap with a *per-account* lockout, independent of
	// where the requests come from — the two combined mean neither "many
	// guesses against one account" nor "one IP guessing many accounts" gets
	// unlimited tries.
	function doLogin( req, res ){
		var userEmail    = trim( req.body.email    ?: "" );
		var userPassword = trim( req.body.password ?: "" );
		var accountKey   = "login-attempts:" & lCase( userEmail );

		if ( !len( userEmail ) || !len( userPassword ) ){
			flashSet( req, { loginError: "Please enter your email and password." } );
			res.redirect( "/manage/login" );
			return;
		}

		// [L2] Email format validation.
		if ( !isValid( "email", userEmail ) ){
			flashSet( req, { loginError: "Please enter a valid email address." } );
			res.redirect( "/manage/login" );
			return;
		}

		if ( _isLoginRateLimited( accountKey ) ){
			println( "[auth] rate-limited login attempt for '" & userEmail & "' from " & req.ip );
			flashSet( req, { loginError: "Too many failed attempts for this account. Try again in a few minutes." } );
			res.redirect( "/manage/login" );
			return;
		}

		var user = variables.authService.authenticate( userEmail, userPassword );

		// Practically unreachable for a role='commenter' row — see
		// AuthService.findOrCreateGoogleUser()'s own note on why its
		// password can never actually verify — but kept as a real check
		// rather than relying on that alone, same instinct as
		// authenticate()'s constant-time-ish dummy-hash comparison: don't
		// let a second layer's correctness depend entirely on a first
		// layer never changing.
		if ( user.isEmpty() || ( user.role != "admin" && user.role != "author" ) ){
			_recordFailedLogin( accountKey );
			println( "[auth] failed login attempt for '" & userEmail & "' from " & req.ip );
			flashSet( req, { loginError: "Invalid email or password." } );
			res.redirect( "/manage/login" );
			return;
		}

		_clearLoginAttempts( accountKey );

		req.session.manage_user = {
			"id"           : user.id,
			"display_name" : user.display_name,
			"email"        : user.email,
			"role"         : user.role
		};

		println( "[auth] successful login for '" & userEmail & "' from " & req.ip );
		res.redirect( "/manage" );
	}

	// Fixed-window counter in the same "default" cache other services here
	// already use (SettingsService, GoatCounterClient's successor) — get/set
	// isn't atomic, so two requests racing at the exact same instant could
	// both read the same pre-increment count, same trade-off boxlang-express's
	// own RateLimit.bx makes with its in-memory map. Acceptable here: worst
	// case an attacker gets one or two extra guesses in that race, not an
	// unlimited bypass.
	private function _isLoginRateLimited( required string key, numeric maxAttempts = 5 ){
		var count = cache( "default" ).get( arguments.key );
		return count.isPresent() && count.get() >= arguments.maxAttempts;
	}

	private function _recordFailedLogin( required string key, numeric windowSeconds = 900 ){
		var count = cache( "default" ).get( arguments.key );
		var current = count.isPresent() ? count.get() : 0;
		cache( "default" ).set( arguments.key, current + 1, arguments.windowSeconds );
	}

	private function _clearLoginAttempts( required string key ){
		cache( "default" ).clear( arguments.key );
	}

	// GET /manage/logout
	function logout( req, res ){
		req.destroySession();
		res.redirect( "/manage/login" );
	}

	// ── Dashboard ────────────────────────────────────────────────────────────

	// GET /manage
	function dashboard( req, res ){
		var serverSnapshot = serverFetch( () => variables.serverMonitor.getSnapshot() );

		res.render( "manage/index", {
			pageTitle       : "Dashboard",
			manageSection   : "dashboard",
			manageUser      : req.session.manage_user,
			zeroResultSearches : variables.postService.getZeroResultSearches( 30 ),
			recentActivity     : variables.postService.getRecentActivity( 8 ),
			contentHealth      : variables.postService.getContentHealth(),
			insightsTotal      : insightsFetch( () => variables.insightsService.getTotal( 30 ) ),
			server             : isNull( serverSnapshot ) ? javacast( "null", "" ) : _formatServerSnapshot( serverSnapshot )
		} );
	}

	// GET /manage/dashboard/traffic-data — the traffic card's own chart data,
	// fetched over AJAX after the dashboard shell renders rather than
	// blocking the initial page load on a 30-day recursive CTE against
	// RequestLog (cached via InsightsService, but still not free on a cold
	// cache) — the card shows a loading skeleton until this resolves.
	function trafficData( req, res ){
		var traffic = buildTrafficChartData( insightsFetch( () => variables.insightsService.getDailyTotals( 30 ), [] ) );
		res.json( { success: true, traffic: traffic } );
	}

	/**
	 * Turns a day-by-day view-totals array into what the dashboard's Chart.js
	 * traffic graph needs: parallel labels/values arrays, the period total,
	 * the single busiest day, and today's own count for the stat boxes
	 * beside the chart.
	 */
	private function buildTrafficChartData( required array dailyTotals ){
		var maxViews = 0;
		var total    = 0;
		var labels   = [];
		var values   = [];

		for ( var row in arguments.dailyTotals ){
			total += row.total_views;
			if ( row.total_views > maxViews ) maxViews = row.total_views;
			labels.append( dateTimeFormat( row.view_date, "mmm d" ) );
			values.append( row.total_views );
		}

		// getDailyTotals() always appends today as its last row (a live,
		// uncached query — see that function), so the last value here is
		// today's count so far, not a cached/completed day's total.
		var todayViews = arguments.dailyTotals.len() ? arguments.dailyTotals[ arguments.dailyTotals.len() ].total_views : 0;

		return {
			"labels"    : labels,
			"values"    : values,
			"total"     : total,
			"maxViews"  : maxViews,
			"todayViews": todayViews,
			"days"      : arguments.dailyTotals.len()
		};
	}

	// ── Posts ────────────────────────────────────────────────────────────────

	// GET /manage/posts
	function postsList( req, res ){
		var rawPage     = req.query.page ?: "";
		var currentPage = isNumeric( rawPage ) && rawPage > 0 ? int( rawPage ) : 1;

		var flash  = flashConsume( req );
		var paging = variables.postService.getManagePosts( currentPage, 20 );

		res.render( "manage/posts/index", {
			pageTitle     : "Manage Posts",
			manageSection : "posts",
			paging        : paging,
			isAdmin       : req.session.manage_user.role == "admin",
			csrfToken     : req.csrfToken(),
			success       : flash.success ?: ""
		} );
	}

	// POST /manage/posts/:id/toggle-featured
	function toggleFeatured( req, res ){
		var postId = req.params.id ?: "";
		if ( len( trim( postId ) ) ){
			variables.postService.toggleFeatured( postId );
		}

		if ( isAjax( req ) ){
			res.json( { success: true } );
			return;
		}

		var page = req.body.page ?: 1;
		res.redirect( "/manage/posts?page=" & page );
	}

	// GET /manage/posts/new
	function newPost( req, res ){
		renderPostForm( req, res, new models.PostBean(), true );
	}

	// GET /manage/posts/:id/edit
	function editPost( req, res ){
		var postId = req.params.id ?: "";
		if ( !len( trim( postId ) ) ){
			res.redirect( "/manage/posts" );
			return;
		}

		var post = variables.postService.getPostById( postId );
		if ( !post.exists() ){
			res.redirect( "/manage/posts" );
			return;
		}

		// [C5] Non-admin users may only edit posts they authored.
		if ( !variables.postService.canUserEditPost( post.getId(), req.session.manage_user.id, req.session.manage_user.role ) ){
			println( "[auth] unauthorized post edit attempt — user '" & req.session.manage_user.id & "' on post '" & postId & "' from " & req.ip );
			res.redirect( "/manage/posts" );
			return;
		}

		var flash = flashConsume( req );
		renderPostForm( req, res, post, false, "", flash.success ?: "" );
	}

	// POST /manage/posts/save
	function savePost( req, res ){
		var isNew  = !len( trim( req.body.post_id ?: "" ) );
		var errors = validatePostForm( req );

		if ( !isNew && !variables.postService.canUserEditPost( req.body.post_id, req.session.manage_user.id, req.session.manage_user.role ) ){
			errors.append( "You are not authorised to edit this post." );
		}

		// AJAX only covers the update case — a create genuinely gets a new
		// resource URL (/manage/posts/:id/edit), which is a real navigation,
		// not something to fake with a JSON response.
		if ( errors.len() ){
			if ( isAjax( req ) && !isNew ){
				res.status( 422 ).json( { success: false, error: errors[ 1 ] } );
				return;
			}
			renderPostForm( req, res, postFromForm( req ), isNew, errors[ 1 ] );
			return;
		}

		var bean = postFromForm( req );
		var postId = variables.postService.savePost( bean );
		variables.postService.syncTags( postId, req.body.tags ?: "" );

		if ( isNew ){
			variables.postService.ensureAuthor( postId, req.session.manage_user.id );
			res.redirect( "/manage/posts/" & postId & "/edit" );
			return;
		}

		if ( isAjax( req ) ){
			res.json( { success: true, message: "Post saved." } );
			return;
		}

		flashSet( req, { success: "Post saved." } );
		res.redirect( "/manage/posts/" & postId & "/edit" );
	}

	// POST /manage/posts/preview — renders the submitted (unsaved) markdown
	// body exactly like the public post page would, for the editor's
	// Write/Preview toggle. Never touches the database.
	function previewPost( req, res ){
		try {
			res.json( { success: true, html: variables.postRenderer.render( req.body.body ?: "" ) } );
		} catch ( any e ) {
			res.status( 422 ).json( { success: false, error: "Couldn't render preview: " & e.message } );
		}
	}

	// POST /manage/posts/upload-url — the editor's "Upload" button calls this
	// first with the file's name/type, gets back a presigned R2 URL, then
	// PUTs the file straight to R2 itself (see R2Client.presignPutUrl() for
	// why this server never touches the file bytes).
	function coverImageUploadUrl( req, res ){
		_presignedUpload( req, res );
	}

	/**
	 * Turns a client-supplied filename into a safe R2 object-key segment:
	 * strips the extension, lowercases, replaces anything that isn't
	 * alphanumeric with a hyphen, and collapses/trims repeats. Re-uploading
	 * the same filename overwrites the existing object at that key rather
	 * than growing a new one — deliberate, since the point of using the
	 * original name is a stable, predictable URL.
	 */
	private function slugifyFilename( required string filename ){
		var base = listLen( arguments.filename, "." ) > 1
			? listDeleteAt( arguments.filename, listLen( arguments.filename, "." ), "." )
			: arguments.filename;
		var slug = lCase( trim( base ) ).reReplace( "[^a-z0-9]+", "-", "all" ).reReplace( "^-+|-+$", "", "all" );
		return len( slug ) ? slug : "image";
	}

	// GET /manage/posts/images?path=sub/dir — backs the editor's "Choose
	// existing" picker modal. Hands back a presigned R2 list URL for one
	// directory (folders as CommonPrefixes, files as Contents); the browser
	// fetches it and parses the ListBucketResult XML itself (see
	// R2Client.presignListUrl()). The modal opens at r2UploadPrefix but can
	// navigate anywhere in the bucket from there, same as the media manager.
	function listCoverImagesUrl( req, res ){
		_presignedListing( req, res );
	}

	// POST /manage/posts/create-folder — same as mediaCreateFolder below,
	// available from the post editor's picker too since it shares the same
	// full-bucket browsing.
	function postsCreateFolder( req, res ){
		_presignedCreateFolder( req, res );
	}

	private function validatePostForm( req ){
		var errors = [];
		if ( !len( trim( req.body.title ?: "" ) ) ) errors.append( "Title is required." );
		return errors;
	}

	private function postFromForm( req ){
		var bean = new models.PostBean();
		bean.setId(          req.body.post_id ?: "" );
		bean.setTitle(       req.body.title ?: "" );
		bean.setSlug(        req.body.slug ?: "" );
		bean.setDescription( req.body.description ?: "" );
		bean.setCoverImage(  req.body.cover_image ?: "" );
		bean.setBody(        req.body.body ?: "" );
		bean.setStatus(      req.body.status ?: "draft" );
		bean.setFeatured(    ( req.body.featured ?: "" ) == "1" );
		bean.setPublishDate( req.body.publish_date ?: "" );
		bean.setTags(        listToArray( req.body.tags ?: "", "," ) );
		return bean;
	}

	private function renderPostForm( req, res, required post, required boolean isNew, string error = "", string success = "" ){
		res.render( "manage/posts/form", {
			pageTitle     : arguments.isNew ? "New Post" : "Edit Post",
			manageSection : "posts",
			post          : arguments.post,
			isNew         : arguments.isNew,
			allTags       : variables.postService.getAllTagNames(),
			tagsList      : arguments.post.getTags().toList( ", " ),
			error         : arguments.error,
			success       : arguments.success,
			csrfToken     : req.csrfToken(),
			r2UploadPrefix: variables.r2UploadPrefix
		} );
	}

	// ── Authors ──────────────────────────────────────────────────────────────

	// GET /manage/authors
	function authorsList( req, res ){
		res.render( "manage/authors/index", {
			pageTitle     : "Manage Authors",
			manageSection : "authors",
			authors       : variables.authorService.getAuthors()
		} );
	}

	// GET /manage/authors/new
	function newAuthor( req, res ){
		renderAuthorForm( req, res, new models.AuthorBean(), true );
	}

	// GET /manage/authors/:id/edit
	function editAuthor( req, res ){
		var authorId = req.params.id ?: "";
		if ( !len( trim( authorId ) ) ){
			res.redirect( "/manage" );
			return;
		}

		var author = variables.authorService.getAuthorById( authorId );
		if ( !author.exists() ){
			res.redirect( "/manage/authors" );
			return;
		}

		// [C4, C5] Non-admin users may only edit their own profile.
		if ( !variables.authorService.canUserEditAuthor( author.getId(), req.session.manage_user.id, req.session.manage_user.role ) ){
			println( "[auth] unauthorized author edit attempt — user '" & req.session.manage_user.id & "' on author '" & authorId & "' from " & req.ip );
			res.redirect( "/manage" );
			return;
		}

		renderAuthorForm( req, res, author, false );
	}

	// POST /manage/authors/save
	function saveAuthor( req, res ){
		var isNew    = !len( trim( req.body.author_id ?: "" ) );
		var newPassword = trim( req.body.new_password ?: "" );

		// AJAX only covers the update case — a create genuinely gets a new
		// resource URL (/manage/authors/:id/edit), which is a real navigation.
		var ajax = isAjax( req ) && !isNew;

		if ( !isNew && !variables.authorService.canUserEditAuthor( req.body.author_id, req.session.manage_user.id, req.session.manage_user.role ) ){
			if ( ajax ){ res.status( 422 ).json( { success: false, error: "You are not authorised to edit this author." } ); return; }
			renderAuthorForm( req, res, authorFromForm( req ), isNew, "You are not authorised to edit this author." );
			return;
		}

		if ( !len( trim( req.body.display_name ?: "" ) ) ){
			if ( ajax ){ res.status( 422 ).json( { success: false, error: "Display name is required." } ); return; }
			renderAuthorForm( req, res, authorFromForm( req ), isNew, "Display name is required." );
			return;
		}
		if ( !len( trim( req.body.email ?: "" ) ) ){
			if ( ajax ){ res.status( 422 ).json( { success: false, error: "Email is required." } ); return; }
			renderAuthorForm( req, res, authorFromForm( req ), isNew, "Email is required." );
			return;
		}
		if ( isNew && !len( newPassword ) ){
			renderAuthorForm( req, res, authorFromForm( req ), isNew, "Password is required for new authors." );
			return;
		}

		var bean = authorFromForm( req );

		// [C8] Only admins may assign/change roles — non-admins keep their existing role.
		if ( req.session.manage_user.role != "admin" ){
			var existing = variables.authorService.getAuthorById( req.body.author_id ?: "" );
			bean.setRole( existing.exists() ? existing.getRole() : "author" );
		}

		var authorId = variables.authorService.saveAuthor( bean, newPassword );

		if ( isNew ){
			res.redirect( "/manage/authors/" & authorId & "/edit" );
			return;
		}

		if ( ajax ){
			res.json( { success: true, message: "Author saved." } );
			return;
		}

		flashSet( req, { success: "Author saved." } );
		res.redirect( "/manage/authors/" & authorId & "/edit" );
	}

	private function authorFromForm( req ){
		var bean = new models.AuthorBean();
		bean.setId(          req.body.author_id ?: "" );
		bean.setDisplayName( req.body.display_name ?: "" );
		bean.setEmail(       req.body.email ?: "" );
		bean.setRole(        req.body.role ?: "author" );
		bean.setAbout(       req.body.about ?: "" );
		bean.setAvatarLabel( left( trim( req.body.avatar_label ?: "" ), 2 ).uCase() );
		return bean;
	}

	private function renderAuthorForm( req, res, required author, required boolean isNew, string error = "" ){
		var flash = flashConsume( req );
		res.render( "manage/authors/form", {
			pageTitle     : arguments.isNew ? "New Author" : "Edit Author",
			manageSection : "authors",
			author        : arguments.author,
			isNew         : arguments.isNew,
			error         : arguments.error,
			success       : flash.success ?: "",
			csrfToken     : req.csrfToken()
		} );
	}

	// ── Settings ─────────────────────────────────────────────────────────────

	// GET /manage/settings
	function settingsIndex( req, res ){
		var flash = flashConsume( req );
		res.render( "manage/settings/index", {
			pageTitle     : "Settings",
			manageSection : "settings",
			settings      : variables.settingsService.getAll(),
			success       : flash.success ?: "",
			error         : flash.error ?: "",
			csrfToken     : req.csrfToken()
		} );
	}

	// POST /manage/settings/update
	function updateSetting( req, res ){
		var category   = req.body.category ?: "";
		var settingKey = req.body.setting_key ?: "";
		var value      = req.body.setting_value ?: "";

		variables.settingsService.updateSetting( category, settingKey, value );
		var message = "Saved " & category & "." & settingKey & ".";

		if ( isAjax( req ) ){
			res.json( { success: true, message: message } );
			return;
		}

		flashSet( req, { success: message } );
		res.redirect( "/manage/settings" );
	}

	// ── Media manager ────────────────────────────────────────────────────────
	// Browses the R2 bucket from its root, not just the posts/ prefix the post
	// editor's picker is scoped to — folder navigation and uploads are entirely
	// client-driven (see the view's JS), same presign-then-fetch-directly
	// pattern as the editor's image picker (R2Client never touches the file
	// bytes or the listing itself; see R2Client.presignPutUrl()).

	// GET /manage/media
	function mediaIndex( req, res ){
		res.render( "manage/media/index", {
			pageTitle     : "Media",
			manageSection : "media",
			csrfToken     : req.csrfToken(),
			r2Configured  : variables.r2Client.isConfigured()
		} );
	}

	// GET /manage/media/list-url?path=sub/dir — presigns a delimited listing
	// of one directory (folders as CommonPrefixes, files as Contents), not the
	// whole bucket recursively.
	function mediaListUrl( req, res ){
		_presignedListing( req, res );
	}

	// POST /manage/media/upload-url — same two-step presigned upload as the
	// post editor's cover-image upload, except the destination directory is
	// whatever the browser currently has open rather than a fixed prefix.
	function mediaUploadUrl( req, res ){
		_presignedUpload( req, res );
	}

	// POST /manage/media/create-folder — folders are virtual in S3-compatible
	// storage, so "creating" one just means writing a zero-byte ".keep"
	// object under the new prefix (see _presignedCreateFolder()), which is
	// enough for it to show up as a CommonPrefix on the next listing.
	function mediaCreateFolder( req, res ){
		_presignedCreateFolder( req, res );
	}

	// ── Shared by the media manager and the post editor's picker — both
	// browse/upload/create-folder against the same bucket the same way, just
	// through different route prefixes and auth levels (admin vs any author).

	private function _presignedListing( req, res ){
		if ( !variables.r2Client.isConfigured() ){
			return res.status( 501 ).json( { success: false, error: "Image hosting isn't configured (missing R2 env vars)." } );
		}

		try {
			var path = sanitizeMediaPath( req.query.path ?: "" );
			var listUrl = variables.r2Client.presignListUrl( path, 1000, 300, "/" );
			res.json( { success: true, listUrl: listUrl, publicBaseUrl: variables.r2Client.getPublicBaseUrl(), path: path } );
		} catch ( any e ) {
			println( "[error] directory list presign failed: " & e.message );
			res.status( 502 ).json( { success: false, error: "Couldn't prepare the directory listing." } );
		}
	}

	private function _presignedUpload( req, res ){
		if ( !variables.r2Client.isConfigured() ){
			return res.status( 501 ).json( { success: false, error: "Image hosting isn't configured (missing R2 env vars)." } );
		}

		var filename    = trim( req.body.filename ?: "" );
		var contentType = trim( req.body.contentType ?: "" );
		var allowedTypes = { "image/jpeg": "jpg", "image/png": "png", "image/webp": "webp", "image/gif": "gif" };
		var ext = allowedTypes[ lCase( contentType ) ] ?: "";
		if ( !len( ext ) ){
			return res.status( 415 ).json( { success: false, error: "Unsupported image type: #encodeForHTML( contentType )#. Use JPEG, PNG, WebP, or GIF." } );
		}

		try {
			var path = sanitizeMediaPath( req.body.path ?: "" );
			var key = path & slugifyFilename( filename ) & "." & ext;
			var presigned = variables.r2Client.presignPutUrl( key, contentType );
			res.json( { success: true, uploadUrl: presigned.uploadUrl, url: presigned.publicUrl, key: key } );
		} catch ( any e ) {
			println( "[error] upload presign failed: " & e.message );
			res.status( 502 ).json( { success: false, error: "Couldn't prepare the upload." } );
		}
	}

	// A "folder" only starts showing up in listings once something exists
	// under its prefix — S3-compatible storage has no real mkdir. Writing a
	// zero-byte "<path>/<name>/.keep" object is the standard workaround; the
	// browser's listing parser drops ".keep" entries so they never render as
	// a file (see media-browser.js's parseListing()).
	private function _presignedCreateFolder( req, res ){
		if ( !variables.r2Client.isConfigured() ){
			return res.status( 501 ).json( { success: false, error: "Image hosting isn't configured (missing R2 env vars)." } );
		}

		var path = sanitizeMediaPath( req.body.path ?: "" );
		var name = trim( req.body.name ?: "" );
		if ( !len( name ) || name == "." || name == ".." || !reFind( "^[A-Za-z0-9._ -]+$", name ) ){
			return res.status( 422 ).json( { success: false, error: "Enter a valid folder name (letters, numbers, spaces, dots, dashes, underscores)." } );
		}

		try {
			var folderPath = path & name & "/";
			var presigned = variables.r2Client.presignPutUrl( folderPath & ".keep", "application/x-directory" );
			res.json( { success: true, uploadUrl: presigned.uploadUrl, path: folderPath } );
		} catch ( any e ) {
			println( "[error] create-folder presign failed: " & e.message );
			res.status( 502 ).json( { success: false, error: "Couldn't prepare the new folder." } );
		}
	}

	/**
	 * Turns a client-supplied directory path into a safe key prefix: strips
	 * leading/trailing slashes, drops empty/"."/".." segments (blocks
	 * traversal out of the bucket root), and restricts each remaining
	 * segment to a conservative charset. Returns "" for the bucket root, or
	 * "a/b/" (trailing slash, no leading slash) for a subdirectory — ready to
	 * prepend directly to an object key or pass as a list prefix.
	 */
	private function sanitizeMediaPath( required string path ){
		var segments = listToArray( arguments.path.reReplace( "\\", "/", "all" ), "/" );
		var cleanSegments = [];
		for ( var seg in segments ){
			var s = trim( seg );
			if ( !len( s ) || s == "." || s == ".." || !reFind( "^[A-Za-z0-9._ -]+$", s ) ) continue;
			cleanSegments.append( s );
		}
		return cleanSegments.len() ? cleanSegments.toList( "/" ) & "/" : "";
	}

	// ── Comments ─────────────────────────────────────────────────────────────
	// Stopgap moderation view — CommentService has no approve/spam workflow
	// (see db/migrations/0009_add_comment_table.sql's status enum), so this is
	// just a paginated, all-posts listing with soft-delete until something
	// more purpose-built replaces it.

	// GET /manage/comments
	function commentsIndex( req, res ){
		var rawPage     = req.query.page ?: "";
		var currentPage = isNumeric( rawPage ) && rawPage > 0 ? int( rawPage ) : 1;

		var flash  = flashConsume( req );
		var paging = variables.commentService.getManageComments( currentPage, 20 );

		res.render( "manage/comments/index", {
			pageTitle     : "Comments",
			manageSection : "comments",
			paging        : paging,
			csrfToken     : req.csrfToken(),
			success       : flash.success ?: ""
		} );
	}

	// POST /manage/comments/:id/delete
	function deleteManageComment( req, res ){
		var commentId = req.params.id ?: "";
		if ( len( trim( commentId ) ) ){
			variables.commentService.deleteComment( commentId, req.session.manage_user.id, req.session.manage_user.role );
		}

		if ( isAjax( req ) ){
			res.json( { success: true } );
			return;
		}

		var page = req.body.page ?: 1;
		flashSet( req, { success: "Comment deleted." } );
		res.redirect( "/manage/comments?page=" & page );
	}

	// ── Visitor insights (RequestLog) ───────────────────────────────────────

	// GET /manage/insights — each card's own query is caught independently
	// so one failing query (a DB blip) degrades that one card instead of
	// blanking the whole page behind a 500.
	function insightsIndex( req, res ){
		var daysBack = 30;

		res.render( "manage/insights/index", {
			pageTitle      : "Insights",
			manageSection  : "insights",
			daysBack       : daysBack,
			total          : insightsFetch( () => variables.insightsService.getTotal( daysBack ) ),
			topPosts       : insightsFetch( () => variables.postService.getTrendingPosts( 10 ) ),
			topReferrers   : insightsFetch( () => variables.insightsService.getTopReferrers( daysBack, 10 ) ),
			top404s        : insightsFetch( () => variables.insightsService.getTop404s( daysBack, 8 ) ),
			topSearches    : insightsFetch( () => variables.postService.getTopSearches( daysBack, 8 ) )
		} );
	}

	/**
	 * Runs a single InsightsService call, logging and swallowing any failure
	 * so the caller gets a safe fallback (null by default, or the given one)
	 * instead of an exception — see insightsIndex()'s per-card isolation.
	 */
	private function insightsFetch( required fetchFn, fallback = javacast( "null", "" ) ){
		try {
			return arguments.fetchFn();
		} catch ( any e ) {
			println( "[error] Insights fetch failed: " & e.message );
			return arguments.fallback;
		}
	}

	// GET /manage/logs — raw RequestLog browser, newest first. Separate from
	// /manage/insights: insights is filtered/aggregated visitor analytics,
	// this is an unfiltered access-log viewer for debugging and auditing.
	function logsIndex( req, res ){
		var rawPage     = req.query.page ?: "";
		var currentPage = isNumeric( rawPage ) && rawPage > 0 ? int( rawPage ) : 1;
		var pathFilter  = trim( req.query.q ?: "" );

		// method/status/quick are the Alpine table's client-side filters —
		// the server never applies them (they only ever act on whatever
		// page's rows are already loaded), but round-tripping the current
		// values through the URL is what makes them survive a pagination
		// click or a plain reload instead of resetting every time. The view
		// both seeds Alpine's initial state from these and folds them into
		// every pagination link it renders, same as it already does for q.
		var clientFilters = {
			"method": trim( req.query.method ?: "" ),
			"status": trim( req.query.status ?: "" ),
			"quick" : trim( req.query.quick  ?: "" )
		};

		var paging = variables.insightsService.getRecentRequests( currentPage, 50, pathFilter );

		res.render( "manage/logs/index", {
			pageTitle     : "Request Log",
			manageSection : "logs",
			paging        : paging,
			clientFilters : clientFilters,
			// Same </script>-escaping as rowsJson below, applied on principle —
			// these three values are never attacker-controlled in any way that
			// matters here, but there's no reason to treat this embed
			// differently from the one right next to it.
			clientFiltersJson: replace( JSONSerialize( clientFilters ), "</", "<\/", "all" ),
			// The Alpine table on this page sorts/filters client-side, but only
			// within whatever's already on the current server-rendered page —
			// pagination and the path search box above stay server-side (this
			// log can run to hundreds of pages; shipping the whole thing to the
			// client isn't on the table). </script> is escaped so a referrer or
			// user-agent value containing that literal string can't break out
			// of the embedding <script type="application/json"> tag below.
			rowsJson: replace( JSONSerialize( _rowsForClient( paging.rows ) ), "</", "<\/", "all" )
		} );
	}

	private function _rowsForClient( required array rows ){
		return arguments.rows.map( ( row ) => {
			return {
				"id"         : row.id,
				// A UTC ISO string, not a display label — the browser formats
				// it into the viewer's own local timezone client-side (see
				// LocalTime.format() in local-time.js), and it doubles as the
				// sort key since ISO-with-Z strings sort correctly as text.
				"timeSort"   : dateTimeFormat( row.requested_at, "yyyy-mm-dd'T'HH:nn:ss'Z'" ),
				"method"     : row.method,
				"path"       : row.path,
				"queryString": row.query_string,
				"statusCode" : isNull( row.status_code ) ? "" : row.status_code,
				"durationMs" : row.duration_ms,
				"ip"         : row.ip_address,
				"referrer"   : row.referrer,
				"userAgent"  : row.user_agent
			};
		} );
	}

	// ── Server monitor (JVM/OS metrics) ─────────────────────────────────────

	// GET /manage/server — full detail behind ServerMonitor.getSnapshot();
	// see _formatServerSnapshot() for how the raw byte/ms/ratio values below
	// become the display-ready struct the view renders.
	function serverIndex( req, res ){
		var snapshot = serverFetch( () => variables.serverMonitor.getSnapshot() );
		res.render( "manage/server/index", {
			pageTitle    : "Server",
			manageSection: "server",
			server       : isNull( snapshot ) ? javacast( "null", "" ) : _formatServerSnapshot( snapshot )
		} );
	}

	// GET /manage/server/data — same snapshot as serverIndex(), as JSON, for
	// the page's own polling loop (see the script at the bottom of
	// manage/server/index.bxm) rather than a full page reload every tick.
	function serverData( req, res ){
		var snapshot = serverFetch( () => variables.serverMonitor.getSnapshot() );
		if ( isNull( snapshot ) ){
			return res.status( 502 ).json( { success: false, error: "Couldn't read server metrics." } );
		}
		res.json( { success: true, server: _formatServerSnapshot( snapshot ) } );
	}

	private function serverFetch( required fetchFn ){
		try {
			return arguments.fetchFn();
		} catch ( any e ) {
			println( "[error] Server metrics fetch failed: " & e.message );
			return javacast( "null", "" );
		}
	}

	/**
	 * Turns ServerMonitor.getSnapshot()'s raw struct (bytes, milliseconds,
	 * 0-1 ratios, epoch millis) into display-ready strings/percentages, so
	 * the view (both this page and the dashboard summary card) only ever
	 * interpolates, never computes.
	 */
	private function _formatServerSnapshot( required struct snapshot ){
		var mem = arguments.snapshot.memory;
		var cpu = arguments.snapshot.cpu;

		var totalGcTimeMs = 0;
		for ( var gcRow in arguments.snapshot.gc ){
			totalGcTimeMs += gcRow.collectionTime;
		}

		var display = {
			"memory": {
				"heapUsed"        : _formatBytes( mem.heapUsed ),
				"heapCommitted"   : _formatBytes( mem.heapCommitted ),
				"heapMax"         : mem.heapMax <= 0 ? "unbounded" : _formatBytes( mem.heapMax ),
				"heapPercent"     : mem.heapMax > 0 ? round( mem.heapUsed / mem.heapMax * 100 ) : 0,
				"nonHeapUsed"     : _formatBytes( mem.nonHeapUsed ),
				"nonHeapCommitted": _formatBytes( mem.nonHeapCommitted ),
				"runtimeTotal"    : _formatBytes( mem.runtimeTotal ),
				"runtimeFree"     : _formatBytes( mem.runtimeFree ),
				"runtimeMax"      : _formatBytes( mem.runtimeMax )
			},
			"cpu": {
				"availableProcessors": cpu.availableProcessors,
				"systemLoadAverage"  : cpu.systemLoadAverage >= 0 ? numberFormat( cpu.systemLoadAverage, "0.00" ) : "n/a",
				"processCpuLoad"     : structKeyExists( cpu, "processCpuLoad" ) && cpu.processCpuLoad >= 0 ? _formatPercent( cpu.processCpuLoad ) : "n/a",
				"systemCpuLoad"      : structKeyExists( cpu, "systemCpuLoad" ) && cpu.systemCpuLoad >= 0 ? _formatPercent( cpu.systemCpuLoad ) : "n/a",
				"totalPhysicalMemory": structKeyExists( cpu, "totalPhysicalMemory" ) ? _formatBytes( cpu.totalPhysicalMemory ) : "n/a",
				"freePhysicalMemory" : structKeyExists( cpu, "freePhysicalMemory" ) ? _formatBytes( cpu.freePhysicalMemory ) : "n/a",
				"totalSwap"          : structKeyExists( cpu, "totalSwap" ) ? _formatBytes( cpu.totalSwap ) : "n/a",
				"freeSwap"           : structKeyExists( cpu, "freeSwap" ) ? _formatBytes( cpu.freeSwap ) : "n/a"
			},
			"disk": {
				"totalSpace" : _formatBytes( arguments.snapshot.disk.totalSpace ),
				"freeSpace"  : _formatBytes( arguments.snapshot.disk.freeSpace ),
				"usableSpace": _formatBytes( arguments.snapshot.disk.usableSpace ),
				"usedPercent": arguments.snapshot.disk.totalSpace > 0
					? round( ( arguments.snapshot.disk.totalSpace - arguments.snapshot.disk.freeSpace ) / arguments.snapshot.disk.totalSpace * 100 )
					: 0
			},
			"jvm": {
				"vmName"               : arguments.snapshot.jvm.vmName,
				"vmVendor"             : arguments.snapshot.jvm.vmVendor,
				"vmVersion"            : arguments.snapshot.jvm.vmVersion,
				"specVersion"          : arguments.snapshot.jvm.specVersion,
				"startTime"            : dateTimeFormat( _epochMillisToDate( arguments.snapshot.jvm.startTime ), "mmm d, h:nn:ss tt" ),
				"startTimeUtc"         : dateTimeFormat( _epochMillisToDate( arguments.snapshot.jvm.startTime ), "yyyy-mm-dd'T'HH:nn:ss'Z'" ),
				"uptime"               : _formatDuration( arguments.snapshot.jvm.uptimeMs ),
				"loadedClassCount"     : numberFormat( arguments.snapshot.jvm.loadedClassCount ),
				"totalLoadedClassCount": numberFormat( arguments.snapshot.jvm.totalLoadedClassCount ),
				"unloadedClassCount"   : numberFormat( arguments.snapshot.jvm.unloadedClassCount )
			},
			"gc": arguments.snapshot.gc.map( ( row ) => {
				return {
					"name"           : row.name,
					"collectionCount": numberFormat( row.collectionCount ),
					"collectionTime" : _formatDuration( row.collectionTime )
				};
			} ),
			"gcHealth": _gcHealth( totalGcTimeMs, arguments.snapshot.jvm.uptimeMs ),
			"threads": {
				"liveCount"        : numberFormat( arguments.snapshot.threads.liveCount ),
				"peakCount"        : numberFormat( arguments.snapshot.threads.peakCount ),
				"daemonCount"      : numberFormat( arguments.snapshot.threads.daemonCount ),
				"totalStartedCount": numberFormat( arguments.snapshot.threads.totalStartedCount )
			},
			"process": {
				"pid"        : structKeyExists( arguments.snapshot.process, "pid" ) ? arguments.snapshot.process.pid : "n/a",
				"osName"     : arguments.snapshot.process.osName,
				"osVersion"  : arguments.snapshot.process.osVersion,
				"osArch"     : arguments.snapshot.process.osArch,
				"javaVersion": arguments.snapshot.process.javaVersion,
				"userDir"    : arguments.snapshot.process.userDir
			},
			"connector": isNull( arguments.snapshot.connector ) ? javacast( "null", "" ) : {
				"requestCount"        : numberFormat( arguments.snapshot.connector.requestCount ),
				"activeRequests"      : numberFormat( arguments.snapshot.connector.activeRequests ),
				"maxActiveRequests"   : numberFormat( arguments.snapshot.connector.maxActiveRequests ),
				"activeConnections"   : numberFormat( arguments.snapshot.connector.activeConnections ),
				"maxActiveConnections": numberFormat( arguments.snapshot.connector.maxActiveConnections ),
				"bytesSent"           : _formatBytes( arguments.snapshot.connector.bytesSent ),
				"bytesReceived"       : _formatBytes( arguments.snapshot.connector.bytesReceived ),
				"errorCount"          : numberFormat( arguments.snapshot.connector.errorCount ),
				"avgProcessingTime"   : arguments.snapshot.connector.requestCount > 0
					? _formatMs( arguments.snapshot.connector.processingTimeMs / arguments.snapshot.connector.requestCount )
					: "n/a",
				"maxProcessingTime"   : _formatMs( arguments.snapshot.connector.maxProcessingTimeMs )
			}
		};

		return display;
	}

	// dateTimeFormat() doesn't treat a raw number as Unix epoch millis (it
	// overflows into a nonsense date), so RuntimeMXBean.getStartTime()'s
	// epoch-millis value needs converting to a real Date first.
	private function _epochMillisToDate( required numeric epochMillis ){
		return createObject( "java", "java.util.Date" ).init( javaCast( "long", arguments.epochMillis ) );
	}

	private function _formatBytes( required numeric bytes ){
		if ( arguments.bytes < 1024 ) return arguments.bytes & " B";
		if ( arguments.bytes < 1024 * 1024 ) return numberFormat( arguments.bytes / 1024, "0.0" ) & " KB";
		if ( arguments.bytes < 1024 * 1024 * 1024 ) return numberFormat( arguments.bytes / 1024 / 1024, "0.0" ) & " MB";
		return numberFormat( arguments.bytes / 1024 / 1024 / 1024, "0.00" ) & " GB";
	}

	private function _formatDuration( required numeric ms ){
		var totalSeconds = int( arguments.ms / 1000 );
		var days    = int( totalSeconds / 86400 );
		var hours   = int( ( totalSeconds % 86400 ) / 3600 );
		var minutes = int( ( totalSeconds % 3600 ) / 60 );
		var seconds = totalSeconds % 60;

		if ( days > 0 ) return days & "d " & hours & "h " & minutes & "m";
		if ( hours > 0 ) return hours & "h " & minutes & "m";
		if ( minutes > 0 ) return minutes & "m " & seconds & "s";
		return seconds & "s";
	}

	// _formatDuration() above truncates to whole seconds — fine for uptime/GC
	// time, useless for a per-request duration that's normally well under a
	// second (it'd just read "0s" for anything under a full second).
	private function _formatMs( required numeric ms ){
		if ( arguments.ms < 1000 ) return numberFormat( arguments.ms, "0" ) & "ms";
		return numberFormat( arguments.ms / 1000, "0.00" ) & "s";
	}

	private function _formatPercent( required numeric ratio ){
		return numberFormat( arguments.ratio * 100, "0.0" ) & "%";
	}

	// Total GC pause time as a share of process uptime is a much steadier
	// health signal than any single collection count/time — a JVM that's
	// spent 15% of its life paused in GC is in trouble even if the heap bar
	// itself looks fine at the moment of the snapshot. Thresholds mirror the
	// standard GC-overhead rules of thumb: <1% healthy, 1-5% worth watching,
	// 5-10% worth investigating, >10% an active problem. badgeClass reuses
	// the HTTP-status color scale (2xx/3xx/4xx/5xx) already styled in
	// manage.css rather than inventing new colors.
	private function _gcHealth( required numeric totalGcTimeMs, required numeric uptimeMs ){
		var ratio      = arguments.uptimeMs > 0 ? ( arguments.totalGcTimeMs / arguments.uptimeMs * 100 ) : 0;
		var status     = "healthy";
		var label      = "Healthy";
		var badgeClass = "2xx";

		if ( ratio > 10 ){
			status = "problem";
			label = "Problem";
			badgeClass = "5xx";
		} else if ( ratio > 5 ){
			status = "investigate";
			label = "Investigate";
			badgeClass = "4xx";
		} else if ( ratio > 1 ){
			status = "watch";
			label = "Watch";
			badgeClass = "3xx";
		}

		return {
			"ratioPercent": numberFormat( ratio, "0.00" ) & "%",
			"status"      : status,
			"label"       : label,
			"badgeClass"  : badgeClass
		};
	}

}

/**
 * /projects — a showcase of side projects, each with an overview page and,
 * for the ones with enough content to warrant it, a multi-page docs section.
 */
class {

	variables.siteDefaults = "";

	// Registered projects, shown on /projects as cards.
	variables.projects = [
		{
			slug    : "boxlang-express",
			name    : "boxlang-express",
			icon    : "bi-boxes",
			tagline : "An Express.js-style API for building lightweight HTTP servers in BoxLang."
		},
		{
			slug    : "bx-zork",
			name    : "bx-zork",
			icon    : "bi-controller",
			tagline : "A from-scratch text-adventure parser engine in BoxLang, loaded with the world of Zork I."
		},
		{
			slug    : "coldbox-graphql",
			name    : "coldbox-graphql",
			icon    : "bi-diagram-3",
			tagline : "A schema-agnostic ColdBox module that serves a GraphQL API from SDL files you supply."
		}
	];

	// Ordered doc topics per project slug — only projects with a multi-page
	// docs section (as opposed to a single overview page) appear here.
	variables.projectDocs = {
		"boxlang-express" : [
			{ slug : "getting-started",  title : "Getting Started" },
			{ slug : "config",           title : "Configuration" },
			{ slug : "routing",          title : "Routing" },
			{ slug : "middleware",       title : "Middleware" },
			{ slug : "request-response", title : "Request & Response" },
			{ slug : "views",            title : "Views & Templates" },
			{ slug : "sessions",         title : "Sessions" },
			{ slug : "static-files",     title : "Static Files & Uploads" },
			{ slug : "errors",           title : "Error Handling" },
			{ slug : "lifecycle",        title : "Process Lifecycle" }
		],
		"coldbox-graphql" : [
			{ slug : "getting-started",       title : "Getting Started" },
			{ slug : "schema-files",          title : "Schema Files" },
			{ slug : "module-settings",       title : "Module Settings" },
			{ slug : "resolvers",             title : "Resolvers" },
			{ slug : "custom-scalars",        title : "Custom Scalars" },
			{ slug : "http-endpoint",         title : "HTTP Endpoint" },
			{ slug : "introspection",         title : "Introspection & SDL" },
			{ slug : "engine-compatibility",  title : "Engine Compatibility" },
			{ slug : "testing",               title : "Testing" }
		]
	};

	function init( required siteDefaults ){
		variables.siteDefaults = arguments.siteDefaults;

		this.router = boxExpressRouter();

		this.router.get( "/projects", ( req, res ) => index( req, res ) );
		this.router.get( "/projects/:slug/docs/:page", ( req, res, next ) => doc( req, res, next ) );
		this.router.get( "/projects/:slug", ( req, res, next ) => overview( req, res, next ) );

		return this;
	}

	// route: /projects
	function index( req, res ){
		res.render( "projects/index", {
			pageTitle    : "Projects",
			canonicalUrl : variables.siteDefaults.canonicalUrl( req.path ),
			meta         : variables.siteDefaults.defaultMeta( req.path ),
			projects     : variables.projects
		} );
	}

	// route: /projects/:slug
	function overview( req, res, next ){
		var slug    = req.params.slug ?: "";
		var project = findProject( slug );

		if ( isNull( project ) ){
			next();
			return;
		}

		res.render( "projects/" & slug & "/overview", {
			pageTitle    : project.name,
			canonicalUrl : variables.siteDefaults.canonicalUrl( req.path ),
			meta         : variables.siteDefaults.defaultMeta( req.path )
		} );
	}

	// route: /projects/:slug/docs/:page
	function doc( req, res, next ){
		var slug = req.params.slug ?: "";
		var page = req.params.page ?: "";

		if ( !variables.projectDocs.keyExists( slug ) ){
			next();
			return;
		}

		var project  = findProject( slug );
		var docsList = variables.projectDocs[ slug ];
		var docIndex = -1;

		for ( var i = 1; i <= docsList.len(); i++ ){
			if ( docsList[ i ].slug == page ){
				docIndex = i;
				break;
			}
		}

		if ( docIndex == -1 ){
			next();
			return;
		}

		var current = docsList[ docIndex ];
		var prevDoc = docIndex > 1 ? docsList[ docIndex - 1 ] : "";
		var nextDoc = docIndex < docsList.len() ? docsList[ docIndex + 1 ] : "";

		res.render( "projects/_docsShell", {
			pageTitle    : current.title & " — " & project.name,
			canonicalUrl : variables.siteDefaults.canonicalUrl( req.path ),
			meta         : variables.siteDefaults.defaultMeta( req.path ),
			projectSlug  : slug,
			projectName  : project.name,
			docs         : docsList,
			currentSlug  : page,
			contentView  : slug & "/docs/" & page,
			prevDoc      : prevDoc,
			nextDoc      : nextDoc
		} );
	}

	private function findProject( slug ){
		for ( var project in variables.projects ){
			if ( project.slug == slug ){
				return project;
			}
		}
		return javacast( "null", "" );
	}

}

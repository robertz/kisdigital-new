/**
 * /projects — a showcase of side projects, each with an overview page and,
 * for the ones with enough content to warrant it, a multi-page docs section.
 *
 * Doc pages are static: page metadata in models/util/ProjectDocRegistry.bx,
 * each page's markdown body in views/projects/{slug}/docs/{page_slug}.md,
 * rendered through ProjectDocRenderer at request time. Previously database-
 * backed (editable via /manage/project-docs with no deploy needed) — moved
 * back to files because the DB-editing workflow wasn't working out: doc
 * prose living only in the database meant it had no version history, no
 * diff-based review, and no way to edit it alongside the code changes it
 * documents.
 */
class {

	variables.siteDefaults       = "";
	variables.projectRegistry    = "";
	variables.projectDocRegistry = "";
	variables.projectDocRenderer = "";

	function init( required siteDefaults, required projectDocRegistry, required projectDocRenderer ){
		variables.siteDefaults       = arguments.siteDefaults;
		variables.projectDocRegistry = arguments.projectDocRegistry;
		variables.projectDocRenderer = arguments.projectDocRenderer;
		variables.projectRegistry    = new models.util.ProjectRegistry();

		this.router = boxExpressRouter();

		this.router.get( "/projects", ( req, res ) => index( req, res ) );
		this.router.get( "/projects/:slug/docs/:page", ( req, res, next ) => doc( req, res, next ) );
		this.router.get( "/projects/:slug", ( req, res, next ) => overview( req, res, next ) );

		return this;
	}

	// route: /projects
	function index( req, res ){
		res.render( "projects/index", {
			pageTitle    : "Projects",
			canonicalUrl : variables.siteDefaults.canonicalUrl( req.path ),
			meta         : variables.siteDefaults.defaultMeta( req.path ),
			projects     : variables.projectRegistry.getProjects()
		} );
	}

	// route: /projects/:slug
	function overview( req, res, next ){
		var slug    = req.params.slug ?: "";
		var project = variables.projectRegistry.findProject( slug );

		if ( isNull( project ) ){
			next();
			return;
		}

		res.render( "projects/" & slug & "/overview", {
			pageTitle    : project.name,
			canonicalUrl : variables.siteDefaults.canonicalUrl( req.path ),
			meta         : variables.siteDefaults.defaultMeta( req.path )
		} );
	}

	// route: /projects/:slug/docs/:page
	function doc( req, res, next ){
		var slug = req.params.slug ?: "";
		var page = req.params.page ?: "";

		if ( !variables.projectDocRegistry.projectHasDocs( slug ) ){
			next();
			return;
		}

		var project  = variables.projectRegistry.findProject( slug );
		var docsList = variables.projectDocRegistry.getDocsForProject( slug );
		var docIndex = -1;

		for ( var i = 1; i <= docsList.len(); i++ ){
			if ( docsList[ i ].page_slug == page ){
				docIndex = i;
				break;
			}
		}

		if ( docIndex == -1 ){
			next();
			return;
		}

		var current  = docsList[ docIndex ];
		var bodyPath = expandPath( "./views/projects/" & slug & "/docs/" & page & ".md" );
		var prevDoc  = docIndex > 1 ? docsList[ docIndex - 1 ] : "";
		var nextDoc  = docIndex < docsList.len() ? docsList[ docIndex + 1 ] : "";

		res.render( "projects/_docsShell", {
			pageTitle    : current.title & " — " & project.name,
			canonicalUrl : variables.siteDefaults.canonicalUrl( req.path ),
			meta         : variables.siteDefaults.defaultMeta( req.path ),
			projectSlug  : slug,
			projectName  : project.name,
			docs         : docsList,
			currentSlug  : page,
			docBodyHtml  : variables.projectDocRenderer.render( fileRead( bodyPath ) ),
			prevDoc      : prevDoc,
			nextDoc      : nextDoc
		} );
	}

}

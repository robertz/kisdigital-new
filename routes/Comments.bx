/**
 * Nested comments — create/delete only; reading a post's comment tree
 * happens inline in routes/Posts.bx's show() via CommentService directly,
 * same as every other piece of a post page (tags, related posts, etc).
 *
 * Its own router (not folded into Posts.bx) for the same reason
 * routes/Auth.bx is its own router: a focused concern, and it needs
 * boxExpressCsrf() mounted, which Posts.bx's router doesn't carry today.
 *
 * Both routes serve a plain POST-and-redirect form (no-JS fallback) and,
 * when public/assets/js/comments.js intercepts the submit, an AJAX JSON
 * response instead — detected the same way routes/Manage.bx's isAjax()
 * does, via the X-Requested-With header. The AJAX create response renders
 * the new comment through the same views/partials/commentThread.bxm
 * partial the full page uses (via bx:savecontent, mirroring
 * boxlang-express's own Response.bx:render()), so there's exactly one
 * template for what a comment looks like.
 */
class {

	variables.commentService = "";
	variables.botDetector    = "";

	function init( required commentService ){
		variables.commentService = arguments.commentService;
		variables.botDetector    = new models.util.BotDetector();

		var requireCommenter = ( req, res, next ) => _requireCommenter( req, res, next );

		this.router = boxExpressRouter();
		this.router.use( boxExpressCsrf() );

		this.router.post(
			"/comments",
			requireCommenter,
			boxExpressRateLimit( { windowMs: 15 * 60000, max: 10 } ),
			( req, res ) => create( req, res )
		);
		this.router.post( "/comments/:id/delete", requireCommenter, ( req, res ) => remove( req, res ) );

		return this;
	}

	// POST /comments — body: post_id, parent_id (blank for top-level),
	// body, redirect (the post's own URL, so we can send the commenter
	// straight back to their new comment), _csrf.
	function create( req, res ){
		var redirectTo = _safeRedirect( req.body.redirect ?: "/" );
		var ajax       = isAjax( req );

		if ( variables.botDetector.isBot( req.headers[ "User-Agent" ] ?: "" ) ){
			// Silently drop rather than error — telling a bot *why* it
			// failed only helps it adjust and retry.
			if ( ajax ){
				res.status( 400 ).json( { success: false, error: "Couldn't post your comment — please try again." } );
				return;
			}
			res.redirect( redirectTo );
			return;
		}

		var user     = _currentUser( req );
		var postId   = req.body.post_id ?: "";
		var parentId = req.body.parent_id ?: "";

		try {
			var newId = variables.commentService.createComment(
				postId,
				parentId,
				user.id,
				req.body.body ?: ""
			);

			if ( ajax ){
				res.json( {
					success : true,
					html    : _renderCommentFragment( variables.commentService.getComment( newId ), postId, redirectTo, req ),
					parentId: parentId,
					count   : variables.commentService.getCommentCount( postId )
				} );
				return;
			}

			res.redirect( redirectTo & "##comment-" & newId );
		} catch ( CommentValidationError e ){
			if ( ajax ){
				res.status( 422 ).json( { success: false, error: e.message } );
				return;
			}
			flashSet( req, { commentError: e.message } );
			res.redirect( redirectTo );
		} catch ( any e ){
			println( "[error] Comment creation failed: " & e.message );
			if ( ajax ){
				res.status( 500 ).json( { success: false, error: "Couldn't post your comment — please try again." } );
				return;
			}
			flashSet( req, { commentError: "Couldn't post your comment — please try again." } );
			res.redirect( redirectTo );
		}
	}

	// POST /comments/:id/delete — body: redirect.
	function remove( req, res ){
		var redirectTo = _safeRedirect( req.body.redirect ?: "/" );
		var user       = _currentUser( req );

		var comment = variables.commentService.getComment( req.params.id );
		var deleted = variables.commentService.deleteComment( req.params.id, user.id, user.role );

		if ( isAjax( req ) ){
			res.json( {
				success: deleted,
				count  : isNull( comment ) ? javacast( "null", "" ) : variables.commentService.getCommentCount( comment.postId ?: "" )
			} );
			return;
		}
		res.redirect( redirectTo );
	}

	// Renders a single comment through the same partial the full comment
	// list uses, for the AJAX create response — see this file's header
	// comment for why (one template for what a comment looks like).
	// commentThread.bxm reads data.currentUser/data.csrfToken/data.post and
	// a `comment` variable, all of which this builds standalone since a raw
	// route handler (unlike res.render()) has none of that already in scope.
	private function _renderCommentFragment( required struct comment, required string postId, required string postUrl, required req ){
		var postId  = arguments.postId;
		var postUrl = arguments.postUrl;
		var data    = { "currentUser": _currentUser( req ), "csrfToken": req.csrfToken(), "post": { "getId": () => postId, "getPostUrl": () => postUrl } };
		var comment = arguments.comment;
		var output  = "";
		var templatePath = expandPath( "../views/partials/commentThread.bxm" );
		bx:savecontent variable="output" {
			include "#templatePath#";
		}
		return output;
	}

	// Same check as routes/Manage.bx's own isAjax() — not shared between the
	// two files, matching this codebase's small-duplication-over-premature-
	// abstraction style elsewhere (flashSet/_currentUser/_safeRedirect).
	private function isAjax( req ){
		return ( req.headers[ "X-Requested-With" ] ?: "" ) == "XMLHttpRequest";
	}

	function _requireCommenter( req, res, next ){
		if ( isNull( _currentUser( req ) ) ){
			res.status( 401 ).send( "Sign in to comment." );
			return;
		}
		next();
	}

	// Reads whichever session slot is populated — req.session.manage_user
	// (admin/author, set by doLogin() or routes/Auth.bx's callback) or
	// req.session.commenter (routes/Auth.bx, Google-only accounts) — since
	// a comment's author can legitimately be either. Returns null when
	// neither is set.
	private function _currentUser( req ){
		if ( len( req.session.manage_user ?: "" ) ){
			var u = req.session.manage_user;
			return { "id": u.id, "displayName": u.display_name, "role": u.role };
		}
		if ( len( req.session.commenter ?: "" ) ){
			var u = req.session.commenter;
			return { "id": u.id, "displayName": u.display_name, "role": "commenter" };
		}
		return javacast( "null", "" );
	}

	// Same open-redirect defense as routes/Auth.bx's _safeRedirect() — the
	// redirect target comes from a hidden form field a client controls, so
	// only an internal, same-origin path is ever safe to send them to.
	private function _safeRedirect( required string path ){
		var p = trim( arguments.path );
		if ( !len( p ) ) return "/";
		if ( left( p, 1 ) != "/" ) return "/";
		if ( left( p, 2 ) == "//" ) return "/";
		if ( left( p, 2 ) == "/\" ) return "/";
		if ( findNoCase( "://", p ) ) return "/";
		return p;
	}

	private function flashSet( req, required struct data ){
		req.session._flash = arguments.data;
	}

}

/**
 * "Sign in with Google" / "Sign in with GitHub" — general-purpose, not
 * CMS-specific. A matched existing User row (admin/author — real staff)
 * gets the normal CMS session (req.session.manage_user, same shape
 * doLogin() sets in routes/Manage.bx). Anyone else gets a lightweight
 * role='commenter' account (AuthService.findOrCreateOAuthUser()) and a
 * separate req.session.commenter session that carries no /manage access.
 * Accounts are matched by verified email, so the same person signing in
 * with Google and then GitHub lands on the same User row.
 *
 * The comment form on a post page links to
 * GET /auth/<provider>?redirect=<that post's URL>.
 */
class {

	variables.authService = "";
	variables.providers   = {};
	variables.passkeys    = "";

	function init( required authService, required googleOAuthClient, required githubOAuthClient, required passkeys ){
		variables.authService = arguments.authService;
		variables.passkeys    = arguments.passkeys;
		variables.providers   = {
			"google": { "label": "Google", "client": arguments.googleOAuthClient },
			"github": { "label": "GitHub", "client": arguments.githubOAuthClient }
		};

		this.router = boxExpressRouter();
		this.router.get( "/auth/google", ( req, res ) => start( req, res, "google" ) );
		this.router.get( "/auth/google/callback", ( req, res ) => callback( req, res, "google" ) );
		this.router.get( "/auth/github", ( req, res ) => start( req, res, "github" ) );
		this.router.get( "/auth/github/callback", ( req, res ) => callback( req, res, "github" ) );
		this.router.get( "/auth/logout", ( req, res ) => logout( req, res ) );

		// Passkey sign-in carries no CSRF token: a post page doesn't mint one
		// for a visitor with no session, and the challenge is already bound to
		// this session and has to be signed by the person's own authenticator.
		var signInLimit = boxExpressRateLimit( { windowMs: 15 * 60000, max: 30 } );
		this.router.post( "/auth/passkey/options", signInLimit, ( req, res ) => passkeySignInOptions( req, res ) );
		this.router.post( "/auth/passkey", signInLimit, ( req, res ) => passkeySignIn( req, res ) );

		// The signed-in person's own account page: their passkeys. Commenters
		// and staff alike. Scoped so the token is only minted for requests
		// that reach it.
		var requireAccount = ( req, res, next ) => _requireAccount( req, res, next );
		this.router.use( "/account", boxExpressCsrf() );
		this.router.get( "/account", requireAccount, ( req, res ) => account( req, res ) );
		this.router.post(
			"/account/passkeys/options",
			requireAccount,
			boxExpressRateLimit( { windowMs: 15 * 60000, max: 20 } ),
			( req, res ) => passkeyRegistrationOptions( req, res )
		);
		this.router.post( "/account/passkeys", requireAccount, ( req, res ) => passkeyRegister( req, res ) );
		this.router.post( "/account/passkeys/:id/delete", requireAccount, ( req, res ) => passkeyRemove( req, res ) );

		// /manage needs a passkey. A password or Google/GitHub sign-in for staff
		// stops at pending_staff and lands here: confirm with one of the
		// account's passkeys, or add the first one if it has none.
		var requirePending = ( req, res, next ) => _requirePendingStaff( req, res, next );
		var stepLimit      = boxExpressRateLimit( { windowMs: 15 * 60000, max: 20 } );
		this.router.use( "/manage/passkey", boxExpressCsrf() );
		this.router.get( "/manage/passkey", requirePending, ( req, res ) => staffPasskeyPage( req, res ) );
		this.router.post( "/manage/passkey/options", requirePending, stepLimit, ( req, res ) => staffPasskeyOptions( req, res ) );
		this.router.post( "/manage/passkey", requirePending, stepLimit, ( req, res ) => staffPasskeyFinish( req, res ) );

		return this;
	}

	// GET /auth/:provider?redirect=<internal path> — begins the OAuth dance.
	function start( req, res, required string provider ){
		var p = variables.providers[ arguments.provider ];
		if ( !p.client.isConfigured() ){
			res.status( 503 ).send( p.label & " sign-in isn't configured." );
			return;
		}

		var state = createUUID();
		req.session.oauthState    = state;
		req.session.oauthProvider = arguments.provider;
		req.session.oauthRedirect = _safeRedirect( req.query.redirect ?: "/" );

		res.redirect( p.client.buildAuthorizationUrl( state ) );
	}

	// GET /auth/:provider/callback?code=...&state=...
	function callback( req, res, required string provider ){
		var p                = variables.providers[ arguments.provider ];
		var expectedState    = req.session.oauthState ?: "";
		var expectedProvider = req.session.oauthProvider ?: "";
		var redirectTo       = req.session.oauthRedirect ?: "/";
		structDelete( req.session, "oauthState" );
		structDelete( req.session, "oauthProvider" );
		structDelete( req.session, "oauthRedirect" );

		var returnedState = req.query.state ?: "";
		var code          = req.query.code  ?: "";

		if ( !len( expectedState ) || !len( returnedState ) || returnedState != expectedState || expectedProvider != arguments.provider ){
			println( "[auth] " & p.label & " OAuth state mismatch from " & req.ip );
			flashSet( req, { loginError: "Sign-in failed — please try again." } );
			res.redirect( "/manage/login" );
			return;
		}

		if ( !len( code ) ){
			// User denied consent, or the provider sent an error instead of a code.
			flashSet( req, { loginError: p.label & " sign-in was cancelled." } );
			res.redirect( "/manage/login" );
			return;
		}

		try {
			var accessToken = p.client.exchangeCodeForToken( code );
			var profile     = p.client.getUserInfo( accessToken );

			if ( !profile.emailVerified || !len( profile.email ) ){
				flashSet( req, { loginError: "That " & p.label & " account's primary email isn't verified." } );
				res.redirect( "/manage/login" );
				return;
			}

			var user = variables.authService.findOrCreateOAuthUser( profile.email, profile.name, profile.pictureUrl );
			if ( user.isEmpty() ){
				flashSet( req, { loginError: "This account has been deactivated." } );
				res.redirect( "/manage/login" );
				return;
			}

			if ( _signIn( req, user, p.label ) == "pending" ){
				res.redirect( "/manage/passkey" );
				return;
			}
			res.redirect( redirectTo );

		} catch ( any e ){
			println( "[error] " & p.label & " OAuth callback failed: " & e.message );
			flashSet( req, { loginError: "Sign-in failed — please try again." } );
			res.redirect( "/manage/login" );
		}
	}

	// POST /auth/passkey/options — no body. The browser's passkey sheet
	// offers whichever passkeys it holds for this site.
	function passkeySignInOptions( req, res ){
		res.json( variables.passkeys.signInOptions( req.session ) );
	}

	// POST /auth/passkey — body: what signWithPasskey() returned, plus
	// redirect (the post to come back to).
	function passkeySignIn( req, res ){
		var body = req.body ?: {};
		try {
			var result = variables.passkeys.verify( req.session, body );
		} catch ( "Passkeys.Invalid" e ){
			println( "[auth] passkey sign-in refused from " & req.ip & ": " & e.message );
			res.status( 401 ).json( { success: false, error: e.message } );
			return;
		}

		var user = variables.authService.findActiveUserById( result.userId );
		if ( user.isEmpty() ){
			res.status( 401 ).json( { success: false, error: "This account has been deactivated." } );
			return;
		}

		var redirectTo = _safeRedirect( body.redirect ?: "/" );
		var outcome    = _signIn( req, user, "passkey" );
		res.json( { success: true, redirect: outcome == "staff" && redirectTo == "/" ? "/manage" : redirectTo } );
	}

	// GET /account
	function account( req, res ){
		var flash = req.session._flash ?: {};
		structDelete( req.session, "_flash" );
		var me = _accountUser( req );
		res.render( "account/index", {
			pageTitle     : "Your account",
			me            : me,
			passkeys      : variables.passkeys.getStore().listForUser( me.id ),
			accountNotice : flash.accountNotice ?: "",
			csrfToken     : req.csrfToken()
		} );
	}

	// POST /account/passkeys/options
	function passkeyRegistrationOptions( req, res ){
		var me = _accountUser( req );
		try {
			res.json( variables.passkeys.registrationOptions( { id: me.id, name: me.email, displayName: me.display_name }, req.session ) );
		} catch ( "Passkeys.Invalid" e ){
			res.status( 400 ).json( { success: false, error: e.message } );
		}
	}

	// POST /account/passkeys — body: what createPasskey() returned.
	function passkeyRegister( req, res ){
		var me   = _accountUser( req );
		var body = req.body ?: {};
		body.name = left( trim( body.name ?: "" ), 100 );
		try {
			var credential = variables.passkeys.register( { id: me.id }, req.session, body );
		} catch ( "Passkeys.Invalid" e ){
			res.status( 400 ).json( { success: false, error: e.message } );
			return;
		}
		println( "[auth] passkey added for '" & me.email & "' from " & req.ip );
		res.json( { success: true, name: credential.name } );
	}

	// POST /account/passkeys/:id/delete — a plain form post.
	function passkeyRemove( req, res ){
		var store      = variables.passkeys.getStore();
		var credential = store.findByCredentialId( req.params.id ?: "" );
		var me         = _accountUser( req );
		if ( !isNull( credential ) && credential.userId == me.id ){
			// Staff with no passkey could add one with just a password, so
			// they always keep at least one.
			if ( me.isStaff && store.listForUser( me.id ).len() <= 1 ){
				req.session._flash = { accountNotice: "This is your only passkey, and the dashboard needs one. Add another before removing it." };
			} else {
				store.remove( credential.credentialId );
				req.session._flash = { accountNotice: "Passkey removed." };
			}
		}
		res.redirect( "/account" );
	}

	// GET /manage/passkey
	function staffPasskeyPage( req, res ){
		var pending = req.session.pending_staff;
		res.render( "manage/passkey", {
			pageTitle : "Confirm with your passkey",
			pending   : pending,
			enroll    : !variables.passkeys.getStore().listForUser( pending.id ).len(),
			csrfToken : req.csrfToken()
		} );
	}

	// POST /manage/passkey/options
	function staffPasskeyOptions( req, res ){
		var pending = req.session.pending_staff;
		try {
			if ( variables.passkeys.getStore().listForUser( pending.id ).len() ){
				res.json( { mode: "confirm", options: variables.passkeys.signInOptions( req.session, pending.id ) } );
			} else {
				res.json( {
					mode   : "enroll",
					options: variables.passkeys.registrationOptions( { id: pending.id, name: pending.email, displayName: pending.display_name }, req.session )
				} );
			}
		} catch ( "Passkeys.Invalid" e ){
			res.status( 400 ).json( { success: false, error: e.message } );
		}
	}

	// POST /manage/passkey — body: what signWithPasskey() returned (confirm)
	// or what createPasskey() returned (enroll, only while the account has
	// no passkey).
	function staffPasskeyFinish( req, res ){
		var pending = req.session.pending_staff;
		var body    = req.body ?: {};
		try {
			if ( variables.passkeys.getStore().listForUser( pending.id ).len() ){
				variables.passkeys.verify( req.session, body );
			} else {
				body.name = left( trim( body.name ?: "" ), 100 );
				variables.passkeys.register( { id: pending.id }, req.session, body );
				println( "[auth] first passkey added for '" & pending.email & "' from " & req.ip );
			}
		} catch ( "Passkeys.Invalid" e ){
			println( "[auth] staff passkey step refused for '" & pending.email & "' from " & req.ip & ": " & e.message );
			res.status( 401 ).json( { success: false, error: e.message } );
			return;
		}

		var user = variables.authService.findActiveUserById( pending.id );
		if ( user.isEmpty() || ( user.role != "admin" && user.role != "author" ) ){
			structDelete( req.session, "pending_staff" );
			res.status( 401 ).json( { success: false, error: "This account can't sign in." } );
			return;
		}
		_signIn( req, user, "passkey" );
		res.json( { success: true, redirect: "/manage" } );
	}

	// GET /auth/logout?redirect=<internal path> — clears a commenter
	// session only; CMS logout stays at /manage/logout (routes/Manage.bx)
	// since the two sessions are independent (a commenter session never
	// grants manage_user, so there's nothing here for the CMS logout route
	// to clean up, and vice versa). redirect lets the comment UI send
	// someone back to the post they signed out from, same as start()'s own
	// redirect param — defaults to "/" if omitted or unsafe.
	function logout( req, res ){
		structDelete( req.session, "commenter" );
		res.redirect( _safeRedirect( req.query.redirect ?: "/" ) );
	}

	// Starts a fresh session for `user` (a struct from AuthService). Returns
	// "staff" (CMS session, only ever via a passkey), "pending" (staff who
	// signed in another way: next is /manage/passkey) or "commenter".
	private string function _signIn( req, required struct user, required string method ){
		req.regenerateSession();

		if ( user.role == "admin" || user.role == "author" ){
			var staff = {
				"id"           : user.id,
				"display_name" : user.display_name,
				"email"        : user.email,
				"role"         : user.role
			};
			if ( arguments.method != "passkey" ){
				req.session.pending_staff = staff;
				println( "[auth] " & arguments.method & " accepted for '" & user.email & "' from " & req.ip & ", passkey step next" );
				return "pending";
			}
			staff[ "passkey" ] = true;
			req.session.manage_user = staff;
			println( "[auth] successful passkey sign-in for '" & user.email & "' from " & req.ip );
			return "staff";
		}

		req.session.commenter = {
			"id"          : user.id,
			"display_name": user.display_name,
			"email"       : user.email,
			"avatar_url"  : user.avatar_url ?: ""
		};
		println( "[auth] " & arguments.method & " sign-in (commenter) for '" & user.email & "' from " & req.ip );
		return "commenter";
	}

	// Staff (manage_user) or commenter: { id, email, display_name, isStaff }.
	private struct function _accountUser( req ){
		var staff = req.session.manage_user ?: "";
		if ( len( staff ) ){
			return { "id": staff.id, "email": staff.email, "display_name": staff.display_name, "isStaff": true };
		}
		var c = req.session.commenter;
		return { "id": c.id, "email": c.email, "display_name": c.display_name, "isStaff": false };
	}

	private function _requirePendingStaff( req, res, next ){
		if ( !len( req.session.pending_staff ?: "" ) ){
			if ( req.method == "GET" ){
				res.redirect( len( req.session.manage_user ?: "" ) ? "/manage" : "/manage/login" );
			} else {
				res.status( 401 ).json( { success: false, error: "Sign in again." } );
			}
			return;
		}
		next();
	}

	private function _requireAccount( req, res, next ){
		if ( !len( req.session.manage_user ?: "" ) && !len( req.session.commenter ?: "" ) ){
			if ( req.method == "GET" ){
				res.redirect( "/" );
			} else {
				res.status( 401 ).json( { success: false, error: "Sign in first." } );
			}
			return;
		}
		next();
	}

	// Only an internal, same-origin path is ever safe to redirect to after
	// login — req.query.redirect is attacker-controlled input (a crafted
	// link), so an absolute or protocol-relative URL here would be an open
	// redirect straight off a login flow, a classic phishing vector.
	private function _safeRedirect( required string path ){
		var p = trim( arguments.path );
		if ( !len( p ) ) return "/";
		if ( left( p, 1 ) != "/" ) return "/";
		if ( left( p, 2 ) == "//" ) return "/";
		if ( left( p, 2 ) == "/\" ) return "/";
		if ( findNoCase( "://", p ) ) return "/";
		return p;
	}

	// Same session-backed flash as routes/Manage.bx's showLogin() reads —
	// duplicated rather than shared for two call sites across two small
	// route files; not worth a shared util yet.
	private function flashSet( req, required struct data ){
		req.session._flash = arguments.data;
	}

}

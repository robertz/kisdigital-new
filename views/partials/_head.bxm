<bx:output><!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-NG47J3H3M8"></script>
<script>
	window.dataLayer = window.dataLayer || [];
	function gtag(){dataLayer.push(arguments);}
	gtag('js', new Date());

	gtag('config', 'G-NG47J3H3M8');
</script>

<!--- Theme + manage-sidebar init: runs before render to prevent a flash of
      the wrong state — data-manage-nav-collapsed is inert outside
      /manage (there's no .c-manage-nav for it to style there), so setting
      it unconditionally on every page costs nothing. --->
<script>(function(){var t=localStorage.getItem('theme');if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme: dark)').matches)){document.documentElement.setAttribute('data-theme','dark');}else if(t==='light'){document.documentElement.setAttribute('data-theme','light');}if(localStorage.getItem('manageNavCollapsed')==='1'){document.documentElement.setAttribute('data-manage-nav-collapsed','true');}})();</script>

<title>#encodeForHTML( len( data.pageTitle ?: "" ) ? data.pageTitle & " | " & data.siteName : data.siteName )#</title>

<bx:if len( data.canonicalUrl ?: "" )>
<link rel="canonical" href="#encodeForHTMLAttribute( data.canonicalUrl )#">
</bx:if>

<bx:if structKeyExists( data, "meta" )>
	<bx:loop collection="#data.meta#" item="metaName">
		<bx:if len( trim( data.meta[ metaName ] ) )>
		<meta name="#lCase( metaName )#" property="#lCase( metaName )#" content="#encodeForHTMLAttribute( data.meta[ metaName ] )#">
		</bx:if>
	</bx:loop>
</bx:if>

<!--- Favicons --->
<link rel="icon" type="image/svg+xml" href="/assets/images/kisdigital-brand.svg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<!--- iOS ignores SVG here — needs a real PNG, no transparency (iOS applies its own corner rounding/shine). --->
<link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">
<link rel="apple-touch-icon-precomposed" href="/assets/images/apple-touch-icon-precomposed.png">

<!--- Resource hints --->
<!--- jsdelivr dropped: Bootstrap + Bootstrap Icons are now compiled into
      site.css at build time (see public/assets/scss/bootstrap-custom.scss
      and scripts/build-icons.mjs) instead of pulled from a CDN — a trimmed
      subset of each (only what this site actually uses), self-hosted so
      there's no separate-origin round trip and this app controls the
      cache lifetime instead of jsdelivr's. --->
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<!--- CSS --->
<!--- Google Fonts is the only remaining third-party stylesheet — separate
      origin (DNS+TLS+download before first paint) and not needed for
      first paint (site.css's own font stack covers it until swapped in),
      so it uses the same media=print swap trick already applied to the
      Prism theme below, plus a <noscript> fallback for when there's no JS
      to flip the media attribute. site.css itself stays render-blocking
      (small, same-origin, needed for the header/layout to not flash
      unstyled). --->
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"></noscript>
<!--- Only styles code blocks, and prism.min.js below is already deferred
      (so highlighting doesn't apply until after load regardless) — load
      this off the critical rendering path via the standard media=print
      swap trick instead of blocking first paint on every page for it.
      Gated on data.hasCodeBlocks — only routes/Posts.bx's show() sets it
      (true when the post's raw markdown actually contains a ``` fence) —
      so no other page pays for Prism's CSS+JS at all. --->
<bx:if data.hasCodeBlocks ?: false>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism-themes/1.9.0/prism-one-dark.min.css" integrity="sha512-c6S8OdtvoqZCbMfA1lWE0qd368pLdFvVHVILQzNizfowC+zV8rmVKdSlmL5SuidvATO0A7awDg53axd+s/9amw==" crossorigin="anonymous" referrerpolicy="no-referrer" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism-themes/1.9.0/prism-one-dark.min.css"></noscript>
</bx:if>
<link rel="stylesheet" href="#data.cssHref#">

<!--- Deferred JS --->
<!--- jQuery dropped: nothing on the site actually used it — its one would-be
      consumer, public/assets/js/youtube.js, was never <script>-included
      anywhere (dead file, removed alongside this). --->
<bx:if data.hasCodeBlocks ?: false>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.23.0/prism.min.js" integrity="sha512-YBk7HhgDZvBxmtOfUdvX0z8IH2d10Hp3aEygaMNhtF8fSOvBZ16D/1bXZTJV6ndk/L/DlXxYStP8jrF77v2MIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
</bx:if>
</head>
<body>

<a class="skip-link" href="##main-content">Skip to content</a>

<header class="header">
	<div class="container">
		<div class="header__inner">
			<a href="/" class="header__logo">
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 52" class="header__logo-img" aria-label="KISDigital" role="img">
					<text x="0" y="40" font-family="'Inter', 'Noto Sans', Arial, sans-serif" font-size="42" font-weight="800" letter-spacing="-1">
						<tspan class="header__logo-kis" fill="currentColor">KIS</tspan><tspan class="header__logo-accent" fill="currentColor">Digital</tspan>
					</text>
				</svg>
			</a>
			<div class="header__spacer"></div>
			<form method="get" action="/search" class="header-search" role="search">
				<i class="bi bi-search header-search__icon" aria-hidden="true"></i>
				<input type="search" name="q" class="header-search__input" placeholder="Search…" aria-label="Search articles">
			</form>
			<nav class="header-actions">
				<a href="/posts" class="header__link">Articles</a>
				<a href="/projects" class="header__link">Projects</a>
				<a href="/games" class="header__link">Games</a>
				<a href="/about" class="header__link">About</a>
				<bx:if len( data.manageUser ?: "" )>
					<a href="/manage" class="header__link">Dashboard</a>
				</bx:if>
			</nav>
			<button class="header-icon-button" id="theme-toggle" aria-label="Toggle colour theme">
				<i class="bi bi-moon-fill" id="theme-icon"></i>
			</button>
			<button class="header-icon-button header-menu-toggle" id="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
				<i class="bi bi-list" id="mobile-menu-icon"></i>
			</button>
		</div>
	</div>

	<!--- Mobile-only dropdown: search + nav links that .header-search/.header-actions
	      hide below 768px (no room for them inline — see site.css). Toggled by the
	      hamburger button above; JS lives in _foot.bxm next to the theme toggle. --->
	<div class="mobile-menu" id="mobile-menu" hidden>
		<form method="get" action="/search" class="mobile-menu__search" role="search">
			<i class="bi bi-search mobile-menu__search-icon" aria-hidden="true"></i>
			<input type="search" name="q" class="mobile-menu__search-input" placeholder="Search articles…" aria-label="Search articles">
		</form>
		<nav class="mobile-menu__links">
			<a href="/posts" class="mobile-menu__link">
				<i class="bi bi-file-text"></i> Articles
			</a>
			<a href="/projects" class="mobile-menu__link">
				<i class="bi bi-boxes"></i> Projects
			</a>
			<a href="/games" class="mobile-menu__link">
				<i class="bi bi-joystick"></i> Games
			</a>
			<a href="/about" class="mobile-menu__link">
				<i class="bi bi-person"></i> About
			</a>
			<bx:if len( data.manageUser ?: "" )>
				<a href="/manage" class="mobile-menu__link">
					<i class="bi bi-speedometer2"></i> Dashboard
				</a>
			</bx:if>
		</nav>
	</div>
</header>

<main id="main-content" tabindex="-1">
</bx:output>

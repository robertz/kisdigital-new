	</a>
	<a href="/manage/authors" class="c-manage-nav__link #( ( data.manageSection ?: '' ) == 'authors' ? 'c-manage-nav__link--active' : '' )#">
		<i class="bi bi-people"></i> Authors
	</a>
	<a href="/manage/media" class="c-manage-nav__link #( ( data.manageSection ?: '' ) == 'media' ? 'c-manage-nav__link--active' : '' )#">

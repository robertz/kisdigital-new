<bx:set primaryTag = post.getPrimaryTag()>
<bx:output>
<article class="post-row">
	<a href="#post.getPostUrl()#" class="post-row__media" tabindex="-1" aria-hidden="true">
		<bx:if len( post.getCoverImage() )>
			<img src="#encodeForHTMLAttribute( post.getCoverImage() )#" alt="" loading="lazy">
		<bx:else>
			<span class="post-tile__fallback">#encodeForHTML( len( primaryTag ) ? primaryTag : "kisdigital" )#</span>
		</bx:if>
	</a>
	<div class="post-row__body">
		<bx:if len( primaryTag )>
		<a href="/tag/#encodeForURL( primaryTag )#" class="post-kicker">#encodeForHTML( primaryTag )#</a>
		</bx:if>
		<h3 class="post-row__title">
			<a href="#post.getPostUrl()#">#encodeForHTML( post.getTitle() )#</a>
			<bx:if post.getFeatured()>
				<i class="bi bi-star-fill post-row__featured" title="Featured"></i>
			</bx:if>
		</h3>
		<bx:if len( post.getDescription() )>
		<p class="post-row__excerpt">#encodeForHTML( post.getDescription() )#</p>
		</bx:if>
		<p class="post-byline">
			<bx:if len( post.getAuthorName() )><span class="post-byline__name">#encodeForHTML( post.getAuthorName() )#</span></bx:if>
			<time>#dateFormat( post.getPublishDate(), "MMMM D, YYYY" )#</time>
		</p>
	</div>
</article>
</bx:output>

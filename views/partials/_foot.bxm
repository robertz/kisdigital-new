<bx:output>
</main>

<footer class="c-site-footer">
	<div class="container">
		<div class="c-site-footer__inner">
			<span>&copy; #year( now() )# KISDigital</span>
			<nav class="c-site-footer__links">
				<a href="/about">About</a>
				<a href="/privacy">Privacy</a>
				<a href="/terms">Terms</a>
			</nav>
		</div>
	</div>
</footer>

<!--- Popper + Bootstrap's JS bundle dropped: nothing in this codebase uses
      any Bootstrap JS component (no data-bs-* markup, no JS instantiating
      Modal/Dropdown/Tooltip/etc. anywhere) — only Bootstrap's CSS classes
      are used, and those are already self-hosted/trimmed (see
      public/assets/scss/bootstrap-custom.scss). Popper was only ever a
      dependency of that unused JS bundle. --->
<script src="#data.jsHref#"></script>

<script>
(function () {
	var html   = document.documentElement;
	var toggle = document.getElementById('theme-toggle');
	var icon   = document.getElementById('theme-icon');

	function applyTheme(theme) {
		html.setAttribute('data-theme', theme);
		localStorage.setItem('theme', theme);
		icon.className = theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
	}

	icon.className = html.getAttribute('data-theme') === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-fill';

	toggle.addEventListener('click', function () {
		applyTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
	});
})();

(function () {
	var menuToggle = document.getElementById('mobile-menu-toggle');
	var menuIcon   = document.getElementById('mobile-menu-icon');
	var menu       = document.getElementById('mobile-menu');
	if (!menuToggle || !menu) return;

	function closeMenu() {
		menu.hidden = true;
		menuToggle.setAttribute('aria-expanded', 'false');
		menuIcon.className = 'bi bi-list';
	}

	function openMenu() {
		menu.hidden = false;
		menuToggle.setAttribute('aria-expanded', 'true');
		menuIcon.className = 'bi bi-x-lg';
	}

	menuToggle.addEventListener('click', function () {
		if (menu.hidden) { openMenu(); } else { closeMenu(); }
	});

	// A same-page link (e.g. "Articles" while already on /posts) doesn't
	// navigate, which would otherwise leave the menu stuck open.
	menu.querySelectorAll('a').forEach(function (link) {
		link.addEventListener('click', closeMenu);
	});

	document.addEventListener('keydown', function (e) {
		if (e.key === 'Escape' && !menu.hidden) closeMenu();
	});

	// Collapsing back to desktop width with the menu open would otherwise
	// leave it stuck visible (it's plain content flow once un-hidden, not
	// conditioned on viewport) — the width query mirrors the CSS breakpoint.
	var desktopQuery = window.matchMedia('(min-width: 768px)');
	desktopQuery.addEventListener('change', function (e) {
		if (e.matches && !menu.hidden) closeMenu();
	});
})();
</script>

</body>
</html>
</bx:output>

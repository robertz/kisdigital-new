<bx:include template="../partials/_head.bxm">
<bx:output>
<!--- Page header --->
<header class="c-posts-header">
	<div class="container">
		<p class="c-posts-header__eyebrow mb-1">Search</p>
		<bx:if len( data.q )>
			<h1 class="c-posts-header__title mb-2">&ldquo;#encodeForHTML( data.q )#&rdquo;</h1>
			<p class="c-posts-header__count mb-0">
				#data.paging.total# #( data.paging.total == 1 ? "result" : "results" )#, sorted by relevance
			</p>
		<bx:else>
			<h1 class="c-posts-header__title mb-2">Search articles</h1>
		</bx:if>

		<form method="get" action="/search" class="c-search-form mt-4" role="search">
			<input
				type="search"
				name="q"
				class="c-search-form__input"
				value="#encodeForHTMLAttribute( data.q )#"
				placeholder="Search titles, descriptions, and post bodies…"
				autofocus>
			<button type="submit" class="c-search-form__submit">
				<i class="bi bi-search"></i> Search
			</button>
		</form>
	</div>
</header>

<!--- Content --->
<section class="py-5 posts-section">
	<div class="container">
		<div class="row g-5">

			<!--- Results --->
			<div class="col-lg-8">
				<bx:if !len( data.q )>
					<p class="text-muted">Enter a search term above to get started.</p>
				<bx:elseif data.paging.posts.len()>

					<div class="post-list">
						<bx:loop array="#data.paging.posts#" item="post" index="cardIndex">
							<bx:include template="../partials/postCard.bxm">
						</bx:loop>
					</div>

					<!--- Pagination --->
					<bx:if data.paging.totalPages gt 1>
					<nav class="c-pagination" aria-label="Search result pages">
						<a href="/search?q=#encodeForURL( data.q )#&page=#data.paging.page - 1#"
							class="c-pagination__btn #( data.paging.page lte 1 ? 'c-pagination__btn--disabled' : '' )#"
							aria-label="Previous page">
							<i class="bi bi-chevron-left"></i>
						</a>

						<bx:loop from="1" to="#data.paging.totalPages#" index="p">
							<a href="/search?q=#encodeForURL( data.q )#&page=#p#"
								class="c-pagination__btn #( p == data.paging.page ? 'c-pagination__btn--active' : '' )#">
								#p#
							</a>
						</bx:loop>

						<a href="/search?q=#encodeForURL( data.q )#&page=#data.paging.page + 1#"
							class="c-pagination__btn #( data.paging.page gte data.paging.totalPages ? 'c-pagination__btn--disabled' : '' )#"
							aria-label="Next page">
							<i class="bi bi-chevron-right"></i>
						</a>
					</nav>
					</bx:if>

				<bx:else>
					<p class="text-muted">No articles match &ldquo;#encodeForHTML( data.q )#&rdquo;. Try a different term, or <a href="/posts">browse all articles</a>.</p>
				</bx:if>
			</div>

			<!--- Sidebar --->
			<div class="col-lg-4">

				<!--- Trending --->
				<bx:include template="../partials/trendingSidebar.bxm">

				<!--- Tags --->
				<bx:include template="../partials/tagsSidebar.bxm">

			</div>

		</div>
	</div>
</section>
</bx:output>
<bx:include template="../partials/_foot.bxm">

<bx:output>
<div class="container">
	<div class="narrow">
		<header class="page-head">
			<h1 class="page-head__title">Search</h1>
			<form method="get" action="/search" class="search-box" role="search">
				<input type="search" name="q" class="search-box__input" value="#encodeForHTMLAttribute( data.q )#" placeholder="Search titles, summaries and articles" aria-label="Search articles" autofocus>
				<button type="submit" class="search-box__submit">Search</button>
			</form>
			<bx:if ( data.retryAfter ?: 0 ) GT 0>
			<p class="page-head__lede">That's a lot of searching. Give it #data.retryAfter# #( data.retryAfter == 1 ? "second" : "seconds" )# and try again.</p>
			<bx:elseif len( data.q )>
			<p class="page-head__lede">#data.paging.total# #( data.paging.total == 1 ? "result" : "results" )# for &ldquo;#encodeForHTML( data.q )#&rdquo;, most relevant first.</p>
			</bx:if>
		</header>

		<bx:if ( data.topics ?: [] ).len()>
			<p class="topic-match">
				<span class="topic-match__label">#( data.topics.len() == 1 ? "Topic" : "Topics" )#</span>
				<bx:loop array="#data.topics#" item="topic">
					<a href="/tag/#encodeForURL( topic.tag )#" class="topic-match__link">#encodeForHTML( topic.tag )# <span class="topic-match__count">#topic.post_count#</span></a>
				</bx:loop>
			</p>
		</bx:if>

		<bx:if len( data.q ) && data.paging.posts.len()>
			<div class="entry-list">
				<bx:loop array="#data.paging.posts#" item="post">
					#partial( "partials/postEntry", { post: post } )#
				</bx:loop>
			</div>
			#partial( "partials/pagination", { pageBase: "/search?q=" & encodeForURL( data.q ) } )#
		<bx:elseif len( data.q ) && !( data.retryAfter ?: 0 )>
			<p class="page-head__lede">Nothing matched. Try a different term, or <a href="/posts">browse all writing</a>.</p>
		</bx:if>
	</div>
</div>
</bx:output>

<bx:include template="../partials/_head.bxm">
<bx:output>
<div class="container">
	<div class="narrow">
		<header class="page-head">
			<h1 class="page-head__title">Search</h1>
			<form method="get" action="/search" class="search-box" role="search">
				<input type="search" name="q" class="search-box__input" value="#encodeForHTMLAttribute( data.q )#" placeholder="Search titles, summaries and articles" aria-label="Search articles" autofocus>
				<button type="submit" class="search-box__submit">Search</button>
			</form>
			<bx:if len( data.q )>
			<p class="page-head__lede">#data.paging.total# #( data.paging.total == 1 ? "result" : "results" )# for &ldquo;#encodeForHTML( data.q )#&rdquo;, most relevant first.</p>
			</bx:if>
		</header>

		<bx:if len( data.q ) && data.paging.posts.len()>
			<div class="entry-list">
				<bx:loop array="#data.paging.posts#" item="post">
					<bx:include template="../partials/postEntry.bxm">
				</bx:loop>
			</div>
			<bx:set pageBase = "/search?q=" & encodeForURL( data.q )>
			<bx:include template="../partials/pagination.bxm">
		<bx:elseif len( data.q )>
			<p class="page-head__lede">Nothing matched. Try a different term, or <a href="/posts">browse all writing</a>.</p>
		</bx:if>
	</div>
</div>
</bx:output>
<bx:include template="../partials/_foot.bxm">

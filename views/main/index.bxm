<bx:include template="../partials/_head.bxm">
<bx:output>
<div class="container">
	<div class="narrow">

		<section class="intro">
			<h1 class="intro__title">Robert Zehnder</h1>
			<p class="intro__lede">I write about BoxLang, CFML and the JVM web stack, and build open-source modules and apps with them. This is where the notes, the deep dives and the projects live.</p>
		</section>

		<section class="home-block">
			<div class="block-head">
				<h2 class="block-head__title">Recent writing</h2>
				<a href="/posts" class="block-head__more">All writing &rarr;</a>
			</div>
			<div class="entry-list">
				<bx:loop array="#data.recentPosts#" item="post">
					<bx:include template="../partials/postEntry.bxm">
				</bx:loop>
			</div>
		</section>

		<section class="home-block">
			<div class="block-head">
				<h2 class="block-head__title">Selected projects</h2>
				<a href="/projects" class="block-head__more">All projects &rarr;</a>
			</div>
			<div class="feature-list">
				<bx:loop array="#data.featuredProjects#" item="project">
					<bx:include template="../partials/projectFeature.bxm">
				</bx:loop>
			</div>
		</section>

	</div>
</div>
</bx:output>
<bx:include template="../partials/_foot.bxm">

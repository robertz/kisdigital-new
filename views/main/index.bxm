<bx:include template="../partials/_head.bxm">
<bx:set leadPost  = data.leadPost>
<bx:set gridPosts = data.gridPosts>
<bx:output>
<h1 class="sr-only">KISDigital — ColdFusion, Lucee &amp; BoxLang</h1>

<bx:if isObject( leadPost )>
<section class="home-lead">
	<div class="container">
		<div class="home-lead__grid">
			<a href="#leadPost.getPostUrl()#" class="home-lead__media" tabindex="-1" aria-hidden="true">
				<bx:if len( leadPost.getCoverImage() )>
					<bx:set coverSrc = leadPost.getCoverImage()>
					<bx:set coverIsLead = true>
					<bx:include template="../partials/coverImage.bxm">
				<bx:else>
					<span class="post-tile__fallback">#encodeForHTML( len( leadPost.getPrimaryTag() ) ? leadPost.getPrimaryTag() : "kisdigital" )#</span>
				</bx:if>
			</a>
			<div class="home-lead__body">
				<span class="home-lead__badge">#data.leadIsFeatured ? "Featured" : "Latest"#</span>
				<h2 class="home-lead__title"><a href="#leadPost.getPostUrl()#">#encodeForHTML( leadPost.getTitle() )#</a></h2>
				<bx:if len( leadPost.getDescription() )>
				<p class="home-lead__dek">#encodeForHTML( leadPost.getDescription() )#</p>
				</bx:if>
				<p class="post-byline post-byline--stacked">
					<bx:if len( leadPost.getAuthorName() )><span class="post-byline__name">#encodeForHTML( leadPost.getAuthorName() )#</span></bx:if>
					<time>#dateFormat( leadPost.getPublishDate(), "MMMM D, YYYY" )#</time>
				</p>
			</div>
		</div>
	</div>
</section>
</bx:if>

<bx:if gridPosts.len()>
<section class="home-section">
	<div class="container">
		<div class="tile-grid">
			<bx:set tileTag = "">
			<bx:loop array="#gridPosts#" item="post">
				<bx:include template="../partials/postTile.bxm">
			</bx:loop>
		</div>
	</div>
</section>
</bx:if>

<section class="home-section" id="follow">
	<div class="container">
		<div class="follow-band">
			<div>
				<h2 class="follow-band__title">Follow along</h2>
				<p class="follow-band__text">New articles on BoxLang, CFML and the JVM web stack, wherever you already read.</p>
			</div>
			<div class="follow-band__options">
				<div class="follow-band__option">
					<span>Mastodon and the fediverse</span>
					<code>@blog@kisdigital.com</code>
				</div>
				<a href="/rss" class="follow-band__option">
					<span>RSS feed</span>
					<code>/rss</code>
				</a>
			</div>
		</div>
	</div>
</section>

<bx:if data.mostReadPosts.len()>
<section class="home-section">
	<div class="container">
		<div class="section-head">
			<div>
				<h2 class="section-head__title">Most read</h2>
				<p class="section-head__text">What readers keep coming back to.</p>
			</div>
			<a href="/posts" class="section-head__more">All articles <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
		</div>
		<div class="tile-grid">
			<bx:set tileTag = "">
			<bx:loop array="#data.mostReadPosts#" item="post">
				<bx:include template="../partials/postTile.bxm">
			</bx:loop>
		</div>
	</div>
</section>
</bx:if>

<bx:if data.projects.len()>
<section class="home-section">
	<div class="container">
		<div class="section-head">
			<div>
				<h2 class="section-head__title">Projects</h2>
				<p class="section-head__text">Open-source modules and tools, documented here.</p>
			</div>
			<a href="/projects" class="section-head__more">All projects <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
		</div>
		<div class="tile-grid">
			<bx:loop array="#data.projects#" item="project">
				<bx:include template="../partials/projectTile.bxm">
			</bx:loop>
		</div>
	</div>
</section>
</bx:if>

<bx:if data.archivePosts.len()>
<section class="home-section">
	<div class="container">
		<div class="section-head">
			<div>
				<h2 class="section-head__title">From the archive</h2>
				<p class="section-head__text">Older posts worth another look. A new pick each day.</p>
			</div>
			<a href="/posts" class="section-head__more">All articles <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
		</div>
		<div class="tile-grid">
			<bx:set tileTag = "">
			<bx:loop array="#data.archivePosts#" item="post">
				<bx:include template="../partials/postTile.bxm">
			</bx:loop>
		</div>
	</div>
</section>
</bx:if>

<section class="home-section">
	<div class="container">
		<div class="section-head">
			<div>
				<h2 class="section-head__title">Topics</h2>
				<p class="section-head__text">Browse everything by tag.</p>
			</div>
			<a href="/posts" class="section-head__more">All articles <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
		</div>
		<div class="tag-cloud">
			<bx:loop array="#data.allTags#" item="tagRow">
				<a href="/tag/#encodeForURL( tagRow.tag )#" class="tag-badge">#encodeForHTML( tagRow.tag )#<span class="tag-badge__count">#tagRow.post_count#</span></a>
			</bx:loop>
		</div>
	</div>
</section>
</bx:output>
<bx:include template="../partials/_foot.bxm">

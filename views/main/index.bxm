<bx:output>
<div class="container">
	<div class="narrow">

		<section class="intro">
			<h1 class="intro__title">Robert Zehnder</h1>
			<p class="intro__lede">I write about BoxLang, CFML and the JVM web stack, and build open-source modules and apps with them. This is where the notes, the deep dives and the projects live.</p>
		</section>

		<section class="home-block">
			<div class="block-head">
				<h2 class="block-head__title">Recent writing</h2>
				<a href="/posts" class="block-head__more">All writing &rarr;</a>
			</div>
			<div class="entry-list">
				<bx:loop array="#data.recentPosts#" item="post">
					#partial( "partials/postEntry", { post: post } )#
				</bx:loop>
			</div>
		</section>

		<bx:if data.topics.len()>
		<section class="home-block">
			<div class="block-head">
				<h2 class="block-head__title">Topics</h2>
				<a href="/tags" class="block-head__more">All topics &rarr;</a>
			</div>
			<nav class="topic-filter topic-filter--plain" aria-label="Topics">
				<bx:loop array="#data.topics#" item="topic">
					<a href="/tag/#encodeForURL( topic.tag )#" class="topic-filter__link">#encodeForHTML( topic.tag )#</a>
				</bx:loop>
			</nav>
		</section>
		</bx:if>

		<section class="home-block">
			<div class="block-head">
				<h2 class="block-head__title">Selected projects</h2>
				<a href="/projects" class="block-head__more">All projects &rarr;</a>
			</div>
			<div class="feature-list">
				<bx:loop array="#data.featuredProjects#" item="project">
					#partial( "partials/projectFeature", { project: project } )#
				</bx:loop>
			</div>
		</section>

		<bx:if len( data.season )>
			#partial( "partials/seasonal" )#
		</bx:if>

	</div>
</div>
</bx:output>

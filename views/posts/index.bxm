<bx:include template="../partials/_head.bxm">
<bx:output>
<div class="container">
	<div class="narrow">
		<header class="page-head">
			<h1 class="page-head__title">Writing</h1>
			<p class="page-head__lede">#data.paging.total# #( data.paging.total == 1 ? "article" : "articles" )# on BoxLang, CFML, the JVM and the tools around them.</p>
		</header>

		<bx:include template="../partials/topicFilter.bxm">

		<bx:if data.paging.posts.len()>
			<div class="entry-list">
				<bx:loop array="#data.paging.posts#" item="post">
					<bx:include template="../partials/postEntry.bxm">
				</bx:loop>
			</div>
			<bx:set pageBase = "/posts">
			<bx:include template="../partials/pagination.bxm">
		<bx:else>
			<p class="page-head__lede">No articles published yet.</p>
		</bx:if>
	</div>
</div>
</bx:output>
<bx:include template="../partials/_foot.bxm">

<bx:include template="../partials/_head.bxm">
<bx:output>
<div class="container py-5">
	<div class="c-docs">
		<nav class="c-docs-nav">
			<span class="c-docs-nav__heading">#encodeForHTML( data.projectName )# Docs</span>
			<bx:set navGroup = "">
			<bx:loop array="#data.docs#" item="doc">
				<bx:if len( doc.group ?: "" ) && doc.group != navGroup>
					<bx:set navGroup = doc.group>
					<span class="c-docs-nav__group">#encodeForHTML( doc.group )#</span>
				</bx:if>
				<a href="/projects/#data.projectSlug#/docs/#doc.page_slug#" class="c-docs-nav__link #( doc.page_slug == data.currentSlug ? 'c-docs-nav__link--active' : '' )#">#encodeForHTML( doc.title )#</a>
			</bx:loop>
		</nav>
		<div class="c-docs-content">
			<div class="c-post__body c-docs-body">
				#data.docBodyHtml#
			</div>
			<div class="c-docs-pager">
				<bx:if isStruct( data.prevDoc ) && data.prevDoc.keyExists( "page_slug" )>
				<a href="/projects/#data.projectSlug#/docs/#data.prevDoc.page_slug#">&larr; #encodeForHTML( data.prevDoc.title )#</a>
				<bx:else>
				<span></span>
				</bx:if>
				<bx:if isStruct( data.nextDoc ) && data.nextDoc.keyExists( "page_slug" )>
				<a href="/projects/#data.projectSlug#/docs/#data.nextDoc.page_slug#" class="c-docs-pager__next">#encodeForHTML( data.nextDoc.title )# &rarr;</a>
				</bx:if>
			</div>
		</div>
	</div>
</div>
<script>
// With a long docs list the current page's link can sit below the sidebar's
// fold (or off the end of the horizontal bar on a phone). Scroll the sidebar
// itself, not the page, so that link is in view.
(function(){
	var nav = document.querySelector('.c-docs-nav');
	var active = nav && nav.querySelector('.c-docs-nav__link--active');
	if (!active) return;
	var navBox = nav.getBoundingClientRect();
	var linkBox = active.getBoundingClientRect();
	nav.scrollTop  += linkBox.top - navBox.top - ( nav.clientHeight - linkBox.height ) / 2;
	nav.scrollLeft += linkBox.left - navBox.left - ( nav.clientWidth - linkBox.width ) / 2;
})();
</script>
</bx:output>
<bx:include template="../partials/_foot.bxm">

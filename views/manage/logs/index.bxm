<bx:include template="../../partials/_head.bxm">
<bx:output>
<!--- Alpine powers this page's table only (client-side sort + quick filter
over whatever's already on the current server-rendered page) — not loaded
site-wide, just here where it's actually used. --->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.16.2/dist/cdn.min.js" integrity="sha384-hTDKg8MgHALzleab34+W1b6UpW6tektVmHXleL5Ztz8x2WFIJeaJp6ixjNBjbrDY" crossorigin="anonymous"></script>

<div class="c-manage">

	<!--- Sidebar nav --->
	<bx:include template="../../partials/manageNav.bxm">

	<!--- Main content --->
	<main class="c-manage-main">

		<div class="c-manage-posts">

			<div class="c-manage-header">
				<div class="c-manage-header__lead">
					<span class="c-manage-header__eyebrow">System</span>
					<h1 class="c-manage-header__title">Request Log</h1>
					<p class="c-manage-header__sub">Every request this server has handled in the last 90 days, newest first.</p>
				</div>
			</div>

			<bx:include template="../../partials/systemTabs.bxm">

			<!--- These filters run in the query, so they cover the whole log. --->
			<form method="get" action="/manage/logs" class="c-log-toolbar c-log-toolbar--server">
				<div class="c-log-toolbar__filter c-log-toolbar__filter--grow">
					<label for="log-filter-path">Path starts with</label>
					<input id="log-filter-path" type="text" name="q" value="#encodeForHTMLAttribute( data.logFilters.path )#" placeholder="/posts/2026">
				</div>
				<div class="c-log-toolbar__filter">
					<label for="log-filter-method">Method</label>
					<select id="log-filter-method" name="method">
						<option value="">All</option>
						<bx:loop array="#data.logMethods#" item="logMethod">
							<option value="#logMethod#" #( data.logFilters.method == logMethod ? "selected" : "" )#>#logMethod#</option>
						</bx:loop>
					</select>
				</div>
				<div class="c-log-toolbar__filter">
					<label for="log-filter-status">Status</label>
					<select id="log-filter-status" name="status">
						<option value="">All</option>
						<bx:loop list="2xx,3xx,4xx,5xx" item="statusOption">
							<option value="#statusOption#" #( data.logFilters.status == statusOption ? "selected" : "" )#>#statusOption#</option>
						</bx:loop>
						<option value="unknown" #( data.logFilters.status == "unknown" ? "selected" : "" )#>Unknown</option>
					</select>
				</div>
				<button type="submit" class="c-log-toolbar__apply">Apply</button>
				<bx:if len( data.logFilters.path ) || len( data.logFilters.method ) || len( data.logFilters.status )>
					<a href="/manage/logs" class="c-log-toolbar__reset"><i class="bi bi-x-circle"></i> Clear</a>
				</bx:if>
			</form>

			<bx:if !data.paging.rows.len()>

				<div class="c-manage-panel__empty">
					<i class="bi bi-clipboard-data"></i>
					<bx:if len( data.filterQs ) || data.isPaged>
						<h2>No matching requests</h2>
						<p>Nothing logged matches these filters. <a href="/manage/logs">Back to the newest requests</a>.</p>
					<bx:else>
						<h2>No requests logged yet</h2>
						<p>Traffic will start showing up here as soon as this server handles a request.</p>
					</bx:if>
				</div>

			<bx:else>

				<script id="log-rows-data" type="application/json">#data.rowsJson#</script>
				<script id="log-initial-quick" type="application/json">#data.quickJson#</script>

				<div class="c-manage-panel" x-data="requestLogTable()">

					<div class="c-log-toolbar">
						<div class="c-log-toolbar__filter c-log-toolbar__filter--grow">
							<label for="log-filter-quick">Search this page</label>
							<input
								id="log-filter-quick"
								type="text"
								x-model="quickFilter"
								placeholder="Path, IP, referrer or user agent in the rows below">
						</div>
						<span class="c-log-toolbar__count" x-text="filteredRows.length + ' of #data.paging.rows.len()# shown'"></span>
					</div>

					<div class="c-manage-table-wrap">
						<table class="c-manage-table c-log-table">
							<thead>
								<tr>
									<th class="c-log-table__sortable" @click="sortBy('timeSort')">
										Time <i class="bi" :class="sortIcon('timeSort')"></i>
									</th>
									<th class="c-log-table__sortable" @click="sortBy('method')">
										Method <i class="bi" :class="sortIcon('method')"></i>
									</th>
									<th class="c-log-table__sortable" @click="sortBy('path')">
										Path <i class="bi" :class="sortIcon('path')"></i>
									</th>
									<th class="c-log-table__sortable" @click="sortBy('statusSort')">
										Status <i class="bi" :class="sortIcon('statusSort')"></i>
									</th>
									<th class="c-log-table__sortable" @click="sortBy('durationMs')">
										Duration <i class="bi" :class="sortIcon('durationMs')"></i>
									</th>
									<th class="c-log-table__sortable" @click="sortBy('ip')">
										IP <i class="bi" :class="sortIcon('ip')"></i>
									</th>
									<th>Referrer</th>
									<th>User agent</th>
								</tr>
							</thead>
							<tbody>
								<template x-for="row in filteredRows" :key="row.id">
									<tr>
										<td class="c-manage-table__cell-muted c-log-table__nowrap">
											<span x-text="formatTime(row.timeSort)"></span>
										</td>
										<td>
											<span class="c-log-method" :class="'c-log-method--' + row.method.toLowerCase()" x-text="row.method"></span>
										</td>
										<td class="c-log-table__path" :title="row.path + (row.queryString ? '?' + row.queryString : '')">
											<span x-text="row.path"></span>
											<span class="c-manage-table__cell-muted" x-show="row.queryString" x-text="'?' + row.queryString.slice(0, 40) + (row.queryString.length > 40 ? '…' : '')"></span>
										</td>
										<td>
											<span class="c-status-badge" :class="'c-status-badge--' + statusClass(row.statusCode)" x-text="row.statusCode || '—'"></span>
										</td>
										<td class="c-manage-table__cell-muted c-log-table__nowrap">
											<span x-text="row.durationMs + ' ms'"></span>
										</td>
										<td class="c-manage-table__cell-muted c-log-table__nowrap">
											<span x-text="row.ip"></span>
										</td>
										<td class="c-manage-table__cell-muted c-log-table__truncate" :title="row.referrer">
											<span x-text="row.referrer || '—'"></span>
										</td>
										<td class="c-manage-table__cell-muted c-log-table__truncate" :title="row.userAgent">
											<span x-text="row.userAgent || '—'"></span>
										</td>
									</tr>
								</template>
							</tbody>
						</table>

						<div class="c-manage-panel__empty c-manage-panel__empty--inline" x-show="!filteredRows.length">
							<i class="bi bi-funnel"></i>
							<h2>No rows on this page match that</h2>
							<p>This box only searches the rows shown here. Use the filters above to search the whole log.</p>
						</div>
					</div>

					<bx:if data.paging.hasNewer || data.paging.hasOlder>
						<bx:set qs = len( data.filterQs ) ? data.filterQs & "&" : "">
						<footer class="c-manage-panel__footer">
							<!--- The hrefs carry the quick filter as it was when the page
							loaded; onPaginate() swaps in its current value, so a change
							made since then isn't lost on the next click. --->
							<div class="c-pagination" @click.capture="onPaginate($event)">
								<bx:if data.paging.hasNewer>
									<a class="c-pagination__btn c-pagination__btn--wide" href="/manage/logs?#qs#after=#data.paging.newerCursor#">
										<i class="bi bi-chevron-left"></i> Newer
									</a>
								<bx:else>
									<span class="c-pagination__btn c-pagination__btn--wide c-pagination__btn--disabled"><i class="bi bi-chevron-left"></i> Newer</span>
								</bx:if>
								<bx:if data.paging.hasOlder>
									<a class="c-pagination__btn c-pagination__btn--wide" href="/manage/logs?#qs#before=#data.paging.olderCursor#">
										Older <i class="bi bi-chevron-right"></i>
									</a>
								<bx:else>
									<span class="c-pagination__btn c-pagination__btn--wide c-pagination__btn--disabled">Older <i class="bi bi-chevron-right"></i></span>
								</bx:if>
							</div>
						</footer>
					</bx:if>
				</div>

			</bx:if>

		</div>

	</main>
</div>

<script src="/assets/js/local-time.js"></script>
<script>
function requestLogTable(){
	return {
		rows: JSON.parse(document.getElementById('log-rows-data').textContent),
		quickFilter: JSON.parse(document.getElementById('log-initial-quick').textContent),
		sortKey: 'timeSort',
		sortDir: 'desc',

		// row.timeSort is a UTC ISO string (see _rowsForClient() in
		// Manage.bx) — this is what actually renders it, in the viewer's
		// own local timezone rather than the server's.
		formatTime: function(utcIso){
			return LocalTime.format(utcIso, 'datetime-seconds') || utcIso;
		},

		// Alpine calls this automatically once the component's state exists —
		// mirrors the quick filter into the URL via replaceState (no reload,
		// no new history entry) so a refresh keeps it.
		init: function(){
			var self = this;
			self.$watch( 'quickFilter', function(){
				var url = new URL( window.location.href );
				self._setQuick( url );
				window.history.replaceState( {}, '', url );
			} );
		},

		_setQuick: function( url ){
			if ( this.quickFilter ) url.searchParams.set( 'quick', this.quickFilter );
			else url.searchParams.delete( 'quick' );
		},

		// A modified click (⌘/ctrl/middle-click) is left alone so "open in
		// new tab" still gets the plain server-rendered href.
		onPaginate: function( event ){
			var link = event.target.closest( 'a.c-pagination__btn' );
			if ( !link || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey || event.button === 1 ) return;

			event.preventDefault();
			var url = new URL( link.href, window.location.origin );
			this._setQuick( url );
			window.location.href = url.toString();
		},

		get filteredRows(){
			var quick = this.quickFilter.trim().toLowerCase();

			var rows = this.rows.filter(function(row){
				if (!quick) return true;
				var haystack = (row.path + ' ' + row.ip + ' ' + row.referrer + ' ' + row.userAgent).toLowerCase();
				return haystack.indexOf(quick) !== -1;
			});

			// statusSort: unknown (empty string) sorts as -1, same idea as the
			// "—" badge always reading as the least-specific status.
			var key = this.sortKey;
			var dir = this.sortDir === 'asc' ? 1 : -1;
			rows.sort(function(a, b){
				var av = key === 'statusSort' ? (a.statusCode === '' ? -1 : a.statusCode) : a[key];
				var bv = key === 'statusSort' ? (b.statusCode === '' ? -1 : b.statusCode) : b[key];
				if (av < bv) return -1 * dir;
				if (av > bv) return 1 * dir;
				return 0;
			});

			return rows;
		},

		sortBy: function(key){
			if (this.sortKey === key) {
				this.sortDir = this.sortDir === 'asc' ? 'desc' : 'asc';
			} else {
				this.sortKey = key;
				this.sortDir = 'asc';
			}
		},

		sortIcon: function(key){
			if (this.sortKey !== key) return 'bi-chevron-expand c-log-table__sort-icon c-log-table__sort-icon--idle';
			return this.sortDir === 'asc' ? 'bi-chevron-up c-log-table__sort-icon' : 'bi-chevron-down c-log-table__sort-icon';
		}
	};
}

// The status badge's colour class.
function statusClass(code){
	if (code === '') return 'unknown';
	if (code < 300) return '2xx';
	if (code < 400) return '3xx';
	if (code < 500) return '4xx';
	return '5xx';
}
</script>
</bx:output>
<bx:include template="../../partials/_foot.bxm">

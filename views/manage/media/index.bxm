<bx:include template="../../partials/_head.bxm">
<bx:output>
<div class="c-manage">

	<!--- Sidebar nav --->
	<bx:include template="../../partials/manageNav.bxm">

	<!--- Main content --->
	<main class="c-manage-main">

		<div class="c-manage-header">
			<div>
				<h1 class="c-manage-header__title">Media</h1>
				<p class="c-manage-header__sub">Browse the image server and upload files into the current directory.</p>
			</div>
		</div>

		<bx:if !data.r2Configured>
			<div class="c-manage-alert c-manage-alert--error">
				<i class="bi bi-exclamation-circle-fill"></i>
				Image hosting isn't configured (missing R2 env vars) — browsing and uploads are unavailable.
			</div>
		<bx:else>

			<input type="hidden" id="media-csrf" value="#encodeForHTMLAttribute( data.csrfToken )#">
			<div id="media-status" class="c-manage-alert" hidden></div>

			<div class="c-media-manager">

				<div class="c-media-manager__toolbar">
					<nav id="media-breadcrumb" class="c-media-manager__breadcrumb" aria-label="Directory path"></nav>

					<div class="c-media-manager__upload">
						<input type="file" id="media-file-input" accept="image/jpeg,image/png,image/webp,image/gif" multiple hidden>
						<button type="button" id="media-upload-btn" class="c-manage-form__btn">
							<i class="bi bi-upload"></i> Upload here
						</button>
					</div>
				</div>

				<div id="media-grid" class="c-media-manager__grid">
					<p class="text-muted">Loading…</p>
				</div>

			</div>
		</bx:if>

	</main>
</div>

<script src="/assets/js/media-browser.js"></script>
<script>
(function(){
	var breadcrumbEl  = document.getElementById('media-breadcrumb');
	if (!breadcrumbEl) return; // R2 not configured — nothing below is on the page

	var csrfToken = document.getElementById('media-csrf').value;
	var statusEl      = document.getElementById('media-status');
	var gridEl        = document.getElementById('media-grid');
	var uploadBtn     = document.getElementById('media-upload-btn');
	var fileInput     = document.getElementById('media-file-input');

	function currentPath(){
		return new URLSearchParams(window.location.search).get('path') || '';
	}

	function navigateTo(path){
		var params = new URLSearchParams();
		if (path) params.set('path', path);
		window.location.href = '/manage/media' + (params.toString() ? '?' + params.toString() : '');
	}

	function showStatus(message, kind){
		statusEl.className = 'c-manage-alert c-manage-alert--' + (kind || 'success');
		statusEl.innerHTML = '<i class="bi bi-' + (kind === 'error' ? 'exclamation-circle-fill' : 'check-circle-fill') + '"></i> ' + message;
		statusEl.hidden = false;
	}

	function loadDirectory(path){
		MediaBrowser.loadDirectory({
			path: path,
			listUrlEndpoint: '/manage/media/list-url',
			gridEl: gridEl,
			breadcrumbEl: breadcrumbEl,
			onNavigateFolder: navigateTo,
			onFileClick: function(file, images, index){ openCarousel(images, index); },
			onNewFolder: function(){
				MediaBrowser.createFolder({
					createFolderEndpoint: '/manage/media/create-folder',
					csrfToken: csrfToken,
					path: path
				})
				.then(function(newPath){
					if (newPath === null) return; // cancelled
					navigateTo(newPath);
				})
				.catch(function(err){
					showStatus(typeof err === 'string' ? err : 'Could not create the folder.', 'error');
				});
			}
		});
	}

	// Downscales to 800px wide before upload, same cap used everywhere else
	// images enter this app (see the post editor). GIFs pass through
	// untouched so animation survives.
	function resizeImageFile(file, maxWidth){
		if (file.type === 'image/gif') return Promise.resolve(file);
		return new Promise(function(resolve){
			var objectUrl = URL.createObjectURL(file);
			var img = new Image();
			img.onload = function(){
				URL.revokeObjectURL(objectUrl);
				if (img.width <= maxWidth) return resolve(file);
				var scale = maxWidth / img.width;
				var canvas = document.createElement('canvas');
				canvas.width = maxWidth;
				canvas.height = Math.round(img.height * scale);
				canvas.getContext('2d').drawImage(img, 0, 0, canvas.width, canvas.height);
				canvas.toBlob(function(blob){
					if (!blob) return resolve(file);
					resolve(new File([blob], file.name, { type: file.type }));
				}, file.type, 0.9);
			};
			img.onerror = function(){
				URL.revokeObjectURL(objectUrl);
				resolve(file);
			};
			img.src = objectUrl;
		});
	}

	function uploadOne(file, path){
		return resizeImageFile(file, 800).then(function(sizedFile){
			return fetch('/manage/media/upload-url', {
				method: 'POST',
				headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': csrfToken },
				body: new URLSearchParams({ filename: file.name, contentType: file.type, path: path })
			})
			.then(function(res){ return res.json(); })
			.then(function(data){
				if (!data.success) return Promise.reject(data.error || 'Upload failed.');
				return fetch(data.uploadUrl, {
					method: 'PUT',
					headers: { 'Content-Type': file.type },
					body: sizedFile
				}).then(function(putRes){
					if (!putRes.ok) return Promise.reject('Upload to image host failed.');
					return data.url;
				});
			});
		});
	}

	// ── Image carousel ──

	var carouselEl = null;
	var carouselImages = [];
	var carouselIndex = 0;

	function renderCarousel(){
		var file = carouselImages[carouselIndex];
		var imgEl = carouselEl.querySelector('.c-media-carousel__img');
		var captionEl = carouselEl.querySelector('.c-media-carousel__caption');
		var counterEl = carouselEl.querySelector('.c-media-carousel__counter');

		imgEl.src = file.url;
		imgEl.alt = file.name;
		captionEl.textContent = file.url;
		counterEl.textContent = (carouselIndex + 1) + ' / ' + carouselImages.length;

		carouselEl.querySelector('.c-media-carousel__nav--prev').hidden = carouselImages.length < 2;
		carouselEl.querySelector('.c-media-carousel__nav--next').hidden = carouselImages.length < 2;
		counterEl.hidden = carouselImages.length < 2;

		// Brief fade/scale flourish on swap: force a reflow so the browser applies the
		// "loading" state before it's removed, otherwise both changes land in the same
		// frame and the CSS transition never runs.
		imgEl.classList.add('c-media-carousel__img--loading');
		void imgEl.offsetWidth;
		imgEl.classList.remove('c-media-carousel__img--loading');
	}

	function openCarousel(images, index){
		carouselImages = images;
		carouselIndex = index;

		if (!carouselEl) {
			carouselEl = document.createElement('div');
			carouselEl.className = 'c-media-carousel';
			carouselEl.innerHTML =
				'<div class="c-media-carousel__backdrop"></div>' +
				'<div class="c-media-carousel__chrome">' +
					'<span class="c-media-carousel__counter"></span>' +
					'<button type="button" class="c-media-carousel__close" aria-label="Close"><i class="bi bi-x-lg"></i></button>' +
				'</div>' +
				'<button type="button" class="c-media-carousel__nav c-media-carousel__nav--prev" aria-label="Previous image"><i class="bi bi-chevron-left"></i></button>' +
				'<button type="button" class="c-media-carousel__nav c-media-carousel__nav--next" aria-label="Next image"><i class="bi bi-chevron-right"></i></button>' +
				'<figure class="c-media-carousel__figure">' +
					'<img class="c-media-carousel__img" alt="">' +
					'<figcaption class="c-media-carousel__caption"></figcaption>' +
				'</figure>';
			document.body.appendChild(carouselEl);

			carouselEl.querySelector('.c-media-carousel__backdrop').addEventListener('click', closeCarousel);
			carouselEl.querySelector('.c-media-carousel__close').addEventListener('click', closeCarousel);
			carouselEl.querySelector('.c-media-carousel__nav--prev').addEventListener('click', function(){ stepCarousel(-1); });
			carouselEl.querySelector('.c-media-carousel__nav--next').addEventListener('click', function(){ stepCarousel(1); });
			document.addEventListener('keydown', onCarouselKeydown);
		}

		carouselEl.hidden = false;
		renderCarousel();
	}

	function closeCarousel(){
		if (carouselEl) carouselEl.hidden = true;
	}

	function stepCarousel(delta){
		if (!carouselImages.length) return;
		carouselIndex = (carouselIndex + delta + carouselImages.length) % carouselImages.length;
		renderCarousel();
	}

	function onCarouselKeydown(e){
		if (!carouselEl || carouselEl.hidden) return;
		if (e.key === 'Escape') closeCarousel();
		else if (e.key === 'ArrowLeft') stepCarousel(-1);
		else if (e.key === 'ArrowRight') stepCarousel(1);
	}

	uploadBtn.addEventListener('click', function(){ fileInput.click(); });

	fileInput.addEventListener('change', function(){
		var files = Array.prototype.slice.call(fileInput.files);
		if (!files.length) return;

		var path = currentPath();
		uploadBtn.disabled = true;
		showStatus('Uploading ' + files.length + ' file' + (files.length > 1 ? 's' : '') + '…', 'success');

		Promise.all(files.map(function(file){ return uploadOne(file, path); }))
		.then(function(){
			uploadBtn.disabled = false;
			fileInput.value = '';
			showStatus('Upload complete.', 'success');
			loadDirectory(path);
		})
		.catch(function(err){
			uploadBtn.disabled = false;
			fileInput.value = '';
			showStatus(typeof err === 'string' ? err : 'Upload failed — check your connection and try again.', 'error');
		});
	});

	loadDirectory(currentPath());
})();
</script>
</bx:output>
<bx:include template="../../partials/_foot.bxm">

<bx:include template="../../partials/_head.bxm">
<bx:output>
<div class="c-manage">

	<!--- Sidebar nav --->
	<bx:include template="../../partials/manageNav.bxm">

	<!--- Main content --->
	<main class="c-manage-main">

		<div class="c-manage-posts">

			<div class="c-manage-header">
				<div>
					<h1 class="c-manage-header__title">Security</h1>
					<p class="c-manage-header__sub">
						Heuristic scans over the request log — each section below is a lead worth reviewing,
						not a confirmed incident. Every one of these can (and will) false-positive on a
						legitimate crawler or an unusual-but-real visitor.
					</p>
				</div>
			</div>

			<!--- 1. Volume anomalies --->
			<section class="c-manage-section">
				<header class="c-manage-section__head">
					<h2>Volume anomalies</h2>
					<p>Top requesting IPs overall. Catches scraping, basic DDoS, credential-stuffing infra.</p>
				</header>
				<bx:if isNull( data.volumeAnomalies )>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Couldn't load this section — see server logs.</p>
					</div>
				<bx:elseif !data.volumeAnomalies.len()>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Nothing to show.</p>
					</div>
				<bx:else>
					<div class="c-manage-panel">
						<div class="c-manage-table-wrap">
							<table class="c-manage-table">
								<thead>
									<tr>
										<th>IP address</th>
										<th>Total requests</th>
										<th>Distinct paths</th>
										<th>First seen</th>
										<th>Last seen</th>
									</tr>
								</thead>
								<tbody>
									<bx:loop array="#data.volumeAnomalies#" item="row">
										<tr>
											<td class="c-manage-table__cell-muted">
											#encodeForHTML( row.ip_address )#
											<bx:set hostname = data.hostnames[ row.ip_address ] ?: "">
											<bx:if len( hostname )><br><span class="c-security-hostname">#encodeForHTML( hostname )#</span></bx:if>
										</td>
											<td>#numberFormat( row.total_requests )#</td>
											<td>#numberFormat( row.distinct_paths )#</td>
											<td class="c-manage-table__cell-muted">#dateTimeFormat( row.first_seen, "mmm d, h:nn tt" )#</td>
											<td class="c-manage-table__cell-muted">#dateTimeFormat( row.last_seen, "mmm d, h:nn tt" )#</td>
										</tr>
									</bx:loop>
								</tbody>
							</table>
						</div>
					</div>
				</bx:if>
			</section>

			<!--- 2. Burst detection --->
			<section class="c-manage-section">
				<header class="c-manage-section__head">
					<h2>Burst detection</h2>
					<p>Request velocity per IP per minute (&gt;60/min). Catches brute force and rate-limit-bypass attempts a daily average would smooth over.</p>
				</header>
				<bx:if isNull( data.burstDetection )>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Couldn't load this section — see server logs.</p>
					</div>
				<bx:elseif !data.burstDetection.len()>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>No minute exceeded the threshold.</p>
					</div>
				<bx:else>
					<div class="c-manage-panel">
						<div class="c-manage-table-wrap">
							<table class="c-manage-table">
								<thead>
									<tr>
										<th>IP address</th>
										<th>Minute</th>
										<th>Requests in that minute</th>
									</tr>
								</thead>
								<tbody>
									<bx:loop array="#data.burstDetection#" item="row">
										<tr>
											<td class="c-manage-table__cell-muted">
											#encodeForHTML( row.ip_address )#
											<bx:set hostname = data.hostnames[ row.ip_address ] ?: "">
											<bx:if len( hostname )><br><span class="c-security-hostname">#encodeForHTML( hostname )#</span></bx:if>
										</td>
											<td class="c-manage-table__cell-muted">#encodeForHTML( row.minute_bucket )#</td>
											<td>#numberFormat( row.requests_in_minute )#</td>
										</tr>
									</bx:loop>
								</tbody>
							</table>
						</div>
					</div>
				</bx:if>
			</section>

			<!--- 3. Enumeration / scanning --->
			<section class="c-manage-section">
				<header class="c-manage-section__head">
					<h2>Enumeration &amp; scanning</h2>
					<p>IPs probing &gt;15 distinct paths with a &gt;50% 401/403/404 rate. Catches directory brute-forcing, endpoint discovery, auth guessing.</p>
				</header>
				<bx:if isNull( data.enumerationScanning )>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Couldn't load this section — see server logs.</p>
					</div>
				<bx:elseif !data.enumerationScanning.len()>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Nothing to show.</p>
					</div>
				<bx:else>
					<div class="c-manage-panel">
						<div class="c-manage-table-wrap">
							<table class="c-manage-table">
								<thead>
									<tr>
										<th>IP address</th>
										<th>Total requests</th>
										<th>Distinct paths</th>
										<th>401/403/404 hits</th>
										<th>Error ratio</th>
									</tr>
								</thead>
								<tbody>
									<bx:loop array="#data.enumerationScanning#" item="row">
										<tr>
											<td class="c-manage-table__cell-muted">
											#encodeForHTML( row.ip_address )#
											<bx:set hostname = data.hostnames[ row.ip_address ] ?: "">
											<bx:if len( hostname )><br><span class="c-security-hostname">#encodeForHTML( hostname )#</span></bx:if>
										</td>
											<td>#numberFormat( row.total_requests )#</td>
											<td>#numberFormat( row.distinct_paths )#</td>
											<td>#numberFormat( row.error_hits )#</td>
											<td>#numberFormat( row.error_ratio * 100, "0" )#%</td>
										</tr>
									</bx:loop>
								</tbody>
							</table>
						</div>
					</div>
				</bx:if>
			</section>

			<!--- 4. Payload signatures --->
			<section class="c-manage-section">
				<header class="c-manage-section__head">
					<h2>Payload signatures</h2>
					<p>SQLi / XSS / path-traversal / command-injection shaped strings in the path or query string. Tagged by category so you can triage rather than treating "suspicious" as one bucket.</p>
				</header>
				<bx:if isNull( data.payloadSignatures )>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Couldn't load this section — see server logs.</p>
					</div>
				<bx:elseif !data.payloadSignatures.len()>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Nothing flagged.</p>
					</div>
				<bx:else>
					<div class="c-manage-panel">
						<div class="c-manage-table-wrap">
							<table class="c-manage-table">
								<thead>
									<tr>
										<th>Time</th>
										<th>Signal</th>
										<th>IP address</th>
										<th>Method</th>
										<th>Path</th>
										<th>Query string</th>
										<th>Status</th>
									</tr>
								</thead>
								<tbody>
									<bx:loop array="#data.payloadSignatures#" item="row">
										<bx:set statusCode = isNull( row.status_code ) ? "" : row.status_code>
										<bx:set statusClass = !len( statusCode ) ? "unknown" : ( statusCode < 300 ? "2xx" : ( statusCode < 400 ? "3xx" : ( statusCode < 500 ? "4xx" : "5xx" ) ) )>
										<tr>
											<td class="c-manage-table__cell-muted">#dateTimeFormat( row.requested_at, "mmm d, h:nn:ss tt" )#</td>
											<td><span class="c-signal-badge c-signal-badge--#encodeForHTMLAttribute( row.signal_type ?: 'unknown' )#">#encodeForHTML( row.signal_type ?: 'unknown' )#</span></td>
											<td class="c-manage-table__cell-muted">
											#encodeForHTML( row.ip_address )#
											<bx:set hostname = data.hostnames[ row.ip_address ] ?: "">
											<bx:if len( hostname )><br><span class="c-security-hostname">#encodeForHTML( hostname )#</span></bx:if>
										</td>
											<td><span class="c-log-method c-log-method--#encodeForHTMLAttribute( lCase( row.method ) )#">#encodeForHTML( row.method )#</span></td>
											<td class="c-manage-table__cell-muted" title="#encodeForHTMLAttribute( row.path )#">#encodeForHTML( left( row.path, 60 ) )##( len( row.path ) > 60 ? '…' : '' )#</td>
											<td class="c-manage-table__cell-muted" title="#encodeForHTMLAttribute( row.query_string )#">#encodeForHTML( left( row.query_string, 40 ) )##( len( row.query_string ) > 40 ? '…' : '' )#</td>
											<td><span class="c-status-badge c-status-badge--#statusClass#">#len( statusCode ) ? statusCode : '—'#</span></td>
										</tr>
									</bx:loop>
								</tbody>
							</table>
						</div>
					</div>
				</bx:if>
			</section>

			<!--- 5. Suspicious user agents --->
			<section class="c-manage-section">
				<header class="c-manage-section__head">
					<h2>Known scanner / suspicious user agents</h2>
					<p>Empty or known-scanner UA strings, grouped by IP. Low-confidence alone (UA is trivially spoofable) — best used to corroborate another signal.</p>
				</header>
				<bx:if isNull( data.suspiciousUserAgents )>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Couldn't load this section — see server logs.</p>
					</div>
				<bx:elseif !data.suspiciousUserAgents.len()>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Nothing to show.</p>
					</div>
				<bx:else>
					<div class="c-manage-panel">
						<div class="c-manage-table-wrap">
							<table class="c-manage-table">
								<thead>
									<tr>
										<th>IP address</th>
										<th>User agent</th>
										<th>Hits</th>
										<th>Distinct paths</th>
									</tr>
								</thead>
								<tbody>
									<bx:loop array="#data.suspiciousUserAgents#" item="row">
										<tr>
											<td class="c-manage-table__cell-muted">
											#encodeForHTML( row.ip_address )#
											<bx:set hostname = data.hostnames[ row.ip_address ] ?: "">
											<bx:if len( hostname )><br><span class="c-security-hostname">#encodeForHTML( hostname )#</span></bx:if>
										</td>
											<td class="c-manage-table__cell-muted" title="#encodeForHTMLAttribute( row.user_agent )#">#len( row.user_agent ) ? encodeForHTML( left( row.user_agent, 60 ) ) & ( len( row.user_agent ) > 60 ? '…' : '' ) : '(empty)'#</td>
											<td>#numberFormat( row.hits )#</td>
											<td>#numberFormat( row.distinct_paths )#</td>
										</tr>
									</bx:loop>
								</tbody>
							</table>
						</div>
					</div>
				</bx:if>
			</section>

			<!--- 6. Sensitive path probing --->
			<section class="c-manage-section">
				<header class="c-manage-section__head">
					<h2>Sensitive path probing</h2>
					<p>Requests for paths that only make sense as recon (exposed config, secrets, admin panels) — not filtered to failed status codes. A 200 here is far more urgent than a 404.</p>
				</header>
				<bx:if isNull( data.sensitivePathProbing )>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Couldn't load this section — see server logs.</p>
					</div>
				<bx:elseif !data.sensitivePathProbing.len()>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Nothing flagged.</p>
					</div>
				<bx:else>
					<div class="c-manage-panel">
						<div class="c-manage-table-wrap">
							<table class="c-manage-table">
								<thead>
									<tr>
										<th>Time</th>
										<th>IP address</th>
										<th>Method</th>
										<th>Path</th>
										<th>Status</th>
										<th>User agent</th>
									</tr>
								</thead>
								<tbody>
									<bx:loop array="#data.sensitivePathProbing#" item="row">
										<bx:set statusCode = isNull( row.status_code ) ? "" : row.status_code>
										<bx:set statusClass = !len( statusCode ) ? "unknown" : ( statusCode < 300 ? "2xx" : ( statusCode < 400 ? "3xx" : ( statusCode < 500 ? "4xx" : "5xx" ) ) )>
										<tr>
											<td class="c-manage-table__cell-muted">#dateTimeFormat( row.requested_at, "mmm d, h:nn:ss tt" )#</td>
											<td class="c-manage-table__cell-muted">
											#encodeForHTML( row.ip_address )#
											<bx:set hostname = data.hostnames[ row.ip_address ] ?: "">
											<bx:if len( hostname )><br><span class="c-security-hostname">#encodeForHTML( hostname )#</span></bx:if>
										</td>
											<td><span class="c-log-method c-log-method--#encodeForHTMLAttribute( lCase( row.method ) )#">#encodeForHTML( row.method )#</span></td>
											<td class="c-manage-table__cell-muted" title="#encodeForHTMLAttribute( row.path )#">#encodeForHTML( left( row.path, 70 ) )##( len( row.path ) > 70 ? '…' : '' )#</td>
											<td><span class="c-status-badge c-status-badge--#statusClass#">#len( statusCode ) ? statusCode : '—'#</span></td>
											<td class="c-manage-table__cell-muted" title="#encodeForHTMLAttribute( row.user_agent )#">#len( row.user_agent ) ? encodeForHTML( left( row.user_agent, 40 ) ) & ( len( row.user_agent ) > 40 ? '…' : '' ) : '—'#</td>
										</tr>
									</bx:loop>
								</tbody>
							</table>
						</div>
					</div>
				</bx:if>
			</section>

			<!--- 7. Unusual HTTP methods --->
			<section class="c-manage-section">
				<header class="c-manage-section__head">
					<h2>Unusual HTTP methods</h2>
					<p>Methods outside GET/POST/PUT/PATCH/DELETE/HEAD/OPTIONS. Catches protocol-level probing (TRACE for XST, CONNECT for tunneling, etc).</p>
				</header>
				<bx:if isNull( data.unusualMethods )>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Couldn't load this section — see server logs.</p>
					</div>
				<bx:elseif !data.unusualMethods.len()>
					<div class="c-manage-panel__empty c-manage-panel__empty--inline">
						<p>Nothing flagged.</p>
					</div>
				<bx:else>
					<div class="c-manage-panel">
						<div class="c-manage-table-wrap">
							<table class="c-manage-table">
								<thead>
									<tr>
										<th>Method</th>
										<th>IP address</th>
										<th>Hits</th>
										<th>First seen</th>
										<th>Last seen</th>
									</tr>
								</thead>
								<tbody>
									<bx:loop array="#data.unusualMethods#" item="row">
										<tr>
											<td><span class="c-log-method">#encodeForHTML( row.method )#</span></td>
											<td class="c-manage-table__cell-muted">
											#encodeForHTML( row.ip_address )#
											<bx:set hostname = data.hostnames[ row.ip_address ] ?: "">
											<bx:if len( hostname )><br><span class="c-security-hostname">#encodeForHTML( hostname )#</span></bx:if>
										</td>
											<td>#numberFormat( row.hits )#</td>
											<td class="c-manage-table__cell-muted">#dateTimeFormat( row.first_seen, "mmm d, h:nn tt" )#</td>
											<td class="c-manage-table__cell-muted">#dateTimeFormat( row.last_seen, "mmm d, h:nn tt" )#</td>
										</tr>
									</bx:loop>
								</tbody>
							</table>
						</div>
					</div>
				</bx:if>
			</section>

		</div>

	</main>
</div>
</bx:output>
<bx:include template="../../partials/_foot.bxm">

<bx:include template="../../partials/_head.bxm">
<bx:output>
<div class="c-manage">

	<!--- Sidebar nav --->
	<bx:include template="../../partials/manageNav.bxm">

	<!--- Main content --->
	<main class="c-manage-main">

		<div class="c-manage-header">
			<div>
				<h1 class="c-manage-header__title">Insights</h1>
				<p class="c-manage-header__sub">Traffic from this site's own access log, last #data.daysBack# days.</p>
			</div>
		</div>

		<div class="c-manage-dashboard__grid">

			<!--- Traffic card --->
			<section class="c-manage-dashboard__card c-manage-dashboard__card--traffic">
				<div class="c-manage-dashboard__card-head">
					<span class="c-manage-dashboard__icon"><i class="bi bi-graph-up"></i></span>
					<span class="c-manage-dashboard__eyebrow">Page views &mdash; last #data.daysBack# days</span>
				</div>
				<div class="c-dashboard-sparkline is-loading" id="traffic-widget">
					<div class="c-dashboard-sparkline__chart">
						<canvas id="traffic-chart" aria-label="Page views over the last #data.daysBack# days" role="img"></canvas>
						<div class="c-dashboard-sparkline__chart-skeleton" aria-hidden="true"></div>
					</div>
					<div class="c-dashboard-sparkline__stats">
						<div class="c-dashboard-sparkline__stats-row">
							<div class="c-dashboard-sparkline__stat">
								<span class="c-dashboard-sparkline__stat-value" id="traffic-total-views"><span class="c-dashboard-skeleton-text" aria-hidden="true"></span></span>
								<span class="c-dashboard-sparkline__stat-label">total views</span>
							</div>
							<div class="c-dashboard-sparkline__stat">
								<span class="c-dashboard-sparkline__stat-value" id="traffic-peak-day"><span class="c-dashboard-skeleton-text" aria-hidden="true"></span></span>
								<span class="c-dashboard-sparkline__stat-label">peak day</span>
							</div>
						</div>
						<div class="c-dashboard-sparkline__stat">
							<span class="c-dashboard-sparkline__stat-value" id="traffic-today-views"><span class="c-dashboard-skeleton-text" aria-hidden="true"></span></span>
							<span class="c-dashboard-sparkline__stat-label">today</span>
						</div>
					</div>
				</div>
				<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.0/chart.umd.min.js" integrity="sha512-Y51n9mtKTVBh3Jbx5pZSJNDDMyY+yGe77DGtBPzRlgsf/YLCh13kSZ3JmfHGzYFCmOndraf0sQgfM654b7dJ3w==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
				<script>
				(function(){
					var widget  = document.getElementById('traffic-widget');
					var totalEl = document.getElementById('traffic-total-views');
					var todayEl = document.getElementById('traffic-today-views');
					var peakEl  = document.getElementById('traffic-peak-day');

					fetch('/manage/insights/traffic-data', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
						.then(function(res){ return res.json(); })
						.then(function(data){
							if (!data.success) return Promise.reject();
							var traffic = data.traffic;

							var styles = getComputedStyle(document.documentElement);
							var lineColor = styles.getPropertyValue('--post-link-text').trim() || '##7c83fd';

							new Chart(document.getElementById('traffic-chart'), {
								type: 'line',
								data: {
									labels: traffic.labels,
									datasets: [{
										data: traffic.values,
										borderColor: lineColor,
										backgroundColor: lineColor + '33',
										fill: true,
										tension: 0.3,
										pointRadius: 0,
										borderWidth: 2
									}]
								},
								options: {
									responsive: true,
									maintainAspectRatio: false,
									plugins: { legend: { display: false } },
									scales: {
										x: { ticks: { maxTicksLimit: 8 }, grid: { display: false } },
										y: { beginAtZero: true, ticks: { precision: 0 } }
									}
								}
							});

							totalEl.textContent = traffic.total.toLocaleString();
							todayEl.textContent = traffic.todayViews.toLocaleString();
							peakEl.textContent = traffic.maxViews.toLocaleString();
							widget.classList.remove('is-loading');
						})
						.catch(function(){
							widget.classList.remove('is-loading');
							widget.innerHTML = '<p class="c-manage-dashboard__meta">Couldn\'t load traffic &mdash; see server logs.</p>';
						});
				})();
				</script>
			</section>


			<!--- Top pages card --->
			<section class="c-manage-dashboard__card c-manage-dashboard__card--pages">
				<div class="c-manage-dashboard__card-head">
					<span class="c-manage-dashboard__icon"><i class="bi bi-file-earmark-text"></i></span>
					<span class="c-manage-dashboard__eyebrow">Top posts</span>
				</div>
				<bx:if isNull( data.topPosts )>
					<p class="c-manage-dashboard__meta">Couldn't load this &mdash; see server logs.</p>
				<bx:elseif !data.topPosts.len()>
					<p class="c-manage-dashboard__meta">No visits recorded yet.</p>
				<bx:else>
					<ol class="c-dashboard-list">
						<bx:loop array="#data.topPosts#" item="row">
							<li class="c-dashboard-list__item">
								<a href="/posts/#year( row.publish_date )#/#numberFormat( month( row.publish_date ), "00" )#/#encodeForURL( row.slug )#" class="c-dashboard-list__label c-dashboard-list__label--link" target="_blank" rel="noopener">
									#encodeForHTML( row.title )#
								</a>
								<span class="c-dashboard-list__meta">#( row.views gte 1000 ? numberFormat( row.views / 1000, "0.0" ) & "k" : row.views )# views</span>
							</li>
						</bx:loop>
					</ol>
				</bx:if>
			</section>

			<!--- Top referrers card --->
			<section class="c-manage-dashboard__card c-manage-dashboard__card--referrers">
				<div class="c-manage-dashboard__card-head">
					<span class="c-manage-dashboard__icon"><i class="bi bi-signpost-split"></i></span>
					<span class="c-manage-dashboard__eyebrow">Top referrers</span>
				</div>
				<bx:if isNull( data.topReferrers )>
					<p class="c-manage-dashboard__meta">Couldn't load this &mdash; see server logs.</p>
				<bx:elseif !data.topReferrers.len()>
					<p class="c-manage-dashboard__meta">No referrer data yet.</p>
				<bx:else>
					<ul class="c-dashboard-list">
						<bx:loop array="#data.topReferrers#" item="row">
							<li class="c-dashboard-list__item">
								<span class="c-dashboard-list__label">#encodeForHTML( row.name )#</span>
								<span class="c-dashboard-list__meta">#numberFormat( row.count )#</span>
							</li>
						</bx:loop>
					</ul>
				</bx:if>
			</section>

			<!--- Top searches card --->
			<section class="c-manage-dashboard__card c-manage-dashboard__card--searches">
				<div class="c-manage-dashboard__card-head">
					<span class="c-manage-dashboard__icon"><i class="bi bi-search"></i></span>
					<span class="c-manage-dashboard__eyebrow">Top searches</span>
				</div>
				<bx:if isNull( data.topSearches )>
					<p class="c-manage-dashboard__meta">Couldn't load this &mdash; see server logs.</p>
				<bx:elseif !data.topSearches.len()>
					<p class="c-manage-dashboard__meta">No searches recorded yet.</p>
				<bx:else>
					<ul class="c-dashboard-list">
						<bx:loop array="#data.topSearches#" item="row">
							<li class="c-dashboard-list__item">
								<span class="c-dashboard-list__label">&ldquo;#encodeForHTML( row.query )#&rdquo;</span>
								<span class="c-dashboard-list__meta">#row.search_count# #( row.search_count == 1 ? "search" : "searches" )#</span>
							</li>
						</bx:loop>
					</ul>
				</bx:if>
			</section>

			<!--- Zero-result searches card --->
			<section class="c-manage-dashboard__card c-manage-dashboard__card--searches">
				<div class="c-manage-dashboard__card-head">
					<span class="c-manage-dashboard__icon"><i class="bi bi-search"></i></span>
					<span class="c-manage-dashboard__eyebrow">Searches that found nothing</span>
				</div>
				<bx:if isNull( data.zeroResultSearches )>
					<p class="c-manage-dashboard__meta">Couldn't load this &mdash; see server logs.</p>
				<bx:elseif data.zeroResultSearches.len()>
					<ul class="c-dashboard-list">
						<bx:loop array="#data.zeroResultSearches#" item="row">
							<li class="c-dashboard-list__item">
								<span class="c-dashboard-list__label">&ldquo;#encodeForHTML( row.query )#&rdquo;</span>
								<span class="c-dashboard-list__meta">#row.search_count# #( row.search_count == 1 ? "search" : "searches" )#</span>
							</li>
						</bx:loop>
					</ul>
				<bx:else>
					<p class="c-manage-dashboard__meta">No searches have come up empty recently.</p>
				</bx:if>
			</section>

			<!--- Top 404s card --->
			<section class="c-manage-dashboard__card c-manage-dashboard__card--404s">
				<div class="c-manage-dashboard__card-head">
					<span class="c-manage-dashboard__icon"><i class="bi bi-exclamation-triangle"></i></span>
					<span class="c-manage-dashboard__eyebrow">Top 404s</span>
				</div>
				<bx:if isNull( data.top404s )>
					<p class="c-manage-dashboard__meta">Couldn't load this &mdash; see server logs.</p>
				<bx:elseif !data.top404s.len()>
					<p class="c-manage-dashboard__meta">No 404s recorded &mdash; nothing broken lately.</p>
				<bx:else>
					<ul class="c-dashboard-list">
						<bx:loop array="#data.top404s#" item="row">
							<li class="c-dashboard-list__item">
								<a href="#encodeForHTMLAttribute( row.path )#" class="c-dashboard-list__label c-dashboard-list__label--link" target="_blank" rel="noopener">
									#encodeForHTML( row.path )#
								</a>
								<span class="c-dashboard-list__meta">#numberFormat( row.count )#</span>
							</li>
						</bx:loop>
					</ul>
				</bx:if>
			</section>

		</div>

	</main>
</div>
</bx:output>
<bx:include template="../../partials/_foot.bxm">

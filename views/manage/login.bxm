<bx:include template="../partials/_head.bxm">
<bx:output>
<div class="c-auth-page">
	<div class="c-auth-card">

		<!--- Logo --->
		<div class="text-center mb-4">
			<a href="/" class="c-auth__logo">
				<span class="c-auth__bracket">[</span>KISDigital<span class="c-auth__bracket">]</span>
			</a>
		</div>

		<!--- Heading --->
		<h1 class="c-auth__title">Sign in</h1>
		<p class="c-auth__subtitle mb-4">Sign in to manage your content.</p>

		<!--- Error message --->
		<bx:if len( data.error )>
			<div class="c-auth__error mb-4" role="alert">
				<i class="bi bi-exclamation-circle-fill"></i>
				#encodeForHTML( data.error )#
			</div>
		</bx:if>

		<!--- Login form --->
		<form method="post" action="/manage/login" novalidate>
			<input type="hidden" name="_csrf" value="#encodeForHTMLAttribute( data.csrfToken )#">

			<div class="mb-3">
				<label for="email" class="c-auth__label">Email address</label>
				<input
					type="email"
					id="email"
					name="email"
					class="c-auth__input"
					placeholder="you@example.com"
					autocomplete="email"
					required>
			</div>

			<div class="mb-4">
				<label for="password" class="c-auth__label">Password</label>
				<input
					type="password"
					id="password"
					name="password"
					class="c-auth__input"
					placeholder="••••••••"
					autocomplete="current-password"
					required>
			</div>

			<button type="submit" class="c-auth__submit">Sign in</button>

		</form>

		<bx:if data.googleSignInEnabled>
		<div class="c-auth__divider"><span>or</span></div>

		<a href="/auth/google" class="c-auth__google-btn">
			<svg class="c-auth__google-icon" width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
				<path fill="##4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.259h2.908c1.702-1.567 2.684-3.874 2.684-6.617z"/>
				<path fill="##34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
				<path fill="##FBBC05" d="M3.964 10.71A5.41 5.41 0 013.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 000 9c0 1.452.348 2.827.957 4.042l3.007-2.332z"/>
				<path fill="##EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
			</svg>
			Sign in with Google
		</a>
		</bx:if>

	</div>
</div>
</bx:output>
<bx:include template="../partials/_foot.bxm">

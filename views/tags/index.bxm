<bx:include template="../partials/_head.bxm">
<bx:output>
<div class="container">
	<div class="narrow">
		<header class="page-head">
			<h1 class="page-head__title">#encodeForHTML( data.currentTag )#</h1>
			<p class="page-head__lede">#data.paging.total# #( data.paging.total == 1 ? "article" : "articles" )# tagged #encodeForHTML( data.currentTag )#.</p>
		</header>

		<bx:include template="../partials/topicFilter.bxm">

		<div class="entry-list">
			<bx:loop array="#data.paging.posts#" item="post">
				<bx:include template="../partials/postEntry.bxm">
			</bx:loop>
		</div>
		<bx:set pageBase = "/tag/" & encodeForURL( data.currentTag )>
		<bx:include template="../partials/pagination.bxm">
	</div>
</div>
</bx:output>
<bx:include template="../partials/_foot.bxm">

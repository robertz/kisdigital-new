<bx:include template="../partials/_head.bxm">
<bx:output>
<div class="container py-5">
	<div class="c-project-hero">
		<p class="c-project-hero__eyebrow">Game</p>
		<h1 class="c-project-hero__title">STOMP Chat</h1>
		<p class="c-project-hero__tagline">A single-room chat over boxlang-express's STOMP pub/sub layer (<code class="bx-inline">boxExpressStomp()</code>) — unlike <a href="/games/chat/">Chat</a>, this one requires signing in first: the WebSocket CONNECT/SUBSCRIBE/SEND all check your site session, not just the page load.</p>
	</div>

	<div class="sc-app">
		<div class="sc-topbar">
			<span class="sc-status" id="status">connecting&hellip;</span>
			<span class="sc-me">Signed in as <strong>#encodeForHTML( data.displayName )#</strong> &middot; <a href="/auth/logout?redirect=/games/stomp-chat">sign out</a></span>
		</div>

		<div class="sc-messages" id="messages"></div>

		<form class="sc-composer" id="composer">
			<input type="text" id="composerInput" class="sc-composer-input" maxlength="500" placeholder="Message ##stomp-lounge" autocomplete="off">
			<button type="submit" class="sc-composer-send">Send</button>
		</form>
	</div>

	<p class="sc-note">One shared room. Not persisted — cleared on the next deploy. Your display name comes from your Google sign-in, not a field you can edit here.</p>
</div>

<style>
	.sc-app {
		margin-top: 24px;
		border: 1px solid var(--main-border-color);
		border-radius: var(--ui-radius-md);
		background: var(--ui-surface-1);
		overflow: hidden;
	}
	.sc-topbar {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--main-border-color);
		background: var(--ui-surface-2);
	}
	.sc-status {
		font-size: 0.8rem;
		color: var(--text-secondary);
		padding: 2px 8px;
		border-radius: 999px;
		background: var(--ui-surface-1);
		border: 1px solid var(--ui-border-subtle);
	}
	.sc-status[data-state="live"] { color: ##2f9e5b; border-color: rgba(47, 158, 91, 0.35); }
	.sc-status[data-state="error"] { color: ##d64545; border-color: rgba(214, 69, 69, 0.35); }
	.sc-me {
		margin-left: auto;
		font-size: 0.85rem;
		color: var(--text-secondary);
	}
	.sc-me a { color: var(--post-link-text); }
	.sc-messages {
		height: 360px;
		overflow-y: auto;
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.sc-msg {
		font-size: 0.9rem;
		line-height: 1.4;
	}
	.sc-msg-from { font-weight: 600; color: var(--post-link-text); margin-right: 6px; }
	.sc-msg-text { word-break: break-word; white-space: pre-wrap; }
	.sc-msg.is-system { color: var(--text-muted); font-style: italic; font-size: 0.8rem; }
	.sc-msg.is-error { color: ##d64545; font-size: 0.8rem; }
	.sc-composer {
		display: flex;
		gap: 8px;
		padding: 12px 16px;
		border-top: 1px solid var(--main-border-color);
	}
	.sc-composer-input {
		flex: 1 1 auto;
		background: var(--ui-surface-2);
		border: 1px solid var(--main-border-color);
		border-radius: var(--ui-radius-sm);
		color: inherit;
		padding: 8px 12px;
		font-size: 0.9rem;
	}
	.sc-composer-input:focus { outline: none; border-color: var(--post-link-text); }
	.sc-composer-send {
		background: var(--post-link-text);
		border: none;
		border-radius: var(--ui-radius-sm);
		color: ##fff;
		font-weight: 600;
		padding: 0 18px;
		cursor: pointer;
	}
	.sc-note {
		margin-top: 12px;
		font-size: 0.8rem;
		color: var(--text-muted);
		text-align: center;
	}
</style>

<script>
(function () {
	// Minimal hand-rolled STOMP 1.2 client — no bundled library, matching
	// the rest of this site's no-build-step JS. Auth isn't proven by
	// anything sent on this frame: the server's authenticate()/authorize()
	// hooks (routes/StompChat.bx) resolve identity from the session cookie
	// this WebSocket handshake carries automatically, the same cookie
	// req.session already uses everywhere else on the site. A CONNECT frame
	// is still required by the STOMP spec, so one is sent with no real
	// credentials in it — those fields are ignored server-side.
	var DESTINATION = "/topic/stomp-lounge";
	var RECONNECT_DELAY_MS = 2000;
	var displayName = #JSONSerialize( data.displayName )#;

	var statusEl = document.getElementById( "status" );
	var messagesEl = document.getElementById( "messages" );
	var composer = document.getElementById( "composer" );
	var composerInput = document.getElementById( "composerInput" );

	var socket = null;

	function setStatus( text, state ) {
		statusEl.textContent = text;
		statusEl.dataset.state = state;
	}

	function escapeHtml( text ) {
		var div = document.createElement( "div" );
		div.textContent = text;
		return div.innerHTML;
	}

	function addLine( className, html ) {
		var line = document.createElement( "div" );
		line.className = "sc-msg " + className;
		line.innerHTML = html;
		messagesEl.appendChild( line );
		messagesEl.scrollTop = messagesEl.scrollHeight;
	}

	function addMessage( from, text ) {
		addLine( "", '<span class="sc-msg-from">' + escapeHtml( from ) + '</span><span class="sc-msg-text">' + escapeHtml( text ) + '</span>' );
	}

	function addSystem( text ) { addLine( "is-system", escapeHtml( text ) ); }
	function addError( text ) { addLine( "is-error", escapeHtml( text ) ); }

	// STOMP 1.2 frame wire format: "COMMAND\nheader:value\n\n<body>\0"
	function sendFrame( command, headers, body ) {
		var out = command + "\n";
		for ( var key in headers ) out += key + ":" + headers[ key ] + "\n";
		out += "\n" + ( body || "" ) + "\0";
		socket.send( out );
	}

	function parseFrame( raw ) {
		raw = raw.replace( /\0$/, "" );
		var sep = raw.indexOf( "\n\n" );
		var headerBlock = sep >= 0 ? raw.slice( 0, sep ) : raw;
		var body = sep >= 0 ? raw.slice( sep + 2 ) : "";
		var lines = headerBlock.split( "\n" );
		var command = lines[ 0 ];
		var headers = {};
		for ( var i = 1; i < lines.length; i++ ) {
			var idx = lines[ i ].indexOf( ":" );
			if ( idx >= 0 ) headers[ lines[ i ].slice( 0, idx ) ] = lines[ i ].slice( idx + 1 );
		}
		return { command: command, headers: headers, body: body };
	}

	function connect() {
		var proto = location.protocol === "https:" ? "wss:" : "ws:";
		socket = new WebSocket( proto + "//" + location.host + "/games/stomp-chat/socket" );

		socket.addEventListener( "open", function () {
			sendFrame( "CONNECT", { "accept-version": "1.2", host: location.host } );
		} );

		socket.addEventListener( "message", function ( ev ) {
			var frame = parseFrame( ev.data );
			if ( frame.command === "CONNECTED" ) {
				setStatus( "live", "live" );
				sendFrame( "SUBSCRIBE", { destination: DESTINATION, id: "sub-0" } );
			} else if ( frame.command === "MESSAGE" ) {
				try {
					var data = JSON.parse( frame.body );
					addMessage( data.from, data.text );
				} catch ( e ) { /* ignore malformed body */ }
			} else if ( frame.command === "ERROR" ) {
				addError( frame.headers.message || "Connection error." );
				setStatus( "error", "error" );
			}
		} );

		socket.addEventListener( "close", function () {
			setStatus( "reconnecting…", "error" );
			setTimeout( connect, RECONNECT_DELAY_MS );
		} );

		socket.addEventListener( "error", function () { socket.close(); } );
	}

	composer.addEventListener( "submit", function ( ev ) {
		ev.preventDefault();
		var text = composerInput.value.trim();
		if ( !text || !socket || socket.readyState !== WebSocket.OPEN ) return;
		sendFrame( "SEND", { destination: DESTINATION, "content-type": "application/json" }, JSON.stringify( { from: displayName, text: text } ) );
		composerInput.value = "";
	} );

	addSystem( "Connecting as " + displayName + "…" );
	connect();
})();
</script>

</bx:output>
<bx:include template="../partials/_foot.bxm">

<bx:include template="../partials/_head.bxm">
<bx:output>
<div class="container py-5">
	<div class="c-project-hero">
		<p class="c-project-hero__eyebrow">Game</p>
		<h1 class="c-project-hero__title">STOMP Chat</h1>
		<p class="c-project-hero__tagline">A multi-channel chat over boxlang-express's STOMP pub/sub layer (<code class="bx-inline">boxExpressStomp()</code>) — unlike <a href="/games/chat/">Chat</a>, this one requires signing in first: the WebSocket CONNECT/SUBSCRIBE/SEND all check your site session, not just the page load.</p>
	</div>

	<div class="sc-app">
		<aside class="sc-channels">
			<div class="sc-workspace">
				<span class="sc-workspace-icon">S</span>
				<span class="sc-workspace-name">STOMP Chat</span>
			</div>

			<p class="sc-pane-title">Channels</p>
			<nav class="sc-channel-list" id="channelList"></nav>
			<bx:if data.isAdmin>
			<form class="sc-new-channel" id="newChannelForm">
				<input type="text" id="newChannelInput" class="sc-new-channel-input" maxlength="30" placeholder="new-channel" autocomplete="off">
				<button type="submit" class="sc-new-channel-add" aria-label="Create channel">+</button>
			</form>
			<p class="sc-new-channel-error" id="newChannelError" hidden></p>
			</bx:if>

			<p class="sc-pane-title sc-dm-title">Direct messages</p>
			<nav class="sc-dm-list" id="dmList"></nav>
			<p class="sc-dm-empty" id="dmEmpty">Click someone online to start one.</p>
		</aside>

		<main class="sc-main">
			<div class="sc-topbar">
				<button type="button" class="sc-back-btn" id="backBtn" aria-label="Back to channel" hidden>
					<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
				</button>
				<span class="sc-channel-title" id="viewTitle"><span class="sc-channel-hash">##</span>#encodeForHTML( data.currentChannel )#</span>
				<span class="sc-status" id="status">connecting&hellip;</span>
				<span class="sc-me">Signed in as <strong>#encodeForHTML( data.displayName )#</strong> &middot; <a href="/auth/logout?redirect=/games/stomp-chat">sign out</a></span>
			</div>

			<div class="sc-messages" id="messages"></div>
			<p class="sc-typing" id="typingIndicator" hidden></p>

			<form class="sc-composer" id="composer">
				<input type="text" id="composerInput" class="sc-composer-input" maxlength="500" placeholder="Message ###encodeForHTMLAttribute( data.currentChannel )#" autocomplete="off">
				<button type="submit" class="sc-composer-send">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
					Send
				</button>
			</form>
		</main>

		<aside class="sc-presence">
			<p class="sc-pane-title">Online <span class="sc-presence-count" id="presenceCount"></span></p>
			<ul class="sc-presence-list" id="presenceList"></ul>
		</aside>
	</div>

	<p class="sc-note">Channels, messages and DMs are cleared on the next deploy (DMs also don't survive a page reload) — but which channels you've joined is remembered. Your display name comes from your Google sign-in, not a field you can edit here.</p>
</div>

<style>
	.sc-app {
		--sc-accent-a: ##7c3aed;
		--sc-accent-b: ##06b6d4;
		--sc-gradient: linear-gradient(135deg, var(--sc-accent-a), var(--sc-accent-b));
		position: relative;
		margin-top: 28px;
		border-radius: 20px;
		border: 1px solid var(--ui-border-subtle);
		background: var(--ui-surface-1);
		box-shadow: 0 24px 60px -28px rgba(124, 58, 237, 0.45), var(--ui-shadow-sm);
		overflow: hidden;
		display: flex;
		min-height: 520px;
	}
	.sc-app::before {
		content: "";
		position: absolute;
		top: 0; left: 0; right: 0;
		height: 4px;
		background: var(--sc-gradient);
	}

	/* ── Left: workspace header + channels + DMs ── */
	.sc-channels {
		width: 210px;
		flex: 0 0 auto;
		border-right: 1px solid var(--ui-border-subtle);
		background: var(--ui-surface-2);
		padding: 16px 14px 14px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.sc-workspace {
		display: flex;
		align-items: center;
		gap: 8px;
		padding-bottom: 14px;
		margin-bottom: 2px;
		border-bottom: 1px solid var(--ui-border-subtle);
	}
	.sc-workspace-icon {
		flex: 0 0 auto;
		width: 26px;
		height: 26px;
		border-radius: 7px;
		background: var(--sc-gradient);
		color: ##fff;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 800;
		font-size: 0.8rem;
	}
	.sc-workspace-name { font-weight: 800; font-size: 0.95rem; }
	.sc-pane-title {
		margin: 0;
		font-size: 0.7rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		display: flex;
		align-items: center;
		gap: 6px;
	}
	.sc-dm-title { margin-top: 6px; }
	.sc-presence-count {
		font-weight: 700;
		color: var(--sc-accent-a);
	}
	.sc-channel-list, .sc-dm-list {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.sc-channel-row {
		position: relative;
		display: flex;
		align-items: center;
		gap: 4px;
		border-radius: 10px;
		border-left: 3px solid transparent;
		transition: background 0.15s ease;
	}
	.sc-channel-row:hover { background: var(--ui-border-subtle); }
	.sc-channel-link {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		align-items: center;
		gap: 4px;
		padding: 7px 4px 7px 10px;
		border-radius: 10px;
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--text-secondary);
		background: none;
		border: none;
		text-align: left;
		cursor: pointer;
		font-family: inherit;
	}
	.sc-channel-hash { opacity: 0.7; }
	.sc-channel-link-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.sc-channel-row.is-unjoined .sc-channel-link { color: var(--text-muted); opacity: 0.7; }
	.sc-channel-row.is-unjoined:hover .sc-channel-link-name::after {
		content: " · join";
		opacity: 0.75;
		font-size: 0.78em;
		font-weight: 700;
		color: var(--sc-accent-a);
	}
	.sc-channel-badge {
		flex: 0 0 auto;
		margin-right: 8px;
		background: var(--sc-gradient);
		color: ##fff;
		font-size: 0.68rem;
		font-weight: 800;
		min-width: 16px;
		height: 16px;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0 4px;
	}
	.sc-channel-leave {
		flex: 0 0 auto;
		width: 20px;
		height: 20px;
		margin-right: 6px;
		border-radius: 50%;
		border: none;
		background: none;
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.12s ease, background 0.12s ease, color 0.12s ease;
	}
	.sc-channel-row:hover .sc-channel-leave { opacity: 1; }
	.sc-channel-leave:hover { background: rgba(214, 69, 69, 0.15); color: ##d64545; }
	.sc-channel-row.is-active {
		background: linear-gradient(90deg, rgba(124, 58, 237, 0.14), rgba(6, 182, 212, 0.05));
		border-left-color: var(--sc-accent-a);
	}
	.sc-channel-row.is-active .sc-channel-link { color: var(--sc-accent-a); font-weight: 700; }
	.sc-dm-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 6px;
		padding: 7px 10px;
		border-radius: 10px;
		font-size: 0.86rem;
		font-weight: 500;
		color: var(--text-secondary);
		background: none;
		border: none;
		border-left: 3px solid transparent;
		text-align: left;
		cursor: pointer;
		font-family: inherit;
		transition: background 0.15s ease, color 0.15s ease;
	}
	.sc-dm-item:hover { background: var(--ui-border-subtle); }
	.sc-dm-item.is-active {
		background: linear-gradient(90deg, rgba(124, 58, 237, 0.14), rgba(6, 182, 212, 0.05));
		color: var(--sc-accent-a);
		font-weight: 700;
		border-left-color: var(--sc-accent-a);
	}
	.sc-dm-item-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.sc-dm-unread {
		flex: 0 0 auto;
		background: var(--sc-gradient);
		color: ##fff;
		font-size: 0.68rem;
		font-weight: 800;
		min-width: 16px;
		height: 16px;
		border-radius: 999px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0 4px;
	}
	.sc-dm-empty {
		margin: 0;
		font-size: 0.78rem;
		color: var(--text-muted);
		line-height: 1.4;
	}
	.sc-dm-empty.is-hidden { display: none; }
	.sc-new-channel {
		display: flex;
		gap: 6px;
	}
	.sc-new-channel-input {
		flex: 1 1 auto;
		min-width: 0;
		background: var(--ui-surface-1);
		border: 1px solid var(--main-border-color);
		border-radius: 10px;
		color: inherit;
		padding: 7px 10px;
		font-size: 0.8rem;
	}
	.sc-new-channel-input:focus { outline: none; border-color: var(--sc-accent-a); }
	.sc-new-channel-add {
		background: var(--sc-gradient);
		border: none;
		border-radius: 10px;
		color: ##fff;
		font-weight: 700;
		width: 30px;
		cursor: pointer;
		box-shadow: 0 4px 12px -4px rgba(124, 58, 237, 0.6);
	}
	.sc-new-channel-error {
		margin: 0;
		font-size: 0.75rem;
		color: ##d64545;
	}

	/* ── Middle: messages ── */
	.sc-main {
		flex: 1 1 auto;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}
	.sc-topbar {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 16px 20px;
		border-bottom: 1px solid var(--ui-border-subtle);
	}
	.sc-back-btn {
		flex: 0 0 auto;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		border: 1px solid var(--ui-border-subtle);
		background: var(--ui-surface-2);
		color: var(--text-secondary);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}
	.sc-back-btn[hidden] { display: none; }
	.sc-back-btn:hover { color: var(--sc-accent-a); border-color: var(--sc-accent-a); }
	.sc-channel-title { font-weight: 800; font-size: 1.05rem; }
	.sc-channel-hash { color: var(--sc-accent-a); margin-right: 1px; }
	.sc-status {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--text-secondary);
		padding: 3px 10px;
		border-radius: 999px;
		background: var(--ui-surface-2);
		border: 1px solid var(--ui-border-subtle);
	}
	.sc-status::before {
		content: "";
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: currentColor;
	}
	.sc-status[data-state="live"] { color: ##2f9e5b; border-color: rgba(47, 158, 91, 0.3); background: rgba(47, 158, 91, 0.08); }
	.sc-status[data-state="live"]::before { animation: sc-pulse 1.7s infinite; }
	.sc-status[data-state="error"] { color: ##d64545; border-color: rgba(214, 69, 69, 0.3); background: rgba(214, 69, 69, 0.08); }
	@keyframes sc-pulse {
		0%   { box-shadow: 0 0 0 0 rgba(47, 158, 91, 0.55); }
		70%  { box-shadow: 0 0 0 6px rgba(47, 158, 91, 0); }
		100% { box-shadow: 0 0 0 0 rgba(47, 158, 91, 0); }
	}
	.sc-me {
		margin-left: auto;
		font-size: 0.82rem;
		color: var(--text-secondary);
		white-space: nowrap;
	}
	.sc-me a { color: var(--sc-accent-a); }
	.sc-messages {
		flex: 1 1 auto;
		overflow-y: auto;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.sc-avatar {
		flex: 0 0 auto;
		width: 30px;
		height: 30px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.68rem;
		font-weight: 800;
		color: ##fff;
		letter-spacing: -0.02em;
	}

	.sc-msg-row {
		display: flex;
		align-items: flex-end;
		gap: 8px;
		max-width: 78%;
		animation: sc-msg-in 0.22s ease;
	}
	.sc-msg-row.is-own {
		flex-direction: row-reverse;
		align-self: flex-end;
	}
	@keyframes sc-msg-in {
		from { opacity: 0; transform: translateY(6px); }
		to   { opacity: 1; transform: translateY(0); }
	}
	.sc-bubble {
		padding: 8px 13px;
		border-radius: 16px;
		border-bottom-left-radius: 4px;
		background: var(--ui-surface-2);
		font-size: 0.9rem;
		line-height: 1.45;
	}
	.sc-msg-row.is-own .sc-bubble {
		background: var(--sc-gradient);
		color: ##fff;
		border-bottom-left-radius: 16px;
		border-bottom-right-radius: 4px;
	}
	.sc-bubble-from {
		display: block;
		font-size: 0.7rem;
		font-weight: 700;
		opacity: 0.65;
		margin-bottom: 2px;
	}
	.sc-bubble-text { word-break: break-word; white-space: pre-wrap; }

	.sc-line-system, .sc-line-error {
		align-self: center;
		font-size: 0.78rem;
		padding: 4px 12px;
		border-radius: 999px;
	}
	.sc-line-system { color: var(--text-muted); background: var(--ui-surface-2); }
	.sc-line-error { color: ##d64545; background: rgba(214, 69, 69, 0.1); }

	.sc-typing {
		margin: 0;
		padding: 0 20px 4px;
		font-size: 0.78rem;
		font-style: italic;
		color: var(--text-muted);
		min-height: 1.2em;
	}
	.sc-typing[hidden] { display: none; }

	.sc-composer {
		display: flex;
		gap: 10px;
		padding: 16px 20px;
		border-top: 1px solid var(--ui-border-subtle);
	}
	.sc-composer-input {
		flex: 1 1 auto;
		background: var(--ui-surface-2);
		border: 1px solid var(--main-border-color);
		border-radius: 999px;
		color: inherit;
		padding: 10px 16px;
		font-size: 0.9rem;
	}
	.sc-composer-input:focus { outline: none; border-color: var(--sc-accent-a); }
	.sc-composer-send {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: var(--sc-gradient);
		border: none;
		border-radius: 999px;
		color: ##fff;
		font-weight: 700;
		padding: 0 20px;
		cursor: pointer;
		box-shadow: 0 6px 16px -6px rgba(124, 58, 237, 0.55);
	}

	/* ── Right: presence ── */
	.sc-presence {
		width: 180px;
		flex: 0 0 auto;
		border-left: 1px solid var(--ui-border-subtle);
		background: var(--ui-surface-2);
		padding: 20px 14px;
	}
	.sc-presence-list {
		list-style: none;
		margin: 12px 0 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.sc-presence-item {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 4px 6px;
		border-radius: 10px;
		font-size: 0.85rem;
		color: var(--text-secondary);
	}
	.sc-presence-item.is-clickable { cursor: pointer; }
	.sc-presence-item.is-clickable:hover { background: var(--ui-border-subtle); color: var(--sc-accent-a); }
	.sc-presence-avatar {
		position: relative;
		flex: 0 0 auto;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.6rem;
		font-weight: 800;
		color: ##fff;
	}
	.sc-presence-avatar::after {
		content: "";
		position: absolute;
		right: -1px;
		bottom: -1px;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: ##2f9e5b;
		border: 2px solid var(--ui-surface-2);
	}
	.sc-presence-name {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.sc-note {
		margin-top: 14px;
		font-size: 0.8rem;
		color: var(--text-muted);
		text-align: center;
	}

	@media (max-width: 760px) {
		.sc-app { flex-direction: column; }
		.sc-channels, .sc-presence {
			width: auto;
			border: none;
			border-bottom: 1px solid var(--ui-border-subtle);
		}
		.sc-channel-list, .sc-dm-list { flex-direction: row; flex-wrap: wrap; }
		.sc-presence-list { flex-direction: row; flex-wrap: wrap; }
		.sc-msg-row { max-width: 92%; }
	}
</style>

<script>
(function () {
	// Minimal hand-rolled STOMP 1.2 client — no bundled library, matching
	// the rest of this site's no-build-step JS. Auth isn't proven by
	// anything sent on this frame: the server's authenticate()/authorize()
	// hooks (routes/StompChat.bx) resolve identity from the session cookie
	// this WebSocket handshake carries automatically, the same cookie
	// req.session already uses everywhere else on the site. A CONNECT frame
	// is still required by the STOMP spec, so one is sent with no real
	// credentials in it — those fields are ignored server-side.
	//
	// A connection SUBSCRIBEs to every channel the user has joined at once
	// (see connect()'s CONNECTED handler) rather than exactly one — moving
	// between two channels you're already in is therefore a pure client-
	// side view swap (switchToChannel()), same as moving between two open
	// DM threads always was. Real SUBSCRIBE/UNSUBSCRIBE traffic only
	// happens for an actual membership change: joinChannel() (clicking an
	// unjoined channel) and leaveChannel() (its "×" hover affordance,
	// never offered for ##general — see routes/StompChat.bx's class
	// docblock for why that's pinned both here and server-side). Both
	// persist server-side (StompChatChannelMembership), so which channels
	// you're in survives a reload — unlike everything else on this page.
	var MY_USER_ID = #JSONSerialize( data.userId )#;
	var CHANNEL_DEST_PREFIX = "/topic/stomp-chat/";
	var CHANNEL_SUB_PREFIX = "sub-ch-"; // must match routes/StompChat.bx's variables.CHANNEL_SUB_PREFIX
	var DM_PREFIX = "/queue/stomp-chat/dm/";
	var MY_INBOX = DM_PREFIX + MY_USER_ID;
	var RECONNECT_DELAY_MS = 2000;
	var TYPING_TIMEOUT_MS = 3000;
	var TYPING_SEND_THROTTLE_MS = 2000;
	var displayName = #JSONSerialize( data.displayName )#;

	var AVATAR_COLORS = [ "##7c3aed", "##06b6d4", "##f59e0b", "##ef4444", "##10b981", "##ec4899", "##3b82f6", "##84cc16" ];

	function avatarColor( name ) {
		var hash = 0;
		for ( var i = 0; i < name.length; i++ ) hash = ( hash * 31 + name.charCodeAt( i ) ) >>> 0;
		return AVATAR_COLORS[ hash % AVATAR_COLORS.length ];
	}

	function initials( name ) {
		var parts = name.trim().split( /\s+/ ).filter( Boolean );
		if ( !parts.length ) return "?";
		var s = parts[ 0 ][ 0 ];
		if ( parts.length > 1 ) s += parts[ parts.length - 1 ][ 0 ];
		return s.toUpperCase();
	}

	var statusEl = document.getElementById( "status" );
	var viewTitleEl = document.getElementById( "viewTitle" );
	var backBtn = document.getElementById( "backBtn" );
	var channelListEl = document.getElementById( "channelList" );
	var dmListEl = document.getElementById( "dmList" );
	var dmEmptyEl = document.getElementById( "dmEmpty" );
	var presenceListEl = document.getElementById( "presenceList" );
	var presenceCountEl = document.getElementById( "presenceCount" );
	var messagesEl = document.getElementById( "messages" );
	var typingIndicatorEl = document.getElementById( "typingIndicator" );
	var composer = document.getElementById( "composer" );
	var composerInput = document.getElementById( "composerInput" );

	var socket = null;
	var connectingLine = null;

	// allChannels: every channel that exists (joined or not — the sidebar
	// shows all of them, dimming the ones this user hasn't joined, per the
	// "one list, unjoined dimmed" browse design). joinedChannels: the
	// subset this user is actually subscribed to; "general" is always
	// first and never leaves it. activeChannel tracks whichever channel
	// the presence panel and the back button return to — it stays put
	// while a DM thread is open (view.type === "dm"), matching how the
	// presence list behaved before DMs and multi-channel coexisted at all.
	var allChannels = #JSONSerialize( data.channels )#;
	var joinedChannels = #JSONSerialize( data.joinedChannels )#;
	var activeChannel = #JSONSerialize( data.currentChannel )#;

	// view is either { type: "channel", channel } or
	// { type: "dm", userId, displayName }. channelsMessages/dmThreads are
	// the client-only backing stores every view renders from —
	// channelsMessages entries are { type: "chat", from, text } or
	// { type: "system", text } so a channel's join/leave lines replay in
	// the right order when you switch back to it, not just its chat
	// messages. presenceByChannel caches each joined channel's last known
	// roster so switching to it (or back to it from a DM) doesn't show a
	// blank "Online" panel until the next presence broadcast happens to
	// arrive. See routes/StompChat.bx's class docblock for why DMs don't
	// have a server-side equivalent of channel history at all.
	var view = { type: "channel", channel: activeChannel };
	var channelsMessages = {}; // channel -> [{type:"chat",from,text} | {type:"system",text}]
	var presenceByChannel = {}; // channel -> [{userId,displayName}]
	var unreadByChannel = {}; // channel -> count, only for joined channels that aren't the active view
	var dmThreads = {}; // userId -> { displayName, messages: [{from,text}], unread }
	var typingNames = {}; // displayName -> timeout id, for whichever destination is currently active
	var lastTypingSentAt = 0;

	joinedChannels.forEach( function ( channel ) {
		channelsMessages[ channel ] = [];
		presenceByChannel[ channel ] = [];
		unreadByChannel[ channel ] = 0;
	} );

	function setStatus( text, state ) {
		statusEl.textContent = text;
		statusEl.dataset.state = state;
	}

	function escapeHtml( text ) {
		var div = document.createElement( "div" );
		div.textContent = text;
		return div.innerHTML;
	}

	function scrollToBottom() {
		messagesEl.scrollTop = messagesEl.scrollHeight;
	}

	function buildMessageRow( from, text ) {
		var isOwn = from === displayName;
		var row = document.createElement( "div" );
		row.className = "sc-msg-row" + ( isOwn ? " is-own" : "" );

		var avatar = document.createElement( "div" );
		avatar.className = "sc-avatar";
		avatar.style.background = avatarColor( from );
		avatar.textContent = initials( from );

		var bubble = document.createElement( "div" );
		bubble.className = "sc-bubble";
		bubble.innerHTML = ( isOwn ? "" : '<span class="sc-bubble-from">' + escapeHtml( from ) + '</span>' )
			+ '<span class="sc-bubble-text">' + escapeHtml( text ) + '</span>';

		row.appendChild( avatar );
		row.appendChild( bubble );
		return row;
	}

	function buildLine( className, text ) {
		var line = document.createElement( "div" );
		line.className = className;
		line.textContent = text;
		return line;
	}

	function renderActiveMessages() {
		messagesEl.innerHTML = "";
		var list = view.type === "dm"
			? ( dmThreads[ view.userId ] ? dmThreads[ view.userId ].messages.map( function ( m ) { return { type: "chat", from: m.from, text: m.text }; } ) : [] )
			: ( channelsMessages[ view.channel ] || [] );
		list.forEach( function ( m ) {
			messagesEl.appendChild( m.type === "system" ? buildLine( "sc-line-system", m.text ) : buildMessageRow( m.from, m.text ) );
		} );
		scrollToBottom();
	}

	// Real-time chat message for `channel` (any joined channel, not
	// necessarily the one on screen). Always recorded into that channel's
	// backing array; only painted into the DOM (and scrolled to) if it's
	// the active view — otherwise it bumps that channel's unread badge.
	function addChannelMessage( channel, from, text ) {
		if ( !channelsMessages[ channel ] ) channelsMessages[ channel ] = [];
		channelsMessages[ channel ].push( { type: "chat", from: from, text: text } );
		if ( view.type === "channel" && view.channel === channel ) {
			messagesEl.appendChild( buildMessageRow( from, text ) );
			scrollToBottom();
		} else {
			unreadByChannel[ channel ] = ( unreadByChannel[ channel ] || 0 ) + 1;
			renderChannelList();
		}
	}

	// A "joined ##x" / "left ##x" system line — recorded the same way as a
	// chat message, but never bumps the unread badge (Slack doesn't badge
	// a channel just because someone came or went, only for actual
	// messages).
	function addChannelSystem( channel, text ) {
		if ( !channelsMessages[ channel ] ) channelsMessages[ channel ] = [];
		channelsMessages[ channel ].push( { type: "system", text: text } );
		if ( view.type === "channel" && view.channel === channel ) {
			messagesEl.appendChild( buildLine( "sc-line-system", text ) );
			scrollToBottom();
		}
	}

	function addChannelHistory( channel, messages ) {
		channelsMessages[ channel ] = messages.map( function ( m ) { return { type: "chat", from: m.from, text: m.text }; } );
		if ( view.type === "channel" && view.channel === channel ) renderActiveMessages();
	}

	function addError( text ) {
		messagesEl.appendChild( buildLine( "sc-line-error", text ) );
		scrollToBottom();
	}

	function addSystem( text ) {
		var line = buildLine( "sc-line-system", text );
		messagesEl.appendChild( line );
		scrollToBottom();
		return line;
	}

	function ensureDmThread( userId, threadDisplayName ) {
		if ( !dmThreads[ userId ] ) {
			dmThreads[ userId ] = { displayName: threadDisplayName, messages: [], unread: 0 };
		}
		return dmThreads[ userId ];
	}

	function addDmMessage( userId, threadDisplayName, from, text ) {
		var thread = ensureDmThread( userId, threadDisplayName );
		thread.messages.push( { from: from, text: text } );
		if ( view.type === "dm" && view.userId === userId ) {
			messagesEl.appendChild( buildMessageRow( from, text ) );
			scrollToBottom();
		} else {
			thread.unread++;
		}
		renderDmList();
	}

	function renderDmList() {
		var ids = Object.keys( dmThreads );
		dmEmptyEl.classList.toggle( "is-hidden", ids.length > 0 );
		dmListEl.innerHTML = "";
		ids.forEach( function ( userId ) {
			var thread = dmThreads[ userId ];
			var btn = document.createElement( "button" );
			btn.type = "button";
			btn.className = "sc-dm-item" + ( view.type === "dm" && view.userId === userId ? " is-active" : "" );

			var label = document.createElement( "span" );
			label.className = "sc-dm-item-name";
			label.textContent = thread.displayName;
			btn.appendChild( label );

			if ( thread.unread ) {
				var badge = document.createElement( "span" );
				badge.className = "sc-dm-unread";
				badge.textContent = thread.unread;
				btn.appendChild( badge );
			}

			btn.addEventListener( "click", function () { openDm( userId, thread.displayName ); } );
			dmListEl.appendChild( btn );
		} );
	}

	// Rebuilds the whole sidebar channel list from allChannels/
	// joinedChannels/unreadByChannel/view every time something about it
	// changes (join, leave, switch, a badge count) — same "just rebuild
	// it" approach renderDmList() already uses, simpler than patching
	// individual rows for a list this small.
	function renderChannelList() {
		channelListEl.innerHTML = "";
		allChannels.forEach( function ( channel ) {
			var isJoined = joinedChannels.indexOf( channel ) !== -1;
			var isActive = view.type === "channel" && view.channel === channel;

			var row = document.createElement( "div" );
			row.className = "sc-channel-row" + ( isJoined ? "" : " is-unjoined" ) + ( isActive ? " is-active" : "" );

			var link = document.createElement( "button" );
			link.type = "button";
			link.className = "sc-channel-link";
			link.innerHTML = '<span class="sc-channel-hash">##</span><span class="sc-channel-link-name">' + escapeHtml( channel ) + '</span>';
			link.addEventListener( "click", function () { openChannelRow( channel ); } );
			row.appendChild( link );

			var unread = unreadByChannel[ channel ] || 0;
			if ( isJoined && unread > 0 ) {
				var badge = document.createElement( "span" );
				badge.className = "sc-channel-badge";
				badge.textContent = unread;
				row.appendChild( badge );
			}

			if ( isJoined && channel !== "general" ) {
				var leaveBtn = document.createElement( "button" );
				leaveBtn.type = "button";
				leaveBtn.className = "sc-channel-leave";
				leaveBtn.setAttribute( "aria-label", "Leave ##" + channel );
				leaveBtn.textContent = "×";
				leaveBtn.addEventListener( "click", function () { leaveChannel( channel ); } );
				row.appendChild( leaveBtn );
			}

			channelListEl.appendChild( row );
		} );
	}

	function renderTyping() {
		var names = Object.keys( typingNames );
		if ( !names.length ) {
			typingIndicatorEl.hidden = true;
			typingIndicatorEl.textContent = "";
			return;
		}
		var text;
		if ( names.length === 1 ) {
			text = names[ 0 ] + " is typing…";
		} else if ( names.length === 2 ) {
			text = names[ 0 ] + " and " + names[ 1 ] + " are typing…";
		} else {
			text = names[ 0 ] + ", " + names[ 1 ] + " and " + ( names.length - 2 ) + " other" + ( names.length - 2 === 1 ? "" : "s" ) + " are typing…";
		}
		typingIndicatorEl.textContent = text;
		typingIndicatorEl.hidden = false;
	}

	function noteTyping( name ) {
		if ( name === displayName ) return; // never show our own typing back to us
		if ( typingNames[ name ] ) clearTimeout( typingNames[ name ] );
		typingNames[ name ] = setTimeout( function () {
			delete typingNames[ name ];
			renderTyping();
		}, TYPING_TIMEOUT_MS );
		renderTyping();
	}

	function clearAllTyping() {
		Object.keys( typingNames ).forEach( function ( name ) { clearTimeout( typingNames[ name ] ); } );
		typingNames = {};
		renderTyping();
	}

	function currentTypingDestination() {
		return view.type === "dm" ? ( DM_PREFIX + view.userId ) : ( CHANNEL_DEST_PREFIX + view.channel );
	}

	function renderPresenceForActive() {
		renderPresence( presenceByChannel[ activeChannel ] || [] );
	}

	function renderPresence( members ) {
		presenceCountEl.textContent = members.length ? "(" + members.length + ")" : "";
		presenceListEl.innerHTML = "";
		members.forEach( function ( member ) {
			var isSelf = member.userId === MY_USER_ID;
			var li = document.createElement( "li" );
			li.className = "sc-presence-item" + ( isSelf ? "" : " is-clickable" );

			var avatar = document.createElement( "span" );
			avatar.className = "sc-presence-avatar";
			avatar.style.background = avatarColor( member.displayName );
			avatar.textContent = initials( member.displayName );

			var label = document.createElement( "span" );
			label.className = "sc-presence-name";
			label.textContent = member.displayName + ( isSelf ? " (you)" : "" );

			li.appendChild( avatar );
			li.appendChild( label );
			if ( !isSelf ) {
				li.addEventListener( "click", function () { openDm( member.userId, member.displayName ); } );
			}
			presenceListEl.appendChild( li );
		} );
	}

	function openDm( userId, threadDisplayName ) {
		ensureDmThread( userId, threadDisplayName );
		dmThreads[ userId ].unread = 0;
		clearAllTyping();
		view = { type: "dm", userId: userId, displayName: threadDisplayName };
		viewTitleEl.textContent = "Direct message with " + threadDisplayName;
		backBtn.hidden = false;
		composerInput.placeholder = "Message " + threadDisplayName;
		renderChannelList(); // no channel row should read as "active" while a DM is open
		renderDmList();
		renderActiveMessages();
	}

	// Pure client-side view swap between two channels already joined —
	// no STOMP traffic at all, this connection is already subscribed to
	// every joinedChannels entry (see connect()'s CONNECTED handler).
	function switchToChannel( channel ) {
		clearAllTyping();
		activeChannel = channel;
		view = { type: "channel", channel: channel };
		viewTitleEl.innerHTML = '<span class="sc-channel-hash">##</span>' + escapeHtml( channel );
		backBtn.hidden = true;
		composerInput.placeholder = "Message ##" + channel;
		unreadByChannel[ channel ] = 0;
		history.pushState( null, "", "/games/stomp-chat?channel=" + encodeURIComponent( channel ) );
		renderChannelList();
		renderDmList();
		renderActiveMessages();
		renderPresenceForActive();
	}

	backBtn.addEventListener( "click", function () { switchToChannel( activeChannel ); } );

	function subscribeChannel( channel ) {
		sendFrame( "SUBSCRIBE", { destination: CHANNEL_DEST_PREFIX + channel, id: CHANNEL_SUB_PREFIX + channel } );
	}

	// Joins a channel this user wasn't already in: adds it to
	// joinedChannels client-side immediately (so the sidebar and the
	// upcoming switchToChannel() treat it as joined right away) and sends
	// a real SUBSCRIBE — routes/StompChat.bx's authorize() persists the
	// membership row and broadcasts the "joined" system message from
	// there, not from anything sent on this frame.
	function joinChannel( channel ) {
		if ( joinedChannels.indexOf( channel ) !== -1 ) return;
		joinedChannels.push( channel );
		channelsMessages[ channel ] = [];
		presenceByChannel[ channel ] = [];
		unreadByChannel[ channel ] = 0;
		if ( socket && socket.readyState === WebSocket.OPEN ) subscribeChannel( channel );
	}

	// Explicit leave (the sidebar row's hover "×") — never offered for
	// ##general in the UI, but guarded here too since this is the function
	// that would actually send the UNSUBSCRIBE. Falls back the view to
	// ##general first if the channel being left is the one on screen, since
	// you can't be looking at a channel you're not in.
	function leaveChannel( channel ) {
		if ( channel === "general" ) return;
		var idx = joinedChannels.indexOf( channel );
		if ( idx === -1 ) return;
		joinedChannels.splice( idx, 1 );
		delete channelsMessages[ channel ];
		delete presenceByChannel[ channel ];
		delete unreadByChannel[ channel ];
		if ( socket && socket.readyState === WebSocket.OPEN ) {
			sendFrame( "UNSUBSCRIBE", { id: CHANNEL_SUB_PREFIX + channel } );
		}
		if ( view.type === "channel" && view.channel === channel ) {
			switchToChannel( "general" );
		} else {
			renderChannelList();
		}
	}

	// Click handler for any sidebar channel row, joined or not — joining
	// (if needed) and opening are the same gesture from the user's side,
	// matching "clicking an unsubscribed channel moves it to the active
	// list."
	function openChannelRow( channel ) {
		if ( joinedChannels.indexOf( channel ) === -1 ) joinChannel( channel );
		switchToChannel( channel );
	}

	// STOMP 1.2 frame wire format: "COMMAND\nheader:value\n\n<body>\0"
	function sendFrame( command, headers, body ) {
		var out = command + "\n";
		for ( var key in headers ) out += key + ":" + headers[ key ] + "\n";
		out += "\n" + ( body || "" ) + "\0";
		socket.send( out );
	}

	function parseFrame( raw ) {
		raw = raw.replace( /\0$/, "" );
		var sep = raw.indexOf( "\n\n" );
		var headerBlock = sep >= 0 ? raw.slice( 0, sep ) : raw;
		var body = sep >= 0 ? raw.slice( sep + 2 ) : "";
		var lines = headerBlock.split( "\n" );
		var command = lines[ 0 ];
		var headers = {};
		for ( var i = 1; i < lines.length; i++ ) {
			var idx = lines[ i ].indexOf( ":" );
			if ( idx >= 0 ) headers[ lines[ i ].slice( 0, idx ) ] = lines[ i ].slice( idx + 1 );
		}
		return { command: command, headers: headers, body: body };
	}

	function connect() {
		var proto = location.protocol === "https:" ? "wss:" : "ws:";
		socket = new WebSocket( proto + "//" + location.host + "/games/stomp-chat/socket" );

		socket.addEventListener( "open", function () {
			sendFrame( "CONNECT", { "accept-version": "1.2", host: location.host } );
		} );

		socket.addEventListener( "message", function ( ev ) {
			var frame = parseFrame( ev.data );
			if ( frame.command === "CONNECTED" ) {
				setStatus( "live", "live" );
				if ( connectingLine ) {
					connectingLine.remove();
					connectingLine = null;
				}
				// A (re)connect always ends with a fresh SUBSCRIBE per
				// joined channel below, which makes the server replay each
				// one's full history again (see routes/StompChat.bx's
				// sendHistory()) — clearing every channel's local backing
				// array first (and re-rendering whatever's on screen from
				// it) is what stops that replay from doubling up on top of
				// messages already appended from before the drop. A first
				// connect finds these already empty, so it's a no-op there.
				joinedChannels.forEach( function ( channel ) { channelsMessages[ channel ] = []; } );
				renderActiveMessages();
				joinedChannels.forEach( function ( channel ) { subscribeChannel( channel ); } );
				sendFrame( "SUBSCRIBE", { destination: MY_INBOX, id: "sub-dm" } );
			} else if ( frame.command === "MESSAGE" ) {
				try {
					var data = JSON.parse( frame.body );
					var destination = frame.headers.destination || "";
					if ( destination === MY_INBOX ) {
						if ( data.type === "typing" ) {
							// Check the *sender's* id against whichever DM
							// thread is open — destination is always
							// MY_INBOX for any DM typing ping addressed to
							// me, regardless of who sent it, so it can't
							// tell two different people typing to me apart
							// on its own.
							if ( view.type === "dm" && data.fromId === view.userId ) noteTyping( data.from );
						} else if ( data.type === "dm" ) {
							addDmMessage( data.fromId, data.from, data.from, data.text );
						}
					} else if ( destination.indexOf( CHANNEL_DEST_PREFIX ) === 0 ) {
						var channel = destination.slice( CHANNEL_DEST_PREFIX.length );
						if ( data.type === "presence" ) {
							presenceByChannel[ channel ] = data.members;
							if ( channel === activeChannel ) renderPresenceForActive();
						} else if ( data.type === "history" ) {
							addChannelHistory( channel, data.messages );
						} else if ( data.type === "system" ) {
							addChannelSystem( channel, data.text );
						} else if ( data.type === "typing" ) {
							if ( view.type === "channel" && view.channel === channel ) noteTyping( data.from );
						} else {
							addChannelMessage( channel, data.from, data.text );
						}
					}
				} catch ( e ) { /* ignore malformed body */ }
			} else if ( frame.command === "ERROR" ) {
				addError( frame.headers.message || "Connection error." );
				setStatus( "error", "error" );
			}
		} );

		socket.addEventListener( "close", function () {
			setStatus( "reconnecting…", "error" );
			setTimeout( connect, RECONNECT_DELAY_MS );
		} );

		socket.addEventListener( "error", function () { socket.close(); } );
	}

	// "from"/"fromId" aren't sent here at all — routes/StompChat.bx stamps
	// both server-side from the session on every SEND, discarding whatever
	// a client claims (see its "Identity stamping" docblock), so there's
	// nothing this client can usefully assert about its own identity on
	// the wire.
	composer.addEventListener( "submit", function ( ev ) {
		ev.preventDefault();
		var text = composerInput.value.trim();
		if ( !text || !socket || socket.readyState !== WebSocket.OPEN ) return;
		clearAllTyping();

		if ( view.type === "dm" ) {
			var targetId = view.userId;
			sendFrame( "SEND", { destination: DM_PREFIX + targetId, "content-type": "application/json" },
				JSON.stringify( { type: "dm", text: text } ) );
			addDmMessage( targetId, view.displayName, displayName, text ); // optimistic echo — see class docblock
		} else {
			sendFrame( "SEND", { destination: CHANNEL_DEST_PREFIX + view.channel, "content-type": "application/json" }, JSON.stringify( { type: "message", text: text } ) );
		}
		composerInput.value = "";
	} );

	composerInput.addEventListener( "input", function () {
		if ( !socket || socket.readyState !== WebSocket.OPEN ) return;
		var now = Date.now();
		if ( now - lastTypingSentAt < TYPING_SEND_THROTTLE_MS ) return;
		lastTypingSentAt = now;
		sendFrame( "SEND", { destination: currentTypingDestination(), "content-type": "application/json" }, JSON.stringify( { type: "typing" } ) );
	} );

	var newChannelForm = document.getElementById( "newChannelForm" );
	if ( newChannelForm ) {
		var newChannelInput = document.getElementById( "newChannelInput" );
		var newChannelError = document.getElementById( "newChannelError" );
		var csrfToken = #JSONSerialize( data.csrfToken )#;

		newChannelForm.addEventListener( "submit", function ( ev ) {
			ev.preventDefault();
			var name = newChannelInput.value.trim();
			if ( !name ) return;
			newChannelError.hidden = true;

			fetch( "/games/stomp-chat/channels", {
				method: "POST",
				headers: { "Content-Type": "application/json", "X-CSRF-Token": csrfToken },
				body: JSON.stringify( { name: name } )
			} )
				.then( function ( res ) { return res.json().then( function ( body ) { return { ok: res.ok, body: body }; } ); } )
				.then( function ( result ) {
					if ( result.ok && result.body.success ) {
						allChannels = result.body.channels;
						newChannelInput.value = "";
						openChannelRow( result.body.channel ); // creator joins and opens it immediately
					} else {
						newChannelError.textContent = result.body.error || "Couldn't create that channel.";
						newChannelError.hidden = false;
					}
				} )
				.catch( function () {
					newChannelError.textContent = "Connection issue — try again.";
					newChannelError.hidden = false;
				} );
		} );
	}

	renderChannelList();
	renderDmList();
	connectingLine = addSystem( "Connecting as " + displayName + "…" );
	connect();
})();
</script>

</bx:output>
<bx:include template="../partials/_foot.bxm">

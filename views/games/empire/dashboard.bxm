<bx:include template="../../partials/_head.bxm">
<bx:include template="_chromeStart.bxm">

<bx:output>
<div class="sd-panel">
	<p class="sd-panel-title">#encodeForHTML( data.empire.name )#</p>
	<p class="sd-hint" style="margin-bottom: 14px;">Turns remaining today: <strong style="color: var(--sd-green);">#data.empire.turns_remaining# / 20</strong> &middot; Net worth: <strong style="color: var(--sd-green);">#numberFormat( data.netWorth )#</strong> credits-equivalent</p>

	<div class="sd-stat-grid">
		<div class="sd-stat">
			<div class="sd-stat-label">Credits</div>
			<div class="sd-stat-value">#numberFormat( data.empire.credits )#</div>
		</div>
		<div class="sd-stat">
			<div class="sd-stat-label">Food</div>
			<div class="sd-stat-value">#numberFormat( data.empire.food )#</div>
		</div>
		<div class="sd-stat">
			<div class="sd-stat-label">Fuel</div>
			<div class="sd-stat-value">#numberFormat( data.empire.fuel )#</div>
		</div>
		<div class="sd-stat">
			<div class="sd-stat-label">Population</div>
			<div class="sd-stat-value">#numberFormat( data.empire.population )#</div>
		</div>
		<div class="sd-stat">
			<div class="sd-stat-label">Planets</div>
			<div class="sd-stat-value">#data.empire.planets.total#</div>
		</div>
		<div class="sd-stat">
			<div class="sd-stat-label">Soldiers</div>
			<div class="sd-stat-value">#numberFormat( data.empire.soldiers )#</div>
		</div>
		<div class="sd-stat">
			<div class="sd-stat-label">Fighters</div>
			<div class="sd-stat-value">#numberFormat( data.empire.fighters )#</div>
		</div>
		<div class="sd-stat">
			<div class="sd-stat-label">Cruisers</div>
			<div class="sd-stat-value">#numberFormat( data.empire.cruisers )#</div>
		</div>
		<div class="sd-stat">
			<div class="sd-stat-label">Equipment</div>
			<div class="sd-stat-value">#numberFormat( data.empire.equipment )#</div>
		</div>
	</div>

	<bx:if isDate( data.empire.shielded_until ?: "" ) && data.empire.shielded_until > now()>
	<p class="sd-shield">&gt;&gt; SHIELDED FROM ATTACK UNTIL #dateTimeFormat( data.empire.shielded_until, "h:mm tt" )#</p>
	</bx:if>
</div>

<div class="sd-panel">
	<p class="sd-panel-title">Your Planets</p>
	<div class="sd-stat-grid">
		<div class="sd-stat">
			<div class="sd-stat-label">Agricultural</div>
			<div class="sd-stat-value">#data.empire.planets.agricultural#</div>
			<div class="sd-stat-hint">+60 cr, +40 food each</div>
		</div>
		<div class="sd-stat">
			<div class="sd-stat-label">Mining</div>
			<div class="sd-stat-value">#data.empire.planets.mining#</div>
			<div class="sd-stat-hint">+60 cr, +40 fuel each</div>
		</div>
		<div class="sd-stat">
			<div class="sd-stat-label">Industrial</div>
			<div class="sd-stat-value">#data.empire.planets.industrial#</div>
			<div class="sd-stat-hint">+140 cr, +20 equipment each</div>
		</div>
	</div>
	<p class="sd-hint">Yields are collected via the Collect Income action, not automatically each turn.</p>
</div>

<div class="sd-panel">
	<p class="sd-panel-title">Quick Actions</p>
	<div style="display: flex; gap: 12px; flex-wrap: wrap;">
		<form method="post" action="/games/empire/income">
			<input type="hidden" name="_csrf" value="#encodeForHTMLAttribute( data.csrfToken )#">
			<button type="submit" class="sd-btn" #( data.empire.turns_remaining <= 0 ? "disabled" : "" )#>COLLECT INCOME</button>
		</form>
		<form method="post" action="/games/empire/explore">
			<input type="hidden" name="_csrf" value="#encodeForHTMLAttribute( data.csrfToken )#">
			<button type="submit" class="sd-btn" #( data.empire.turns_remaining <= 0 ? "disabled" : "" )#>EXPLORE (300 FUEL)</button>
		</form>
	</div>
	<bx:if data.empire.turns_remaining <= 0>
	<p class="sd-hint" style="margin-top: 12px;">You're out of turns for today — more arrive at your next visit tomorrow.</p>
	</bx:if>
</div>
</bx:output>

<bx:include template="_chromeEnd.bxm">
<bx:include template="../../partials/_foot.bxm">

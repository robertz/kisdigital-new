<!--- Shared styling + sub-nav for every Stellar Dominion page — included
      (not a layout wrapper) right after <bx:output> opens in each view, so
      every page stays a normal, ordinary server-rendered page inside the
      site's usual header/footer (unlike views/main/chat.bxm, which
      deliberately escapes the site layout — this game doesn't need to).
      data.activeNav picks which tab is highlighted; one CSS block here
      rather than seven copies, since every Stellar Dominion page shares the
      same visual language. --->
<bx:output>
<style>
	.se-nav {
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
		margin: 24px 0 28px;
	}
	.se-nav a {
		padding: 8px 14px;
		border-radius: 999px;
		border: 1px solid var(--ui-border-subtle);
		background: var(--ui-surface-2);
		color: var(--text-secondary);
		text-decoration: none;
		font-size: 0.85rem;
		font-weight: 600;
	}
	.se-nav a:hover { color: var(--sc-accent-a, var(--post-anchor)); }
	.se-nav a.is-active {
		background: linear-gradient(135deg, ##7c3aed, ##06b6d4);
		color: ##fff;
		border-color: transparent;
	}
	.se-panel {
		background: var(--ui-surface-1);
		border: 1px solid var(--ui-border-subtle);
		border-radius: 16px;
		padding: 24px;
		margin-bottom: 24px;
	}
	.se-panel h2 {
		margin: 0 0 16px;
		font-size: 1.1rem;
		font-weight: 800;
	}
	.se-stat-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 14px;
	}
	.se-stat {
		background: var(--ui-surface-2);
		border-radius: 12px;
		padding: 14px 16px;
	}
	.se-stat-label {
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text-muted);
		font-weight: 700;
	}
	.se-stat-value { font-size: 1.35rem; font-weight: 800; margin-top: 4px; }
	.se-table { width: 100%; border-collapse: collapse; }
	.se-table th, .se-table td {
		padding: 10px 12px;
		text-align: left;
		border-bottom: 1px solid var(--ui-border-subtle);
		font-size: 0.88rem;
	}
	.se-table th {
		font-size: 0.7rem;
		text-transform: uppercase;
		color: var(--text-muted);
		letter-spacing: 0.05em;
	}
	.se-table tr:last-child td { border-bottom: none; }
	.se-input {
		background: var(--ui-surface-2);
		border: 1px solid var(--main-border-color);
		border-radius: 10px;
		padding: 8px 12px;
		color: inherit;
		width: 100%;
		font-size: 0.9rem;
	}
	.se-input:focus { outline: none; border-color: ##7c3aed; }
	.se-form-row {
		display: flex;
		gap: 12px;
		align-items: flex-end;
		flex-wrap: wrap;
		margin-bottom: 16px;
	}
	.se-form-row > div { flex: 1 1 140px; min-width: 120px; }
	.se-form-row label {
		display: block;
		font-size: 0.76rem;
		font-weight: 700;
		margin-bottom: 4px;
		color: var(--text-secondary);
	}
	.se-alert {
		padding: 10px 16px;
		border-radius: 10px;
		margin-bottom: 20px;
		font-size: 0.9rem;
	}
	.se-alert-error { background: rgba(214, 69, 69, 0.1); color: ##d64545; }
	.se-alert-success { background: rgba(47, 158, 91, 0.12); color: ##2f9e5b; }
	.se-empty { color: var(--text-muted); font-size: 0.9rem; }
	.se-cost { color: var(--text-muted); font-size: 0.82rem; margin-top: 4px; }
</style>

<nav class="se-nav">
	<a href="/games/empire" class="#( ( data.activeNav ?: "" ) == "dashboard" ? "is-active" : "" )#">Dashboard</a>
	<a href="/games/empire/market" class="#( ( data.activeNav ?: "" ) == "market" ? "is-active" : "" )#">Market</a>
	<a href="/games/empire/military" class="#( ( data.activeNav ?: "" ) == "military" ? "is-active" : "" )#">Shipyard</a>
	<a href="/games/empire/attack" class="#( ( data.activeNav ?: "" ) == "attack" ? "is-active" : "" )#">Attack</a>
	<a href="/games/empire/leaderboard" class="#( ( data.activeNav ?: "" ) == "leaderboard" ? "is-active" : "" )#">Leaderboard</a>
	<a href="/games/empire/battles" class="#( ( data.activeNav ?: "" ) == "battles" ? "is-active" : "" )#">Battles</a>
</nav>

<bx:if len( data.message ?: "" )>
<div class="se-alert se-alert-success">#encodeForHTML( data.message )#</div>
</bx:if>
<bx:if len( data.error ?: "" )>
<div class="se-alert se-alert-error">#encodeForHTML( data.error )#</div>
</bx:if>
</bx:output>

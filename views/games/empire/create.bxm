<bx:include template="../../partials/_head.bxm">
<bx:include template="_chromeStart.bxm">

<bx:output>
<div class="sd-panel">
	<p class="sd-panel-title">Found Your Empire</p>
	<p class="sd-hint" style="margin-bottom: 16px;">Choose a name — you'll start with 3 planets (one agricultural, one mining, one industrial), a small fleet, and 20 turns for today.</p>

	<form method="post" action="/games/empire/create">
		<input type="hidden" name="_csrf" value="#encodeForHTMLAttribute( data.csrfToken )#">
		<div class="sd-form-row">
			<div>
				<label for="empireName" class="sd-label">Empire name</label>
				<input type="text" id="empireName" name="name" class="sd-input" maxlength="50" placeholder="e.g. The Vega Compact" autocomplete="off" required>
			</div>
		</div>
		<button type="submit" class="sd-btn">FOUND EMPIRE</button>
	</form>
</div>
</bx:output>

<bx:include template="_chromeEnd.bxm">
<bx:include template="../../partials/_foot.bxm">

<bx:include template="../../partials/_head.bxm">
<bx:include template="_chromeStart.bxm">

<bx:output>
<div class="sd-panel">
	<p class="sd-panel-title">Galactic Market</p>
	<p class="sd-hint" style="margin-bottom: 14px;">Your Credits: <strong style="color: var(--sd-green);">#numberFormat( data.empire.credits )#</strong></p>

	<table class="sd-table">
		<thead>
			<tr>
				<th>Resource</th>
				<th>Price</th>
				<th>You Have</th>
				<th>Buy</th>
				<th>Sell</th>
			</tr>
		</thead>
		<tbody>
			<bx:loop array="#data.marketItems#" item="item">
			<tr>
				<td>#item.label#</td>
				<td>#data.prices[ item.key ]# cr/unit</td>
				<td>#numberFormat( data.empire[ item.key ] )#</td>
				<td>
					<form method="post" action="/games/empire/market/buy" class="sd-form-row" style="gap: 6px;">
						<input type="hidden" name="_csrf" value="#encodeForHTMLAttribute( data.csrfToken )#">
						<input type="hidden" name="resource" value="#item.key#">
						<input type="number" name="qty" class="sd-input" style="width: 90px;" min="1" max="500" value="50" required>
						<button type="submit" class="sd-btn">BUY</button>
					</form>
				</td>
				<td>
					<form method="post" action="/games/empire/market/sell" class="sd-form-row" style="gap: 6px;">
						<input type="hidden" name="_csrf" value="#encodeForHTMLAttribute( data.csrfToken )#">
						<input type="hidden" name="resource" value="#item.key#">
						<input type="number" name="qty" class="sd-input" style="width: 90px;" min="1" max="500" value="50" required>
						<button type="submit" class="sd-btn">SELL</button>
					</form>
				</td>
			</tr>
			</bx:loop>
		</tbody>
	</table>

	<p class="sd-hint" style="margin-top: 12px;">Prices move with today's buying and selling pressure. Up to 500 units per trade.</p>
</div>
</bx:output>

<bx:include template="_chromeEnd.bxm">
<bx:include template="../../partials/_foot.bxm">

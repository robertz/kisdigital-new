<bx:include template="../../partials/_head.bxm">
<bx:include template="_chromeStart.bxm">

<bx:output>
<div class="sd-panel">
	<p class="sd-panel-title">Battle History</p>
	<bx:if !data.battles.len()>
		<p class="sd-empty">No battles yet.</p>
	<bx:else>
		<div style="overflow-x: auto;">
		<table class="sd-table">
			<thead>
				<tr>
					<th>When</th>
					<th>Role</th>
					<th>Opponent</th>
					<th>Outcome</th>
					<th>Plunder</th>
				</tr>
			</thead>
			<tbody>
				<bx:loop array="#data.battles#" item="battle">
					<bx:set isAttacker = ( battle.attacker_empire_id == data.empire.id )>
					<bx:set won = ( battle.outcome == "attacker_win" )>
					<bx:set weWon = isAttacker ? won : !won>
				<tr>
					<td>#dateTimeFormat( battle.created, "mmm d, h:mm tt" )#</td>
					<td>#( isAttacker ? "Attacker" : "Defender" )#</td>
					<td>#encodeForHTML( isAttacker ? battle.defender_name : battle.attacker_name )#</td>
					<td>#( weWon ? "Won" : "Lost" )#</td>
					<td>
						<bx:if won>
							#numberFormat( battle.credits_plundered )# cr, #numberFormat( battle.food_plundered )# food, #numberFormat( battle.fuel_plundered )# fuel
							<bx:if battle.planet_captured> &middot; planet captured</bx:if>
						<bx:else>
							&mdash;
						</bx:if>
					</td>
				</tr>
				</bx:loop>
			</tbody>
		</table>
		</div>
	</bx:if>
</div>
</bx:output>

<bx:include template="_chromeEnd.bxm">
<bx:include template="../../partials/_foot.bxm">

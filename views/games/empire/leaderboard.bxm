<bx:include template="../../partials/_head.bxm">
<bx:include template="_chromeStart.bxm">

<bx:output>
<div class="sd-panel">
	<p class="sd-panel-title">Leaderboard</p>
	<bx:if !data.entries.len()>
		<p class="sd-empty">No empires yet — be the first to found one.</p>
	<bx:else>
		<div style="overflow-x: auto;">
		<table class="sd-table">
			<thead>
				<tr>
					<th>##</th>
					<th>Empire</th>
					<th>Owner</th>
					<th>Planets</th>
					<th>Net Worth</th>
				</tr>
			</thead>
			<tbody id="leaderboardBody">
				<bx:loop array="#data.entries#" item="entry" index="rank">
				<tr>
					<td>#rank#</td>
					<td>#encodeForHTML( entry.name )#</td>
					<td>#encodeForHTML( entry.owner_name )#</td>
					<td>#entry.planet_count#</td>
					<td>#numberFormat( entry.net_worth )#</td>
				</tr>
				</bx:loop>
			</tbody>
		</table>
		</div>
	</bx:if>
</div>
</bx:output>

<bx:include template="_chromeEnd.bxm">
<bx:include template="../../partials/_foot.bxm">

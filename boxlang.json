{
	"defaultDatasource": "chron",
	"datasources": {
		"chron": {
			"driver": "mysql",
			"host": "${env.CHRON_DB_HOST:localhost}",
			"port": "${env.CHRON_DB_PORT:3306}",
			"database": "${env.CHRON_DB_NAME:chron}",
			"username": "${env.CHRON_DB_USER:root}",
			"password": "${env.CHRON_DB_PASSWORD}",
			"custom": "zeroDateTimeBehavior=CONVERT_TO_NULL"
		}
	},
	"caches": {
		"default": {
			"provider": "BoxCacheProvider",
			"properties": {
				"maxObjects": 5000,
				"evictionPolicy": "LRU"
			}
		},
		"sessionCache": {
			"provider": "BoxCacheProvider",
			"properties": {
				"objectStore": "JDBCStore",
				"datasource": "chron",
				"table": "Sessions",
				"autoCreate": true,
				"maxObjects": 10000,
				"evictionPolicy": "LRU",
				"evictCount": 500,
				"defaultTimeout": 2592000,
				"defaultLastAccessTimeout": 2592000,
				"reapFrequency": 300
			}
		}
	}
}

APPNAME=KISDigital
SITEURL=https://kisdigital.com

CHRON_DB_HOST=localhost
CHRON_DB_PORT=3306
CHRON_DB_NAME=chron
CHRON_DB_USER=root
CHRON_DB_PASSWORD=

# Cover-image uploads (post editor "Upload" button) — Cloudflare R2 bucket
# with a public custom domain mapped to R2_PUBLIC_BASE_URL. Create an R2 API
# token (Account Home > R2 > Manage API Tokens) scoped to Object Read & Write
# on this bucket. Uploads are disabled (with a clear error, not a crash)
# until all four of these are set.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://static.kisdigital.com
# Folder (bucket key prefix) cover images are uploaded under — no leading or
# trailing slash. Defaults to "posts" if unset.
R2_UPLOAD_PREFIX=posts

# Visitor-insights dashboard (/manage/insights) reads from this app's own
# RequestLog table (db/migrations/0004_add_request_log.sql) — no separate
# configuration needed, just the CHRON_DB_* connection above.

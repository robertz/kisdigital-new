/**
 * KISDigital — boxlang-express port of the ColdBox/cbwire site.
 *
 * cbwire's live admin components have no boxlang-express equivalent, so
 * /manage's post/author/settings editors are plain POST-and-redirect forms
 * instead (see routes/Manage.bx). Everything else is a fairly direct port:
 * ColdBox's Router -> the route registrations below, handlers -> routes/*.bx,
 * WireBox DI -> the manual service instantiation right here.
 */

app = boxExpress()

// ── Static asset manifest (esbuild cache-busted filenames) ─────────────────
manifestPath = expandPath( "./public/assets/dist/manifest.json" )
assetManifest = fileExists( manifestPath ) ? jsonDeserialize( fileRead( manifestPath ) ) : {}
cssHref = assetManifest[ "site.css" ] ?: "/assets/css/site.css"
jsHref  = assetManifest[ "global.js" ] ?: "/assets/js/global.js"

// ── Services (manual DI — no WireBox container in boxlang-express) ─────────
postService     = new models.services.PostService()
authorService   = new models.services.AuthorService()
authService     = new models.services.AuthService()
settingsService = new models.services.SettingsService()
sitemapService  = new models.services.SitemapService( postService )
postRenderer    = new models.util.PostRenderer()
siteDefaults    = new models.util.SiteDefaults( getSystemSetting( "SITEURL", "https://kisdigital.com" ) )

// /projects/:slug/docs/:page — editable via /manage/project-docs instead of
// hand-edited .bxm template files + a deploy per change. See
// ProjectDocRenderer.bx for how plain markdown() output gets this site's
// bx-* doc styling (labeled code blocks, callouts, etc).
projectDocService  = new models.services.ProjectDocService()
projectDocRenderer = new models.util.ProjectDocRenderer( postRenderer )

// Cover-image uploads (post editor "Upload" button) go straight to R2 rather
// than the app's own disk — see models/util/R2Client.bx. Credentials are
// optional: r2Client.isConfigured() is false until all five env vars are
// set, and the upload route reports that clearly instead of failing oddly.
r2Client = new models.util.R2Client(
	getSystemSetting( "R2_ACCOUNT_ID", "" ),
	getSystemSetting( "R2_BUCKET", "" ),
	getSystemSetting( "R2_ACCESS_KEY_ID", "" ),
	getSystemSetting( "R2_SECRET_ACCESS_KEY", "" ),
	getSystemSetting( "R2_PUBLIC_BASE_URL", "https://static.kisdigital.com" )
)

// "Sign in with Google" — see models/util/GoogleOAuthClient.bx and
// routes/Auth.bx. Credentials optional, same as r2Client above:
// isConfigured() is false until both env vars are set, and /auth/google
// reports that clearly instead of redirecting into a broken flow. The
// callback URL is derived from SITEURL rather than its own env var so dev
// and prod can never drift apart from each other — but it has to match
// (exactly, including scheme/host) whatever's registered as an authorized
// redirect URI on the Google Cloud OAuth client, or Google rejects the
// exchange outright.
googleOAuthClient = new models.util.GoogleOAuthClient(
	getSystemSetting( "GOOGLE_CLIENT_ID", "" ),
	getSystemSetting( "GOOGLE_CLIENT_SECRET", "" ),
	getSystemSetting( "SITEURL", "https://kisdigital.com" ) & "/auth/google/callback"
)

// Apache-style access log (RequestLog table) — see models/util/RequestLogger.bx.
// requestLogger fills the table in asynchronously; insightsService reads it
// back out for /manage/insights and the dashboard's insights summary card.
// Both together replace GoatCounterClient, whose synchronous, rate-limited
// API calls could lock up request handling.
requestLogger   = new models.util.RequestLogger()
insightsService = new models.services.InsightsService(
	reReplace( getSystemSetting( "SITEURL", "https://kisdigital.com" ), "^https?://", "", "one" )
)

// /manage/server — live JVM/OS metrics (memory, CPU, disk, GC, threads) plus
// Undertow's own connector stats via `app`. See ServerMonitor.bx; no
// datasource involved, pure in-process JMX/Undertow reads.
serverMonitor = new models.util.ServerMonitor( app )

// ── Middleware ───────────────────────────────────────────────────────────
// requestLogger goes first, ahead of everything else, so its next() wraps
// the entire chain below — every request this server handles gets a row,
// static assets included, same scope as an actual Apache access log.
app.use( requestLogger.middleware() )

app.use(
	boxExpressJSON(),
	boxExpressUrlencoded(),
	// 30 days, matches the old app's session timeout. Keep boxlang.json's
	// sessionCache defaultTimeout/defaultLastAccessTimeout at this same
	// figure (JSON can't hold a comment pointing back here) — this maxAge
	// only overrides the cache entry's TTL per request, not its idle
	// timeout, so a shorter defaultLastAccessTimeout there silently evicts
	// idle sessions well before the cookie itself expires.
	boxExpressSession( { store: boxExpressCacheStore("sessionCache"), maxAge: 30 * 24 * 60 * 60 } ),
	boxExpressHelmet( { referrerPolicy: "strict-origin-when-cross-origin" } )
)

// esbuild content-hashes every filename under dist/ (see the manifest logic
// above), so a cached copy can never go stale — a new deploy ships new
// filenames, it never overwrites an old one. Safe to cache for a year.
// Mounted ahead of the general public/ static handler below (whose shorter
// maxAge covers everything unhashed: images, favicons, etc.) so dist/
// requests hit this handler first.
app.use( "/assets/dist", boxExpressStatic( expandPath( "./public/assets/dist" ), { maxAge: 31536000, immutable: true } ) )
app.use( boxExpressStatic( expandPath( "./public" ), { maxAge: 86400 } ) )

// Resolves the real visitor IP behind DO App Platform's ingress + Cloudflare
// (kisdigital.com is Cloudflare-proxied) for req.ip everywhere, including
// boxlang-express's own per-request access-log line. Not app.set("trust
// proxy", true) + X-Forwarded-For: confirmed by testing directly against
// production with a forged header that Cloudflare and DO's ingress both
// APPEND to that header rather than replacing it, so a client can prepend a
// fake entry and have it survive to the app — trust proxy would make req.ip
// attacker-controlled there, not just wrong. DO-Connecting-IP (falling back
// to Cloudflare's own CF-Connecting-IP) is set by the edge itself from the
// actual TCP connection it observed, not from anything the client sent, so
// those are trustworthy where X-Forwarded-For's leftmost entry is not — see
// Request.bx's _resolveIp() in boxlang-express (>=0.1.16) for the check
// itself. Neither header exists in local dev, so req.ip there stays the
// direct connection address, which is already correct.
app.set( "trust proxy header", [ "DO-Connecting-IP", "CF-Connecting-IP" ] )

// [M1] Legacy XSS filter hint — a no-op in modern browsers, harmless to send.
// (Everything else from the old app's security header set is covered by helmet above.)
app.use( ( req, res, next ) => {
	res.set( "X-XSS-Protection", "1; mode=block" )
	next()
} )

// Values every view needs regardless of which route rendered it.
app.locals.siteName = "KISDigital"
app.locals.cssHref  = cssHref
app.locals.jsHref   = jsHref

app.use( ( req, res, next ) => {
	res.locals.manageUser = req.session.manage_user ?: ""
	next()
} )

app.set( "views", expandPath( "./views" ) )
app.set( "env", getSystemSetting( "ENV", "production" ) )
app.set( "reloadOnChange", app.getSetting( "env" ) == "development" )

// DigitalOcean App Platform's readiness/liveness probe. Deliberately touches
// no datasource and renders no view — a MySQL blip shouldn't fail the whole
// service's health check when the process itself is fine. See .do/app.yaml.
// Registered before the host-lockdown middleware below so health checks
// (which hit the app directly, not through kisdigital.com) are handled here
// and never reach it.
app.get( "/health", ( req, res ) => res.send( "ok" ) )

// DO App Platform's own *.ondigitalocean.app URL stays live at the
// infrastructure level for as long as the app exists — there's no spec
// setting to turn it off. This is the practical lockdown instead: any
// request not addressed to the real domain gets redirected there, same
// path and query string intact. Skipped outside production so local dev
// (Host: localhost:3005) isn't caught by it.
if ( app.getSetting( "env" ) == "production" ){
	app.use( ( req, res, next ) => {
		var allowedHosts = [ "kisdigital.com", "www.kisdigital.com" ];
		if ( !allowedHosts.contains( lCase( req.hostname ) ) ){
			return res.redirect( "https://kisdigital.com" & req.originalUrl, 301 );
		}
		next();
	} );
}

// ── Routes ───────────────────────────────────────────────────────────────
app.use( new routes.Auth( authService, googleOAuthClient ).router )
app.use( new routes.Main( postService, authorService, siteDefaults ).router )
app.use( new routes.Posts( postService, postRenderer, siteDefaults ).router )
app.use( new routes.Tags( postService, siteDefaults ).router )
app.use( new routes.Feeds( sitemapService ).router )
app.use( new routes.Projects( siteDefaults, projectDocService, projectDocRenderer ).router )
app.use( new routes.Games( siteDefaults ).router )
app.use( new routes.Manage( authService, postService, authorService, settingsService, postRenderer, r2Client, getSystemSetting( "R2_UPLOAD_PREFIX", "posts" ), insightsService, serverMonitor, projectDocService, projectDocRenderer, googleOAuthClient ).router )

// ── 404 / 500 (themed, matching the site's own look) ────────────────────
app.use( ( req, res ) => {
	res.status( 404 ).render( "main/404", {
		pageTitle     : "Page Not Found",
		trendingPosts : postService.getTrendingPosts()
	} )
} )

app.use( ( err, req, res, next ) => {
	println( "[error] " & err.message )
	res.status( 500 ).render( "main/error", {
		pageTitle     : "Server Error",
		trendingPosts : postService.getTrendingPosts()
	} )
} )

app.listen( getSystemSetting( "PORT", 3005 ), ( port ) => {
	println( "KISDigital listening on http://localhost:#port#" )
} )

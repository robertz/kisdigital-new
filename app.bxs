/**
 * KISDigital — boxlang-express port of the ColdBox/cbwire site.
 *
 * cbwire's live admin components have no boxlang-express equivalent, so
 * /manage's post/author/settings editors are plain POST-and-redirect forms
 * instead (see routes/Manage.bx). Everything else is a fairly direct port:
 * ColdBox's Router -> the route registrations below, handlers -> routes/*.bx,
 * WireBox DI -> the manual service instantiation right here.
 */

app = boxExpress()

// ── Static asset manifest (esbuild cache-busted filenames) ─────────────────
manifestPath = expandPath( "./public/assets/dist/manifest.json" )
assetManifest = fileExists( manifestPath ) ? jsonDeserialize( fileRead( manifestPath ) ) : {}
cssHref = assetManifest[ "site.css" ] ?: "/assets/css/site.css"
jsHref  = assetManifest[ "global.js" ] ?: "/assets/js/global.js"

// ── Services (manual DI — no WireBox container in boxlang-express) ─────────
postService     = new models.services.PostService()
authorService   = new models.services.AuthorService()
authService     = new models.services.AuthService()
settingsService = new models.services.SettingsService()
sitemapService  = new models.services.SitemapService( postService )
postRenderer    = new models.util.PostRenderer()
siteDefaults    = new models.util.SiteDefaults( getSystemSetting( "SITEURL", "https://kisdigital.com" ) )

// Cover-image uploads (post editor "Upload" button) go straight to R2 rather
// than the app's own disk — see models/util/R2Client.bx. Credentials are
// optional: r2Client.isConfigured() is false until all five env vars are
// set, and the upload route reports that clearly instead of failing oddly.
r2Client = new models.util.R2Client(
	getSystemSetting( "R2_ACCOUNT_ID", "" ),
	getSystemSetting( "R2_BUCKET", "" ),
	getSystemSetting( "R2_ACCESS_KEY_ID", "" ),
	getSystemSetting( "R2_SECRET_ACCESS_KEY", "" ),
	getSystemSetting( "R2_PUBLIC_BASE_URL", "https://static.kisdigital.com" )
)

// ── Middleware ───────────────────────────────────────────────────────────
app.use(
	boxExpressJSON(),
	boxExpressUrlencoded(),
	boxExpressSession( { maxAge: 30 * 24 * 60 * 60 } ), // 30 days, matches the old app's session timeout
	boxExpressStatic( expandPath( "./public" ), { maxAge: 86400 } ),
	boxExpressHelmet( { referrerPolicy: "strict-origin-when-cross-origin" } )
)

// [M1] Legacy XSS filter hint — a no-op in modern browsers, harmless to send.
// (Everything else from the old app's security header set is covered by helmet above.)
app.use( ( req, res, next ) => {
	res.set( "X-XSS-Protection", "1; mode=block" )
	next()
} )

// Values every view needs regardless of which route rendered it.
app.locals.siteName = "KISDigital"
app.locals.cssHref  = cssHref
app.locals.jsHref   = jsHref

app.use( ( req, res, next ) => {
	res.locals.manageUser = req.session.manage_user ?: ""
	next()
} )

app.set( "views", expandPath( "./views" ) )
app.set( "env", getSystemSetting( "ENV", "production" ) )
app.set( "reloadOnChange", app.getSetting( "env" ) == "development" )

// DigitalOcean App Platform's readiness/liveness probe. Deliberately touches
// no datasource and renders no view — a MySQL blip shouldn't fail the whole
// service's health check when the process itself is fine. See .do/app.yaml.
app.get( "/health", ( req, res ) => res.send( "ok" ) )

// ── Routes ───────────────────────────────────────────────────────────────
app.use( new routes.Main( postService, authorService, siteDefaults ).router )
app.use( new routes.Posts( postService, postRenderer, siteDefaults ).router )
app.use( new routes.Tags( postService, siteDefaults ).router )
app.use( new routes.Feeds( sitemapService ).router )
app.use( new routes.Manage( authService, postService, authorService, settingsService, postRenderer, r2Client, getSystemSetting( "R2_UPLOAD_PREFIX", "posts" ) ).router )

// ── 404 / 500 (themed, matching the site's own look) ────────────────────
app.use( ( req, res ) => {
	res.status( 404 ).render( "main/404", {
		pageTitle     : "Page Not Found",
		trendingPosts : postService.getTrendingPosts()
	} )
} )

app.use( ( err, req, res, next ) => {
	println( "[error] " & err.message )
	res.status( 500 ).render( "main/error", {
		pageTitle     : "Server Error",
		trendingPosts : postService.getTrendingPosts()
	} )
} )

app.listen( getSystemSetting( "PORT", 3005 ), ( port ) => {
	println( "KISDigital listening on http://localhost:#port#" )
} )

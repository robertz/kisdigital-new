# Copy to production.env in the deployment folder, beside deploy.sh. ENV, PORT,
# TRUST_PROXY_HEADER and JAVA_OPTS are set by the compose file itself;
# everything else in the repo's .env.example can go here too.

APPNAME=KISDigital
SITEURL=https://kisdigital.com

# The host's MySQL container, by its container name on MYSQL_NETWORK, and the
# schema loaded from amos (production/README.md, "Database").
CHRON_DB_HOST=do-mirror-mysql
CHRON_DB_PORT=3306
CHRON_DB_NAME=chron_production
CHRON_DB_USER=root
CHRON_DB_PASSWORD=

# Cover-image uploads go to the Cloudflare R2 bucket behind R2_PUBLIC_BASE_URL.
# The API token needs Object Read & Write on the bucket. Uploads are refused
# until all four credentials are set.
R2_ACCOUNT_ID=
R2_BUCKET=kisdigital
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://static.kisdigital.com

# "Sign in with Google": the OAuth client's authorized redirect URI is
# https://kisdigital.com/auth/google/callback. No button without both.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "Sign in with GitHub": redirect URI https://kisdigital.com/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ActivityPub: federates as @blog@kisdigital.com. SITEURL and the handle are
# the federated identity; changing either orphans every follower.
ACTIVITYPUB_ENABLED=true
ACTIVITYPUB_HANDLE=blog
ACTIVITYPUB_AUTHOR_ID=cf509c38-63c0-11ef-b36c-9a6c4d3d4dca
ACTIVITYPUB_SINCE=2026-09-27T00:00:00Z

# Webmention: sending is on for posts published at or after WEBMENTION_SEND_SINCE
WEBMENTION_ENABLED=true
WEBMENTION_SEND_SINCE=2026-10-24T00:00:00Z

# Comment emails through Amazon SES SMTP (Mailer.bx). SMTP credentials come
# from SES > SMTP settings; the host is email-smtp.<region>.amazonaws.com and
# MAIL_FROM must be on the verified domain. MAIL_ALERT_TO gets an email for
# every new comment. Nothing is sent until host, user, password and from are set.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
MAIL_ALERT_TO=
# Post emails (SubscriptionService.bx). MAIL_POSTAL_ADDRESS goes in each
# email's footer, which US anti-spam law requires. SES_SNS_TOPIC_ARN is the SNS
# topic SES sends bounce and complaint notifications to, subscribed over HTTPS
# to https://kisdigital.com/email/ses-feedback; blank turns that route off.
MAIL_POSTAL_ADDRESS=
SES_SNS_TOPIC_ARN=

# Read by deploy.sh and docker compose, not by the app. Copy to .env in the
# deployment folder, beside deploy.sh.

# The tunnel's token: Zero Trust > Networks > Tunnels > your tunnel > Install
# connector. Until it's set, deploy.sh starts the app without cloudflared.
TUNNEL_TOKEN=

# What deploy.sh pulls into src/ and builds: the repo over SSH, and a branch or tag
REPO_URL=git@github.com:robertz/kisdigital-new.git
REPO_REF=main

# The read-only deploy key that can read the private repo. Empty: git uses
# your own SSH setup (ssh-agent or ~/.ssh), as it would on the command line.
#   DEPLOY_KEY=/home/you/.ssh/kisdigital_deploy
DEPLOY_KEY=

# What the app container may use: memory (a 75% share is the heap) and CPUs.
# Below about 1.8g or 2 CPUs the JVM uses the Serial collector rather than G1.
# APP_MEMORY=1g
# APP_CPUS=1

# The Docker network the host's MySQL container is on
# MYSQL_NETWORK=docker-mysql_default
